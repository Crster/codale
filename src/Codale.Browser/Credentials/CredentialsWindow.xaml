<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Codale.Browser.CredentialsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codale.Browser">

    <Grid x:Name="Root" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="PasswordsToggle" Content="Passwords" IsChecked="True" Click="Section_Click" />
            <ToggleButton x:Name="PasskeysToggle" Content="Passkeys" Click="Section_Click" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search by site or user name" TextChanged="SearchBox_TextChanged" />
            <Button x:Name="AddButton" Grid.Column="1" Content="Add password" Click="Add_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="PasswordList" SelectionMode="Single" SelectionChanged="PasswordList_SelectionChanged" BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
                <ListView.Header>
                    <Grid Padding="12,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SITE" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="USER NAME" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock Grid.Column="2" Text="UPDATED" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CredentialEntry">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Site}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText}" Opacity="0.6" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="PasskeyList" SelectionMode="Single" SelectionChanged="PasskeyList_SelectionChanged" Visibility="Collapsed" BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
                <ListView.Header>
                    <Grid Padding="12,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SITE" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="LAST USED" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock Grid.Column="2" Text="WHAT HAPPENED" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PasskeySite">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Site}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LastUsedText}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Summary}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75" />
            <TextBox x:Name="RevealedBox" IsReadOnly="True" Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas" />
            <StackPanel x:Name="PasswordActions" Orientation="Horizontal" Spacing="8">
                <Button x:Name="FillButton" Content="Fill on this page" Click="Fill_Click" />
                <Button x:Name="RevealButton" Content="Show password" Click="Reveal_Click" />
                <Button x:Name="CopyButton" Content="Copy password" Click="Copy_Click" />
                <Button x:Name="EditButton" Content="Change password" Click="Edit_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
            </StackPanel>
            <StackPanel x:Name="PasskeyActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button Content="Windows sign-in options" Click="WindowsOptions_Click" />
                <Button Content="Forget this site" Click="Forget_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
