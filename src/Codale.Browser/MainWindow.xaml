<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Codale.Browser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codale.Browser">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTab_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTab_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Address_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextTab_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousTab_Invoked" />
            <KeyboardAccelerator Key="F5" Modifiers="Control" Invoked="HardReload_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="HardReload_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="Credentials_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="Bookmark_Invoked" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="Sidebar_Invoked" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="History_Invoked" />
            <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="Downloads_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="Print_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- The tab strip is the title bar: its empty part (DragRegion) drags the window; the caption buttons sit in the inset. -->
        <Grid x:Name="TitleRow" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionInset" Width="144" />
            </Grid.ColumnDefinitions>
            <TabView x:Name="Tabs"
                     IsAddTabButtonVisible="True"
                     CanReorderTabs="False"
                     CanDragTabs="False"
                     CloseButtonOverlayMode="OnPointerOver"
                     Background="Transparent"
                     TabCloseRequested="Tabs_TabCloseRequested"
                     AddTabButtonClick="Tabs_AddTabButtonClick"
                     SelectionChanged="Tabs_SelectionChanged">
                <TabView.TabStripFooter>
                    <Grid x:Name="DragRegion" Background="Transparent" MinWidth="48" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- Toolbar: navigation, address (with bookmark star), then the tools in groups. -->
        <Grid x:Name="Toolbar" Grid.Row="1" Padding="8,2" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation. -->
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE72B;" Click="Back_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back" IsEnabled="False" />
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE72A;" Click="Forward_Click" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward" IsEnabled="False" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" Click="Reload_Click" AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload (Ctrl+Shift+R reloads without the cache)" />
            </StackPanel>

            <!-- Flat address field with the bookmark star at its end. -->
            <Border Grid.Column="1" Margin="6,5" Height="34" CornerRadius="6" Padding="10,0,4,0" VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <Grid ColumnSpacing="8" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SecurityIcon" Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center" Opacity="0.6" ToolTipService.ToolTip="Connection" />
                    <TextBox x:Name="Address" Grid.Column="1" PlaceholderText="Search or enter an address"
                             Height="34" MinHeight="0" Padding="0,7,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="Address_KeyDown" GotFocus="Address_GotFocus" TextChanged="Address_TextChanged" AutomationProperties.Name="Address">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80808080" />
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="BookmarkButton" Grid.Column="2" Width="30" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            FontFamily="Segoe Fluent Icons" FontSize="13" Content="&#xE734;" Click="Bookmark_Click"
                            AutomationProperties.Name="Bookmark this page" ToolTipService.ToolTip="Bookmark this page (Ctrl+D)" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Page: act on the page in front of you. -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="FillButton" Style="{StaticResource ToolButton}" Content="&#xE77B;" Click="Fill_Click" AutomationProperties.Name="Fill a saved login" ToolTipService.ToolTip="Fill a saved login on this page" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE7C9;" Click="Pick_Click" AutomationProperties.Name="Pick an element" ToolTipService.ToolTip="Pick an element and copy its path" />
                    <Button x:Name="BreakpointButton" Style="{StaticResource ToolButton}" Content="&#xE7F4;" AutomationProperties.Name="Device preview" ToolTipService.ToolTip="View breakpoint: fill window" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE721;" Click="Find_Click" AutomationProperties.Name="Find in page" ToolTipService.ToolTip="Find in page (Ctrl+F)" />
                </StackPanel>

                <Rectangle Width="1" Height="18" Margin="6,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Browser: saved logins, notifications, the sidebar. -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE192;" Click="Credentials_Click" AutomationProperties.Name="Passwords and passkeys" ToolTipService.ToolTip="Passwords and passkeys (Ctrl+Shift+P)" />
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Notifications" ToolTipService.ToolTip="Notifications">
                        <Button.Content>
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                  Data="M12,2 C8.7,2 6.5,4.5 6.5,8 L6.5,13 L4.5,16 L19.5,16 L17.5,13 L17.5,8 C17.5,4.5 15.3,2 12,2 Z M9.5,18.5 A2.5,2.5 0 0 0 14.5,18.5 Z" />
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="360">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Notifications" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Clear" Click="ClearNotifications_Click" />
                                    </Grid>
                                    <TextBlock x:Name="NoNotifications" Text="Downloads, saved passwords and permission choices appear here." TextWrapping="Wrap" Opacity="0.6" />
                                    <ListView x:Name="NotificationList" MaxHeight="360" SelectionMode="None" Padding="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:NotificationItem">
                                                <Grid Padding="0,6" RowSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Opacity="0.55" FontSize="12" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Body}" Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SidebarButton" Style="{StaticResource ToolButton}" Content="&#xE700;" Click="Sidebar_Click" AutomationProperties.Name="Sidebar" ToolTipService.ToolTip="Sidebar: bookmarks, history, downloads (Ctrl+B)" />
                </StackPanel>

                <Rectangle Width="1" Height="18" Margin="6,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- View and developer tools, then the More menu. -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Content="&#xE708;" Click="Theme_Click" AutomationProperties.Name="Switch theme" ToolTipService.ToolTip="Switch to dark mode" />
                    <Button x:Name="ConsoleButton" Style="{StaticResource ToolButton}" Content="&#xE756;" Click="Console_Click" AutomationProperties.Name="Console" ToolTipService.ToolTip="Console" />
                    <Button x:Name="RequestsButton" Style="{StaticResource ToolButton}" Content="&#xE968;" Click="Requests_Click" AutomationProperties.Name="Requests" ToolTipService.ToolTip="Requests" />
                    <Button x:Name="MoreButton" Style="{StaticResource ToolButton}" Content="&#xE712;" AutomationProperties.Name="More" ToolTipService.ToolTip="More" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Find in page: its own row, so the page (a native window) never covers it. -->
        <Grid x:Name="FindRow" Grid.Row="2" Visibility="Collapsed" Padding="8,4" ColumnSpacing="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" PlaceholderText="Find in page" Height="32" TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
            <TextBlock x:Name="FindStatus" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" FontSize="12" Margin="4,0" />
            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Width="32" Height="32" Content="&#xE70E;" Click="FindPrevious_Click" AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match (Shift+Enter)" />
            <Button Grid.Column="3" Style="{StaticResource ToolButton}" Width="32" Height="32" Content="&#xE70D;" Click="FindNext_Click" AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match (Enter)" />
            <Button Grid.Column="4" Style="{StaticResource ToolButton}" Width="32" Height="32" Content="&#xE711;" Click="FindClose_Click" AutomationProperties.Name="Close find" ToolTipService.ToolTip="Close (Esc)" />
        </Grid>

        <!-- The sidebar beside the page stage. The page is a native window, so nothing overlaps it. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Sidebar: built in code (MainWindow.Sidebar.cs) so the page markup stays simple. -->
            <Grid x:Name="SideGrid" Grid.Column="0" Width="340" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" />
            <!-- The page stage: each tab's WebView2 is positioned here; breakpoints are centred on it. -->
            <Canvas x:Name="Stage" Grid.Column="1" SizeChanged="Stage_SizeChanged" />
        </Grid>

        <local:DiagnosticsPanel x:Name="Diagnostics" Grid.Row="4" Visibility="Collapsed" />
    </Grid>
</Window>
