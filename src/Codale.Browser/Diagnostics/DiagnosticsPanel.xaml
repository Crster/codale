<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Codale.Browser.DiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codale.Browser"
    Height="320">

    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, count, filter, clear, close. -->
        <Grid Padding="12,6,6,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Opacity="0.7" />
            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
            <TextBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="Filter by URL, status, type or message" MaxWidth="360" HorizontalAlignment="Right" MinWidth="200" Height="32" TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown" />
            <Button Grid.Column="3" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" FontFamily="Segoe Fluent Icons" Content="&#xE74D;" AutomationProperties.Name="Clear" ToolTipService.ToolTip="Clear" Click="Clear_Click" />
            <Button Grid.Column="4" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" FontFamily="Segoe Fluent Icons" Content="&#xE711;" AutomationProperties.Name="Close panel" ToolTipService.ToolTip="Close panel" Click="Close_Click" />
        </Grid>

        <!-- Category chips: the filters for the open list, with counts. -->
        <StackPanel x:Name="Chips" Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="12,0,12,8" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Requests. -->
            <Grid x:Name="NetworkPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="10,0" Height="28" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STATUS" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="METHOD" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="PATH" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="TYPE" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="4" Text="TIME" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="SIZE" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="NetworkList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NetworkList_SelectionChanged" Padding="0" ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,0" Height="26" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding StatusTint}" CornerRadius="4" Padding="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Method}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{Binding PathText}" Foreground="{Binding PathBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding TypeBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TypeText}" TextTrimming="CharacterEllipsis" MaxWidth="140" Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding TimeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NetworkEmpty" Grid.Row="1" Text="No requests yet. Load a page to see its traffic." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                <TextBlock x:Name="NetworkSummary" Grid.Row="2" Padding="12,4" FontSize="12" Opacity="0.65" />
            </Grid>

            <!-- Console. -->
            <Grid x:Name="ConsolePane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="10,0" Height="28" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TIME" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="MESSAGE" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.6" />
                </Grid>
                <ListView x:Name="ConsoleList" Grid.Row="1" SelectionMode="Single" SelectionChanged="ConsoleList_SelectionChanged" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="24" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,0" Height="24" Background="{Binding RowTint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding FirstLine}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ConsoleEmpty" Grid.Row="1" Text="No console messages." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                <TextBox x:Name="ConsoleDetail" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" Visibility="Collapsed"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="8,4" Padding="8,6" />
            </Grid>

            <!-- Details of the selected request: request, response and timing. -->
            <Grid x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="8,4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RequestTab" Content="Request" GroupName="DetailTabs" IsChecked="True" Checked="DetailTab_Checked" MinWidth="0" Padding="8,2" />
                    <RadioButton x:Name="ResponseTab" Grid.Column="1" Content="Response" GroupName="DetailTabs" Checked="DetailTab_Checked" MinWidth="0" Padding="8,2" />
                    <RadioButton x:Name="TimingTab" Grid.Column="2" Content="Timing" GroupName="DetailTabs" Checked="DetailTab_Checked" MinWidth="0" Padding="8,2" />
                    <Button Grid.Column="4" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" FontFamily="Segoe Fluent Icons" Content="&#xE711;" AutomationProperties.Name="Close details" ToolTipService.ToolTip="Close details" Click="CloseDetails_Click" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="8,0,8,4">
                    <Button Content="Copy URL" Padding="10,2" Click="CopyUrl_Click" />
                    <Button Content="Copy as cURL" Padding="10,2" Click="CopyCurl_Click" />
                </StackPanel>
                <TextBox x:Name="DetailText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12,4,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
