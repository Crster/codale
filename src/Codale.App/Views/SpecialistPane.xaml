<UserControl
    x:Class="Codale.App.Views.SpecialistPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Codale.App.Views"
    xmlns:vm="using:Codale.App.ViewModels">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <DataTemplate x:Key="PromptTemplate" x:DataType="vm:UserMessageItem">
            <StackPanel Margin="32,14,0,4" HorizontalAlignment="Right" MaxWidth="640" Spacing="3">
                <Border Padding="14,9" CornerRadius="12" Background="{StaticResource UserBubbleBrush}"
                        BorderBrush="{StaticResource UserBubbleStrokeBrush}" BorderThickness="1">
                    <views:PromptText Text="{Binding Text}" FontSize="13.5" />
                </Border>
                <Button HorizontalAlignment="Right" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="OnCopyMessageClick" Tag="{Binding}" ToolTipService.ToolTip="Copy message">
                    <FontIcon FontSize="10" Glyph="&#xE8C8;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReplyTemplate" x:DataType="vm:AssistantMessageItem">
            <StackPanel Margin="0,8,16,10" Spacing="4">
                <views:MarkdownView Markdown="{Binding Text}" BaseFontSize="13.5" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ModelLabel}" FontSize="10.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="OnCopyMessageClick" Tag="{Binding}" ToolTipService.ToolTip="Copy response">
                        <FontIcon FontSize="10" Glyph="&#xE8C8;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <views:ChatItemTemplateSelector x:Key="MessageTemplates" UserTemplate="{StaticResource PromptTemplate}" AssistantTemplate="{StaticResource ReplyTemplate}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Status strip: what the specialist is doing, with Retry when it was interrupted.  -->
        <Grid Padding="16,6,10,6" ColumnSpacing="8" BorderBrush="{ThemeResource ShellHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="12" Height="12" VerticalAlignment="Center">
                <ProgressRing Width="12" Height="12" MinWidth="0" MinHeight="0" IsActive="{Binding IsWorking, Mode=OneWay}"
                              Visibility="{Binding IsWorking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}"
                         Visibility="{Binding IsWorking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Status, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Content="Retry" Command="{Binding RetrySessionCommand}" Style="{StaticResource ShellTextButton}"
                    ToolTipService.ToolTip="Resume the interrupted request"
                    Visibility="{Binding CanRetry, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="2" Content="Stop" Command="{Binding CancelSessionCommand}" Style="{StaticResource ShellTextButton}"
                    ToolTipService.ToolTip="Stop the planner"
                    Visibility="{Binding ShowStatusStop, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ScrollViewer x:Name="ConversationScroller" Grid.Row="1" Padding="20,8,20,12" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ViewChanged="OnConversationViewChanged">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="8">
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource MessageTemplates}" />

                <!--  Planner questions: flat blocks divided by hairlines; options are click-to-pick rows.  -->
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpecialistQuestionItem">
                            <StackPanel Margin="0,4,0,8" Padding="0,12,0,0" Spacing="8"
                                        BorderBrush="{ThemeResource ShellHairlineBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding Step}" Style="{StaticResource ShellSectionLabel}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Options}"
                                              Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpecialistOptionItem">
                                            <Button Margin="0,0,0,2" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                    Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Label}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph, Mode=OneWay}" FontSize="14" Margin="0,1,0,0" VerticalAlignment="Top"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Custom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding CustomPlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="12,0,12,16" Spacing="8">
            <!--  Planner actions: Skip · Revise · Accept for a plan, Skip · Continue for questions.  -->
            <Grid Padding="4,10,0,0" ColumnSpacing="8" BorderBrush="{ThemeResource ShellHairlineBrush}" BorderThickness="0,1,0,0"
                  Visibility="{Binding ShowActionBar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActionHint, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button Grid.Column="1" Content="Skip" MinWidth="64" Command="{Binding SkipPlanningCommand}"
                        Style="{StaticResource ShellTextButton}" Height="32"
                        ToolTipService.ToolTip="Stop planning; nothing is sent to the main chat"
                        Visibility="{Binding CanSkip, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="2" Content="{Binding ReviseLabel, Mode=OneWay}" MinWidth="72" Command="{Binding BeginReviseCommand}"
                        ToolTipService.ToolTip="Ask the planner for changes"
                        Visibility="{Binding CanRevise, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="3" Content="{Binding PrimaryLabel, Mode=OneWay}" MinWidth="80" Command="{Binding ContinuePlanningCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Submit the answers, or implement the plan in the main chat"
                        Visibility="{Binding CanContinue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!--  Follow-up input: a plain text box with real text buttons, so it never reads as the main chat composer.
                  Always shown for answers; for the planner only while revising (with Back).  -->
            <Grid ColumnSpacing="8" Padding="4,10,0,0" BorderBrush="{ThemeResource ShellHairlineBrush}" BorderThickness="0,1,0,0"
                  Visibility="{Binding ShowComposer, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{Binding InputPlaceholder, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="140" VerticalAlignment="Bottom"
                         IsEnabled="{Binding CanSend, Mode=OneWay}" PreviewKeyDown="OnInputKeyDown" />
                <Button Grid.Column="1" Content="Back" MinWidth="64" VerticalAlignment="Bottom" Command="{Binding CancelReviseCommand}"
                        ToolTipService.ToolTip="Back to the plan actions (Esc)"
                        Visibility="{Binding IsRevising, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="2" Content="Send" MinWidth="72" VerticalAlignment="Bottom"
                        Command="{Binding SendInputCommand}" IsEnabled="{Binding CanSend, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Send (Enter)"
                        Visibility="{Binding IsWorking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Grid.Column="2" Content="Stop" MinWidth="72" VerticalAlignment="Bottom"
                        Command="{Binding CancelSessionCommand}" ToolTipService.ToolTip="Stop response"
                        Visibility="{Binding IsWorking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
