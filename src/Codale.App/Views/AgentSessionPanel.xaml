<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.AgentSessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    xmlns:agents="using:Codale.Core.Agents"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:NotBoolConverter x:Key="NotBool" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />

        <!--  The session card's model / effort / mode controls: labelled tiles  -->
        <Style x:Key="SessionControlButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7,8,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SessionControlCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SessionControlValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Collapsible sidebar section header  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style
            x:Key="PanelItemFlush"
            BasedOn="{StaticResource PanelItem}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PickerFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        </Style>

        <Style x:Key="EndpointFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PickerTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="8,4,8,4" />
        </Style>

        <Style x:Key="PickerHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <Style x:Key="PickerRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  A flat, full-width row inside the session card (model, mode)  -->
        <Style x:Key="PropertyRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Maximum" Value="100" />
        </Style>

        <Style x:Key="CountChip" TargetType="Border">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CountChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Margin="0,8,8,8"
        Background="{ThemeResource ShellSidePanelBackgroundBrush}"
        BorderBrush="{ThemeResource ShellSidePanelStrokeBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Translation="0,0,24">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid CornerRadius="12">
            <views:SessionPanelRail
                x:Name="Rail"
                ExpandRequested="OnRailExpandRequested"
                UpdateRequested="OnUpdateCliClick"
                Visibility="Collapsed" />

            <Grid x:Name="ExpandedView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header: collapse, profile, CLI version  -->
                <Grid Padding="8,8,8,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Collapse session panel"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPanelToggleClick"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Collapse session panel">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE89F;" />
                    </Button>

                    <Button
                        x:Name="ProfileButton"
                        Grid.Column="1"
                        Height="32"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Agent profile"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        IsEnabled="{x:Bind Workspace.CliEndpoint.CanSwitch, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Workspace.CliEndpoint.RouteText, Mode=OneWay}"
                        Visibility="{x:Bind ShowSessionPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                <Ellipse Fill="{StaticResource StatusSuccessBrush}" Visibility="{x:Bind Session.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind Workspace.CliEndpoint.ActiveName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <FontIcon
                                Grid.Column="2"
                                FontSize="9"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="ProfileFlyout" FlyoutPresenterStyle="{StaticResource PickerFlyout}" Placement="BottomEdgeAlignedLeft">
                                <StackPanel MinWidth="280" Spacing="2">
                                    <TextBlock Style="{StaticResource PickerTitleText}" Text="Agent profile" />
                                    <ListView
                                        MaxHeight="340"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnProfileItemClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Workspace.CliEndpoint.Choices, Mode=OneWay}"
                                        SelectedItem="{x:Bind Workspace.CliEndpoint.Selected, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderChoice">
                                                <StackPanel Padding="2,2" Spacing="1">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  A terminal CLI's session has no profile to pick: name the CLI instead  -->
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind EndpointLabel, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ShowSessionPickers, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />

                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind CliUpdate.VersionText, Mode=OneWay}"
                            Visibility="{x:Bind CliUpdate.IsVersionKnown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Width="26"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnUpdateCliClick"
                            CornerRadius="6"
                            ToolTipService.ToolTip="{x:Bind CliUpdate.UpdateTip, Mode=OneWay}"
                            Visibility="{x:Bind CliUpdate.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE896;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Body  -->
                <Grid Grid.Row="1" Margin="8,0,8,8">
                    <Grid.RowDefinitions>
                        <!--  Session card  -->
                        <RowDefinition Height="Auto" />
                        <!--  Live sections  -->
                        <RowDefinition x:Name="LiveRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <!--  Reading history  -->
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind Workspace.IsViewingHistory, Mode=OneWay}"
                            Message="{x:Bind Workspace.HistoryTitle, Mode=OneWay}"
                            Severity="Informational"
                            Title="Viewing history"
                            Visibility="{x:Bind Workspace.IsViewingHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <InfoBar.ActionButton>
                                <Button Click="OnReturnToLiveClick" Content="Back to live session" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!--  The live session: model, mode, context and usage  -->
                        <Border
                            Padding="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="0">
                                <StackPanel Visibility="{x:Bind ShowSessionPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Button
                                        Click="OnModelChipClick"
                                        IsEnabled="{x:Bind Session.CanChangeMode, Mode=OneWay}"
                                        Style="{StaticResource PropertyRowButton}"
                                        ToolTipService.ToolTip="{x:Bind Session.ModelDisplay, Mode=OneWay}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE99A;" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MetricLabel}" Text="Model" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Session.ModelDisplay, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <FontIcon
                                                Grid.Column="3"
                                                FontSize="9"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        Click="OnModeChipClick"
                                        IsEnabled="{x:Bind Session.CanChangeMode, Mode=OneWay}"
                                        Style="{StaticResource PropertyRowButton}"
                                        ToolTipService.ToolTip="How much the agent may do before asking (locked while the agent is working)">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind Session.ModeGlyph, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MetricLabel}" Text="Mode" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Session.ModeDisplayText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <FontIcon
                                                Grid.Column="3"
                                                FontSize="9"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Button>

                                    <Border Margin="4,4,4,0" Style="{StaticResource SectionDivider}" />
                                </StackPanel>

                                <!--  Meters  -->
                                <StackPanel Padding="8,8,8,6" Spacing="10">
                                    <!--  Context, with compact beside it  -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetricLabel}" Text="Context" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetricValue}"
                                                Text="{x:Bind Workspace.Status.ContextSummary, Mode=OneWay}" />
                                            <Button
                                                Grid.Column="2"
                                                Height="22"
                                                Margin="0,-3,-4,-3"
                                                Padding="6,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnCompactContextClick"
                                                CornerRadius="5"
                                                ToolTipService.ToolTip="Compact the context (/compact)">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE73F;" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Compact" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ProgressBar
                                            Foreground="{x:Bind Workspace.Status.ContextPercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                            Style="{StaticResource MetricBar}"
                                            Value="{x:Bind Workspace.Status.ContextPercent, Mode=OneWay}" />
                                    </StackPanel>

                                    <!--  5-hour window: total in caution, the history drawn over it (the visible tail is the latest prompt)  -->
                                    <StackPanel Spacing="5" Visibility="{x:Bind Workspace.Status.HasFiveHour, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetricLabel}" Text="Usage" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetricValue}"
                                                Text="{x:Bind Workspace.Status.FiveHourSummary, Mode=OneWay}" />
                                        </Grid>
                                        <Grid>
                                            <ProgressBar
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Style="{StaticResource MetricBar}"
                                                Value="{x:Bind Workspace.Status.FiveHourPercent, Mode=OneWay}" />
                                            <ProgressBar
                                                Background="Transparent"
                                                Foreground="{x:Bind Workspace.Status.FiveHourPercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                                Style="{StaticResource MetricBar}"
                                                Value="{x:Bind Workspace.Status.PreviousFiveHourPercent, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="5" Visibility="{x:Bind Workspace.Status.HasLongWindowOnly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetricLabel}" Text="Usage" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetricValue}"
                                                Text="{x:Bind Workspace.Status.SevenDaySummary, Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            Foreground="{x:Bind Workspace.Status.SevenDayPercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                            Style="{StaticResource MetricBar}"
                                            Value="{x:Bind Workspace.Status.SevenDayPercent, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="5" Visibility="{x:Bind Workspace.Status.ShowEmptyUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetricLabel}" Text="Usage" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetricValue}"
                                                Text="0%" />
                                        </Grid>
                                        <ProgressBar Style="{StaticResource MetricBar}" Value="0" />
                                    </StackPanel>

                                    <!--  A BYOK endpoint has no readable quota: session tokens against a fixed budget  -->
                                    <StackPanel Spacing="5" Visibility="{x:Bind Workspace.Status.HasTokenUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetricLabel}" Text="Tokens" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MetricValue}"
                                                Text="{x:Bind Workspace.Status.TokenUsageSummary, Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            Foreground="{x:Bind Workspace.Status.TokenUsagePercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                            Style="{StaticResource MetricBar}"
                                            Value="{x:Bind Workspace.Status.TokenUsagePercent, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Live sections: flat, separated by hairlines  -->
                    <ScrollViewer
                        x:Name="LiveHost"
                        Grid.Row="1"
                        Margin="-8,6,-8,0"
                        Padding="8,0">
                        <StackPanel Spacing="4">
                            <!--  Todos  -->
                            <StackPanel Spacing="2" Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="TodosSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Todos" />
                                        <Border
                                            Background="{StaticResource KindTodoTintBrush}"
                                            Style="{StaticResource CountChip}"
                                            Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Foreground="{StaticResource KindTodoBrush}" Style="{StaticResource CountChipText}">
                                                <Run Text="{x:Bind Session.TasksDone, Mode=OneWay}" /><Run Text="/" /><Run Text="{x:Bind Session.TasksTotal, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    Spacing="4"
                                    Visibility="{x:Bind TodosSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ProgressBar
                                        Margin="8,2,8,4"
                                        MinHeight="3"
                                        CornerRadius="1.5"
                                        Foreground="{StaticResource KindTodoBrush}"
                                        Maximum="{x:Bind Session.TasksTotal, Mode=OneWay}"
                                        Value="{x:Bind Session.TasksDone, Mode=OneWay}"
                                        Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />

                                    <ListView
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Todos, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="agents:TodoItem">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoBrush}}"
                                                        Glyph="{x:Bind Status, Converter={StaticResource TodoGlyph}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoTextBrush}}"
                                                        Text="{x:Bind Content}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>

                            <!--  Running tasks  -->
                            <StackPanel Spacing="2" Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="RunningTasksSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Running tasks" />
                                        <Border Background="{StaticResource KindReadTintBrush}" Style="{StaticResource CountChip}">
                                            <TextBlock
                                                Foreground="{StaticResource StatusRunningBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <ListView
                                    x:Name="RunningTasksList"
                                    MaxHeight="260"
                                    Margin="0,0,0,6"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnRunningTaskClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.SortedTasks, Mode=OneWay}"
                                    SelectionMode="None"
                                    Visibility="{x:Bind RunningTasksSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RunningTaskItem">
                                            <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind TitleTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind KindGlyph}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource StatusRunningBrush}"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                                        views:Pulse.IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Elapsed, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="3"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnStopTaskClick"
                                                    CornerRadius="5"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Stop this task"
                                                    Visibility="{x:Bind CanStop, Mode=OneWay}">
                                                    <FontIcon FontSize="9" Glyph="&#xE71A;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>

                            <!--  Session changes  -->
                            <StackPanel Spacing="2" Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="SessionChangesSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Changes" />
                                        <Border
                                            Background="{StaticResource KindEditTintBrush}"
                                            Style="{StaticResource CountChip}"
                                            views:Pulse.IsActive="{x:Bind Session.Status.HasFreshChanges, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{StaticResource KindEditBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    Spacing="2"
                                    Visibility="{x:Bind SessionChangesSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <TextBlock
                                        Margin="8,0,8,4"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Session.Status.ChangeSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <ListView
                                        MaxHeight="220"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnSessionChangeClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Status.Changes, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionFileChange">
                                                <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                        ToolTipService.ToolTip="{x:Bind KindText, Mode=OneWay}"
                                                        views:Pulse.IsActive="{x:Bind IsFresh, Mode=OneWay}" />
                                                    <StackPanel Grid.Column="1" Spacing="0">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Directory}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11">
                                                        <Run Foreground="{StaticResource DiffAddedForegroundBrush}" Text="{x:Bind AddedText, Mode=OneWay}" />
                                                        <Run Foreground="{StaticResource DiffRemovedForegroundBrush}" Text="{x:Bind RemovedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>

                            <!--  Artifacts  -->
                            <StackPanel Spacing="2" Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="PlansSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Artifacts" />
                                        <Border Background="{StaticResource KindPlanTintBrush}" Style="{StaticResource CountChip}">
                                            <TextBlock
                                                Foreground="{StaticResource KindPlanBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <ListView
                                    Margin="0,0,0,6"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnArtifactClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.Artifacts, Mode=OneWay}"
                                    SelectionMode="None"
                                    Visibility="{x:Bind PlansSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionArtifact">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="26"
                                                    Height="26"
                                                    Background="{StaticResource KindPlanTintBrush}"
                                                    CornerRadius="6">
                                                    <FontIcon
                                                        FontSize="12"
                                                        Foreground="{StaticResource KindPlanBrush}"
                                                        Glyph="{x:Bind Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap">
                                                        <Run Text="{x:Bind Subtitle}" /><Run Text=" · " /><Run Text="{x:Bind UpdatedAt, Mode=OneWay, Converter={StaticResource RelativeTime}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
