<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.AgentSessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    xmlns:agents="using:Codale.Core.Agents"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:NotBoolConverter x:Key="NotBool" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />

        <!--  The session card's model / effort / mode controls: labelled tiles  -->
        <Style x:Key="SessionControlButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7,8,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SessionControlCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SessionControlValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Collapsible sidebar section header  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style
            x:Key="PanelItemFlush"
            BasedOn="{StaticResource PanelItem}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PickerFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        </Style>

        <Style x:Key="EndpointFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PickerTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="8,4,8,4" />
        </Style>

        <Style x:Key="PickerHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <Style x:Key="PickerRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Margin="0,8,8,8"
        Background="{ThemeResource ShellSidePanelBackgroundBrush}"
        BorderBrush="{ThemeResource ShellSidePanelStrokeBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Translation="0,0,24">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid CornerRadius="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Padding="14,10,10,10">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="30"
                        Height="30"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="9">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE99A;" />
                    </Border>
                    <!--  The provider is chosen in Settings; this only shows it  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTipService.ToolTip="Agent provider (change it in Settings)">
                        <StackPanel Spacing="0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind EndpointLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Agent cockpit" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,2"
                        Margin="0,0,4,0"
                        Visibility="{x:Bind IsIsolated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="10"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE8EA;" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Isolated" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="SeaGreen"
                                Visibility="{x:Bind Session.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                views:Pulse.IsActive="{x:Bind Session.IsConnected, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Session.ProviderName, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind CliUpdate.VersionText, Mode=OneWay}"
                        Visibility="{x:Bind CliUpdate.IsVersionKnown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnUpdateCliClick"
                        ToolTipService.ToolTip="{x:Bind CliUpdate.UpdateTip, Mode=OneWay}"
                        Visibility="{x:Bind CliUpdate.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE896;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Main body  -->
            <Grid
                Grid.Row="1"
                Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <!--  Controls row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Live sections  -->
                    <RowDefinition x:Name="LiveRow" Height="Auto" />
                    <!--  History section  -->
                    <RowDefinition x:Name="HistoryRow" Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="10">
                    <!--  Reading history  -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind Workspace.IsViewingHistory, Mode=OneWay}"
                        Message="{x:Bind Workspace.HistoryTitle, Mode=OneWay}"
                        Severity="Informational"
                        Title="Viewing history"
                        Visibility="{x:Bind Workspace.IsViewingHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <InfoBar.ActionButton>
                            <Button Click="OnReturnToLiveClick" Content="Back to live session" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--  The live session controls  -->
                    <Border
                        Padding="12,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <!--  Model, effort and mode  -->
                            <Grid ColumnSpacing="6" Visibility="{x:Bind ShowSessionPickers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="6*" />
                                    </Grid.ColumnDefinitions>

                                <Button
                                    Click="OnModelChipClick"
                                    IsEnabled="{x:Bind Session.CanChangeMode, Mode=OneWay}"
                                    Style="{StaticResource SessionControlButton}"
                                    ToolTipService.ToolTip="{x:Bind Session.ModelDisplay, Mode=OneWay}">
                                    <Grid ColumnSpacing="6" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.ColumnSpan="3"
                                            Style="{StaticResource SessionControlCaption}"
                                            Text="MODEL" />
                                        <FontIcon
                                            Grid.Row="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE99A;" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource SessionControlValue}"
                                            Text="{x:Bind Session.ModelDisplay, Mode=OneWay}" />
                                        <FontIcon
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            FontSize="8"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE70D;" />
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Click="OnModeChipClick"
                                    IsEnabled="{x:Bind Session.CanChangeMode, Mode=OneWay}"
                                    Style="{StaticResource SessionControlButton}"
                                    ToolTipService.ToolTip="How much the agent may do before asking (locked while the agent is working)">
                                    <Grid ColumnSpacing="6" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.ColumnSpan="3"
                                            Style="{StaticResource SessionControlCaption}"
                                            Text="MODE" />
                                        <FontIcon
                                            Grid.Row="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Session.ModeGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource SessionControlValue}"
                                            Text="{x:Bind Session.ModeDisplayText, Mode=OneWay}" />
                                        <FontIcon
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            FontSize="8"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE70D;" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <!--  Isolated: merge back or discard  -->
                            <StackPanel Spacing="8" Visibility="{x:Bind IsIsolated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="OnMergeIsolatedClick"
                                        CornerRadius="8"
                                        FontSize="12"
                                        IsEnabled="{x:Bind Workspace.IsStartingWorktree, Mode=OneWay, Converter={StaticResource NotBool}}"
                                        Padding="10,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Merge this session's branch into your project and remove the worktree">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph="&#xEA3C;" />
                                            <TextBlock Text="Merge back" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Click="OnDiscardIsolatedClick"
                                        CornerRadius="8"
                                        FontSize="12"
                                        IsEnabled="{x:Bind Workspace.IsStartingWorktree, Mode=OneWay, Converter={StaticResource NotBool}}"
                                        Padding="10,8"
                                        ToolTipService.ToolTip="Throw away the work done in this worktree">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                            <TextBlock Text="Discard" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind Workspace.IsMergingWithAgent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ProgressRing Width="14" Height="14" IsActive="True" />
                                <TextBlock
                                    FontSize="11"
                                    Text="Git could not merge cleanly - an agent is merging it for you..."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind Workspace.WorktreeError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Workspace.WorktreeError, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                            <!--  Vitals: context ring beside the usage limits  -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnCompactContextClick"
                                        CornerRadius="32"
                                        ToolTipService.ToolTip="Compact the context (/compact)">
                                    <Grid>
                                        <ProgressRing
                                            Width="64"
                                            Height="64"
                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsIndeterminate="False"
                                            Maximum="100"
                                            Value="{x:Bind Workspace.Status.ContextPercent, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE9D9;" />
                                    </Grid>
                                    </Button>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SessionControlCaption}"
                                        Text="COMPACT" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Workspace.Status.ContextSummary, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <StackPanel Spacing="4" Visibility="{x:Bind Workspace.Status.HasFiveHour, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SessionControlCaption}" Text="USAGE" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Workspace.Status.FiveHourSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <!--  Total in the accent colour, the history drawn over it: the visible tail is the latest prompt  -->
                                        <Grid>
                                            <ProgressBar
                                                MinHeight="6"
                                                CornerRadius="3"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Maximum="100"
                                                Value="{x:Bind Workspace.Status.FiveHourPercent, Mode=OneWay}" />
                                            <ProgressBar
                                                MinHeight="6"
                                                Background="Transparent"
                                                CornerRadius="3"
                                                Foreground="{x:Bind Workspace.Status.FiveHourPercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                                Maximum="100"
                                                Value="{x:Bind Workspace.Status.PreviousFiveHourPercent, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Visibility="{x:Bind Workspace.Status.HasLongWindowOnly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SessionControlCaption}" Text="USAGE" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Workspace.Status.SevenDaySummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <ProgressBar
                                            MinHeight="6"
                                            CornerRadius="3"
                                            Foreground="{x:Bind Workspace.Status.SevenDayPercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                            Maximum="100"
                                            Value="{x:Bind Workspace.Status.SevenDayPercent, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Visibility="{x:Bind Workspace.Status.ShowEmptyUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SessionControlCaption}" Text="USAGE" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="0%" />
                                        </Grid>
                                        <ProgressBar
                                            MinHeight="6"
                                            CornerRadius="3"
                                            Maximum="100"
                                            Value="0" />
                                    </StackPanel>
                                    <!--  A BYOK endpoint has no readable quota: session tokens against a fixed budget  -->
                                    <StackPanel Spacing="4" Visibility="{x:Bind Workspace.Status.HasTokenUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SessionControlCaption}" Text="USAGE" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Workspace.Status.TokenUsageSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <ProgressBar
                                            MinHeight="6"
                                            CornerRadius="3"
                                            Foreground="{x:Bind Workspace.Status.TokenUsagePercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                                            Maximum="100"
                                            Value="{x:Bind Workspace.Status.TokenUsagePercent, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Live sections  -->
                <ScrollViewer
                    x:Name="LiveHost"
                    Grid.Row="1"
                    Margin="-12,10,-12,0"
                    Padding="12,0">
                    <StackPanel Spacing="10">
                        <!--  Todos  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Spacing="2">
                            <ToggleButton
                                x:Name="TodosSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Todos" />
                                    <Border
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource KindTodoTintBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock FontSize="10" Foreground="{StaticResource KindTodoBrush}">
                                            <Run Text="{x:Bind Session.TasksDone, Mode=OneWay}" />
                                            <Run Text="/" />
                                            <Run Text="{x:Bind Session.TasksTotal, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <StackPanel
                                Margin="14,2,0,4"
                                Spacing="4"
                                Visibility="{x:Bind TodosSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <ProgressBar
                                    Margin="8,0,8,4"
                                    Maximum="{x:Bind Session.TasksTotal, Mode=OneWay}"
                                    Value="{x:Bind Session.TasksDone, Mode=OneWay}"
                                    Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />

                                <ListView
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.Todos, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="agents:TodoItem">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{x:Bind Status, Converter={StaticResource TodoBrush}}"
                                                    Glyph="{x:Bind Status, Converter={StaticResource TodoGlyph}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    Foreground="{x:Bind Status, Converter={StaticResource TodoTextBrush}}"
                                                    Text="{x:Bind Content}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                        </Border>

                        <!--  Running tasks  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Spacing="2">
                            <ToggleButton
                                x:Name="RunningTasksSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Running tasks" />
                                    <Border
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource KindReadTintBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource StatusRunningBrush}"
                                            Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <ListView
                                x:Name="RunningTasksList"
                                Margin="14,2,0,4"
                                MaxHeight="260"
                                IsItemClickEnabled="True"
                                ItemClick="OnRunningTaskClick"
                                ItemContainerStyle="{StaticResource PanelItem}"
                                ItemsSource="{x:Bind Session.SortedTasks, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind RunningTasksSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RunningTaskItem">
                                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind TitleTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Glyph="{x:Bind KindGlyph}" />
                                            <Button
                                                Grid.Column="3"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnStopTaskClick"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Stop this task"
                                                Visibility="{x:Bind CanStop, Mode=OneWay}">
                                                <FontIcon FontSize="10" Glyph="&#xE71A;" />
                                            </Button>
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="5">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{StaticResource StatusRunningBrush}"
                                                    Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                                    views:Pulse.IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind Elapsed, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        </Border>

                        <!--  Session changes  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Spacing="2">
                            <ToggleButton
                                x:Name="SessionChangesSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Session changes" />
                                    <Border
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource KindEditTintBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}"
                                        views:Pulse.IsActive="{x:Bind Session.Status.HasFreshChanges, Mode=OneWay}">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource KindEditBrush}"
                                            Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <StackPanel
                                Margin="14,2,0,4"
                                Spacing="4"
                                Visibility="{x:Bind SessionChangesSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <TextBlock
                                    Margin="8,0,8,2"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Session.Status.ChangeSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <ListView
                                    MaxHeight="220"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnSessionChangeClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.Status.Changes, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionFileChange">
                                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                    views:Pulse.IsActive="{x:Bind IsFresh, Mode=OneWay}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Directory}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                        Text="{x:Bind KindText, Mode=OneWay}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11">
                                                        <Run Foreground="{StaticResource DiffAddedForegroundBrush}" Text="{x:Bind AddedText, Mode=OneWay}" />
                                                        <Run Foreground="{StaticResource DiffRemovedForegroundBrush}" Text="{x:Bind RemovedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                        </Border>

                        <!--  Artifacts  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Spacing="2">
                            <ToggleButton
                                x:Name="PlansSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Artifacts" />
                                    <Border
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource KindPlanTintBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource KindPlanBrush}"
                                            Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <StackPanel Margin="14,2,0,4" Visibility="{x:Bind PlansSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <ListView
                                    IsItemClickEnabled="True"
                                    ItemClick="OnArtifactClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.Artifacts, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionArtifact">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="24"
                                                    Height="24"
                                                    Background="{StaticResource KindPlanTintBrush}"
                                                    CornerRadius="6">
                                                    <FontIcon
                                                        FontSize="11"
                                                        Foreground="{StaticResource KindPlanBrush}"
                                                        Glyph="{x:Bind Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        TextTrimming="CharacterEllipsis">
                                                        <Run Text="{x:Bind Subtitle}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{x:Bind UpdatedAt, Mode=OneWay, Converter={StaticResource RelativeTime}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                        Text="{x:Bind StatusText, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  History  -->
                <Grid
                    x:Name="HistoryHost"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    RowSpacing="2"
                    Visibility="{x:Bind Workspace.Sessions.Sessions.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ToggleButton
                            x:Name="HistorySection"
                            HorizontalAlignment="Stretch"
                            Click="OnHistorySectionClick"
                            IsChecked="True"
                            Style="{StaticResource SectionHeader}">
                            <ToggleButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnRebuildHistoryClick" Text="Rebuild and optimize history database">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE895;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ToggleButton.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="History" />
                                <Border
                                    Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Workspace.Sessions.Sessions.Count, Mode=OneWay}" />
                                </Border>
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    IsActive="{x:Bind Workspace.Sessions.IsLoading, Mode=OneWay}" />
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    IsActive="{x:Bind Workspace.Sessions.IsOptimizing, Mode=OneWay}"
                                    ToolTipService.ToolTip="Rebuilding and optimizing history database" />
                            </StackPanel>
                        </ToggleButton>

                        <HyperlinkButton
                            x:Name="HistoryShowAllButton"
                            Margin="0,0,2,0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnHistoryShowAllClick"
                            FontSize="11"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock
                        x:Name="HistoryNotListedText"
                        Grid.Row="1"
                        Margin="22,2,8,4"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Work joins the history once you send a message."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="HistoryList"
                        Grid.Row="2"
                        Margin="14,0,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnSessionClick"
                        ItemContainerStyle="{StaticResource PanelItemFlush}"
                        SelectionMode="None"
                        Visibility="{x:Bind HistorySection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionListItem">
                                <Grid
                                    Padding="8,6"
                                    Background="Transparent"
                                    ColumnSpacing="8"
                                    ToolTipService.ToolTip="{x:Bind Summary.FirstPrompt}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnRetitleSessionClick" Text="Rename history">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnRebuildHistoryClick" Text="Rebuild and optimize history database">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE895;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="OnDeleteSessionClick" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Delete history">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid Width="3">
                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind IsOpen, Mode=OneWay}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="{x:Bind TurnsText}" /><Run Text=" · " /><Run Text="{x:Bind UpdatedAt, Converter={StaticResource RelativeTime}}" />
                                            </TextBlock>
                                            <Border
                                                Padding="7,1"
                                                Background="{StaticResource KindReadTintBrush}"
                                                CornerRadius="8"
                                                Visibility="{x:Bind IsWorking, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource StatusRunningBrush}"
                                                        views:Pulse.IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{StaticResource StatusRunningBrush}"
                                                        Text="running" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Padding="7,1"
                                                Background="{StaticResource KindWriteTintBrush}"
                                                CornerRadius="8"
                                                Visibility="{x:Bind IsOpenIdle, Mode=OneWay}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource StatusSuccessBrush}"
                                                    Text="open" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
