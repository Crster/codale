<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.AgentSessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    xmlns:agents="using:Codale.Core.Agents"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:NotBoolConverter x:Key="NotBool" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />

        <!--  Collapsible sidebar section header  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style
            x:Key="PanelItemFlush"
            BasedOn="{StaticResource PanelItem}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PickerFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        </Style>

        <Style x:Key="PickerTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="8,4,8,4" />
        </Style>

        <Style x:Key="PickerHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <Style x:Key="PickerRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  A flat, full-width row inside the session card (model, mode)  -->

        <Style x:Key="CountChip" TargetType="Border">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CountChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="CompactAction" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CompactCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailFlyout" TargetType="FlyoutPresenter">
            <Setter Property="IsDefaultShadowEnabled" Value="False" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <!-- The chat always uses a compact rail. Details open beside it without resizing the conversation. -->
    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Padding="8,12" Spacing="10">
                <Button x:Name="ProfileButton" Style="{StaticResource CompactAction}"
                        AutomationProperties.Name="Agent account" ToolTipService.ToolTip="{x:Bind Workspace.CliEndpoint.ActiveName, Mode=OneWay}">
                    <Grid Width="30" Height="30">
                        <PersonPicture Width="30" Height="30"
                                       Initials="{x:Bind Workspace.CliEndpoint.AvatarInitials, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{StaticResource StatusSuccessBrush}"
                                 Visibility="{x:Bind Session.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="ProfileFlyout" AreOpenCloseAnimationsEnabled="False"
                                Opening="OnDetailFlyoutOpening" Closed="OnDetailFlyoutClosed" Placement="LeftEdgeAlignedTop" FlyoutPresenterStyle="{StaticResource DetailFlyout}">
                            <StackPanel Width="320" Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind CliUpdate.Cli.DisplayName, Mode=OneWay}" FontSize="16"
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CliUpdate.VersionText, Mode=OneWay}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind CliUpdate.IsVersionKnown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="2" Click="OnUpdateCliClick" VerticalAlignment="Center"
                                            Padding="10,6" CornerRadius="8" AutomationProperties.Name="Update CLI"
                                            ToolTipService.ToolTip="{x:Bind CliUpdate.UpdateTip, Mode=OneWay}"
                                            Visibility="{x:Bind CliUpdate.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="Update" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Choose an account" FontSize="12" FontWeight="SemiBold" />
                                <ListView
                                        MaxHeight="340"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnProfileItemClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        IsEnabled="{x:Bind Workspace.CliEndpoint.CanSwitch, Mode=OneWay}"
                                        ItemsSource="{x:Bind Workspace.CliEndpoint.Choices, Mode=OneWay}"
                                        SelectedItem="{x:Bind Workspace.CliEndpoint.Selected, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderChoice">
                                                <StackPanel Padding="2,2" Spacing="1">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border Width="48" Height="48" Padding="4" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="{x:Bind UsageSummary, Mode=OneWay}"
                        Visibility="{x:Bind HasUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="34" Height="34">
                            <ProgressRing Width="34" Height="34" IsIndeterminate="False" Minimum="0" Maximum="100"
                                          Value="{x:Bind UsagePercent, Mode=OneWay}"
                                          Foreground="{x:Bind UsagePercent, Mode=OneWay, Converter={StaticResource UsageToBrush}}" />
                            <TextBlock Text="{x:Bind UsagePercentText, Mode=OneWay}" FontSize="9" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Height="1" Margin="8,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button Style="{StaticResource CompactAction}" AutomationProperties.Name="Todos"
                        ToolTipService.ToolTip="Todos">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D5;" FontSize="10"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Session.TasksTotal, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="38" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="TodosFlyout" AreOpenCloseAnimationsEnabled="False"
                                Opening="OnDetailFlyoutOpening" Closed="OnDetailFlyoutClosed" Placement="LeftEdgeAlignedTop" FlyoutPresenterStyle="{StaticResource DetailFlyout}">
                            <StackPanel Width="340" Spacing="10">
                                <TextBlock Text="No todos yet." FontSize="12" Margin="8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />
                                <ScrollViewer MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel Spacing="2" Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="TodosSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Todos" />
                                        <Border
                                            Background="{StaticResource KindTodoTintBrush}"
                                            Style="{StaticResource CountChip}"
                                            Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Foreground="{StaticResource KindTodoBrush}" Style="{StaticResource CountChipText}">
                                                <Run Text="{x:Bind Session.TasksDone, Mode=OneWay}" /><Run Text="/" /><Run Text="{x:Bind Session.TasksTotal, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    Spacing="4"
                                    Visibility="{x:Bind TodosSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ProgressBar
                                        Margin="8,2,8,4"
                                        MinHeight="3"
                                        CornerRadius="1.5"
                                        Foreground="{StaticResource KindTodoBrush}"
                                        Maximum="{x:Bind Session.TasksTotal, Mode=OneWay}"
                                        Value="{x:Bind Session.TasksDone, Mode=OneWay}"
                                        Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />

                                    <ListView
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Todos, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="agents:TodoItem">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoBrush}}"
                                                        Glyph="{x:Bind Status, Converter={StaticResource TodoGlyph}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoTextBrush}}"
                                                        Text="{x:Bind Content}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Style="{StaticResource CompactAction}" AutomationProperties.Name="Background tasks"
                        ToolTipService.ToolTip="Background tasks">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontSize="10"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="38" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="TasksFlyout" AreOpenCloseAnimationsEnabled="False"
                                Opening="OnDetailFlyoutOpening" Closed="OnDetailFlyoutClosed" Placement="LeftEdgeAlignedTop" FlyoutPresenterStyle="{StaticResource DetailFlyout}">
                            <StackPanel Width="340" Spacing="10">
                                <TextBlock Text="No background tasks." FontSize="12" Margin="8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />
                                <ScrollViewer MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel Spacing="2" Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="RunningTasksSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Background tasks" />
                                        <Border Background="{StaticResource KindReadTintBrush}" Style="{StaticResource CountChip}">
                                            <TextBlock
                                                Foreground="{StaticResource StatusRunningBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <ListView
                                    x:Name="RunningTasksList"
                                    MaxHeight="260"
                                    Margin="0,0,0,6"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnRunningTaskClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.SortedTasks, Mode=OneWay}"
                                    SelectionMode="None"
                                    Visibility="{x:Bind RunningTasksSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RunningTaskItem">
                                            <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind TitleTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind KindGlyph}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource StatusRunningBrush}"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                                        views:Pulse.IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Elapsed, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="3"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnStopTaskClick"
                                                    CornerRadius="5"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Stop this task"
                                                    Visibility="{x:Bind CanStop, Mode=OneWay}">
                                                    <FontIcon FontSize="9" Glyph="&#xE71A;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Style="{StaticResource CompactAction}" AutomationProperties.Name="Session changes"
                        ToolTipService.ToolTip="Session changes">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" FontSize="10"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="38" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="FilesFlyout" AreOpenCloseAnimationsEnabled="False"
                                Opening="OnDetailFlyoutOpening" Closed="OnDetailFlyoutClosed" Placement="LeftEdgeAlignedTop" FlyoutPresenterStyle="{StaticResource DetailFlyout}">
                            <StackPanel Width="340" Spacing="10">
                                <TextBlock Text="No files changed in this session." FontSize="12" Margin="8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />
                                <ScrollViewer MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel Spacing="2" Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="SessionChangesSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Session changes" />
                                        <Border
                                            Background="{StaticResource KindEditTintBrush}"
                                            Style="{StaticResource CountChip}"
                                            views:Pulse.IsActive="{x:Bind Session.Status.HasFreshChanges, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{StaticResource KindEditBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="0,0,0,6"
                                    Spacing="2"
                                    Visibility="{x:Bind SessionChangesSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <TextBlock
                                        Margin="8,0,8,4"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Session.Status.ChangeSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <ListView
                                        MaxHeight="220"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnSessionChangeClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Status.Changes, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionFileChange">
                                                <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                        ToolTipService.ToolTip="{x:Bind KindText, Mode=OneWay}"
                                                        views:Pulse.IsActive="{x:Bind IsFresh, Mode=OneWay}" />
                                                    <StackPanel Grid.Column="1" Spacing="0">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Directory}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11">
                                                        <Run Foreground="{StaticResource DiffAddedForegroundBrush}" Text="{x:Bind AddedText, Mode=OneWay}" />
                                                        <Run Foreground="{StaticResource DiffRemovedForegroundBrush}" Text="{x:Bind RemovedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Style="{StaticResource CompactAction}" AutomationProperties.Name="Artifacts"
                        ToolTipService.ToolTip="Artifacts">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="10"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="38" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ArtifactsFlyout" AreOpenCloseAnimationsEnabled="False"
                                Opening="OnDetailFlyoutOpening" Closed="OnDetailFlyoutClosed" Placement="LeftEdgeAlignedTop" FlyoutPresenterStyle="{StaticResource DetailFlyout}">
                            <StackPanel Width="340" Spacing="10">
                                <TextBlock Text="No artifacts yet." FontSize="12" Margin="8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />
                                <ScrollViewer MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel Spacing="2" Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ToggleButton
                                    x:Name="PlansSection"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="True"
                                    Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Artifacts" />
                                        <Border Background="{StaticResource KindPlanTintBrush}" Style="{StaticResource CountChip}">
                                            <TextBlock
                                                Foreground="{StaticResource KindPlanBrush}"
                                                Style="{StaticResource CountChipText}"
                                                Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <ListView
                                    Margin="0,0,0,6"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnArtifactClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.Artifacts, Mode=OneWay}"
                                    SelectionMode="None"
                                    Visibility="{x:Bind PlansSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionArtifact">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="26"
                                                    Height="26"
                                                    Background="{StaticResource KindPlanTintBrush}"
                                                    CornerRadius="6">
                                                    <FontIcon
                                                        FontSize="12"
                                                        Foreground="{StaticResource KindPlanBrush}"
                                                        Glyph="{x:Bind Glyph}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap">
                                                        <Run Text="{x:Bind Subtitle}" /><Run Text=" · " /><Run Text="{x:Bind UpdatedAt, Mode=OneWay, Converter={StaticResource RelativeTime}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border Style="{StaticResource SectionDivider}" />
                            </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
