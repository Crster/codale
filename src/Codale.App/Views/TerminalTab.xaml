<?xml version="1.0" encoding="utf-8" ?>
<!--
  The notebook terminal: a black terminal where every command typed at the prompt line becomes a
  block above it - its own prompt line, then its output - running in a process of its own. The
  prompt is the last line of the flow, so an empty terminal has it at the top and every command
  pushes it down. Details (folder, shell, timing) are quiet text in the app's type, not coloured
  blocks. Blocks are added to the NotebookPanel in code. The terminal is dark in every app theme.
-->
<UserControl
    x:Class="Codale.App.Views.TerminalTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Codale.App.Views"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="Scroller"
        Padding="4,8,4,8"
        Background="#0C0C0C"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <views:NotebookPanel x:Name="Notebook">

            <!--
              The prompt: always the last child, right after the newest command. Two rows, like every
              block above it - the full folder on top, then the shell and the command.
            -->
            <Grid
                x:Name="InputCell"
                Margin="0,6,0,0"
                Padding="8,6,0,4"
                BorderBrush="#26262C"
                BorderThickness="0,1,0,0"
                RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 0: where the command will run, and which running command a line goes to while one is targeted.  -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  The folder: click to move to a subfolder, the parent, or any folder.  -->
                    <Button
                        x:Name="CwdButton"
                        Height="22"
                        Margin="-4,0,0,0"
                        Padding="4,0,6,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Change folder"
                        Click="OnCwdClick"
                        Style="{StaticResource ShellTextButton}">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#505058"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                x:Name="CwdText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="#B8B8C0"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="7"
                                Foreground="#505058"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="TargetChip"
                        Grid.Column="1"
                        Height="20"
                        Margin="0,0,6,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Click="OnTargetChipClick"
                        Style="{StaticResource ShellTextButton}"
                        ToolTipService.ToolTip="Lines you send go to this running command. Click or press Esc to run new commands again."
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TargetText" FontSize="11.5" Foreground="#A78BFA" />
                            <FontIcon FontSize="8" Foreground="#808088" Glyph="&#xE711;" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  Row 1: the shell new commands run under (click to switch it for this tab), the prompt, the command.  -->
                <Grid Grid.Row="1" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="ShellButton"
                        Height="22"
                        Margin="-6,0,-4,0"
                        Padding="6,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Change shell"
                        Click="OnShellClick"
                        Style="{StaticResource ShellTextButton}"
                        ToolTipService.ToolTip="The shell new commands run under. Click to switch.">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock
                                x:Name="ShellText"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="#808088" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="7"
                                Foreground="#505058"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Name="PromptGlyph"
                        Grid.Column="1"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        Foreground="#A78BFA"
                        Text="❯" />

                    <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!--
                      The ghost suggestion under the typed text: what is typed again, invisible, so the
                      rest lands right after the caret in faint grey. From PowerShell (its history and tab
                      completion) or Shell autocomplete; Tab or Right takes it, Ctrl+Right one word.
                    -->
                    <TextBlock
                        x:Name="Ghost"
                        Padding="0,2,0,2"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"><Run x:Name="GhostTyped" Foreground="Transparent" /><Run x:Name="GhostRest" Foreground="#5C5C66" /></TextBlock>

                    <TextBox
                        x:Name="Input"
                        MinHeight="0"
                        Padding="0,2,0,2"
                        VerticalAlignment="Top"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Command"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#E8E8E8"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        PlaceholderForeground="#505058"
                        PlaceholderText="type a command"
                        PreviewKeyDown="OnInputPreviewKeyDown"
                        SelectionChanged="OnInputSelectionChanged"
                        SelectionHighlightColor="#264F78"
                        TextChanged="OnInputTextChanged"
                        TextWrapping="Wrap">
                        <!--  A bare terminal line: no box, no focus underline, in any state.  -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#E8E8E8" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8E8E8" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8E8E8" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#505058" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#505058" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#45454C" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    </Grid>

                    <!--  Commands from this project's history that start like what is typed; Tab takes the highlighted one.  -->
                    <StackPanel
                        x:Name="SuggestionList"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,2"
                        Spacing="0"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </views:NotebookPanel>
    </ScrollViewer>
</UserControl>
