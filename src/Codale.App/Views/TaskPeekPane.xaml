<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.TaskPeekPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Codale.App.Views"
    mc:Ignorable="d">

    <!--  A live, read-only look at one running task, shown beside the chat.  -->
    <!--  The log area uses the terminal's own colours (#0C0C0C / #CCCCCC); the header
          is as tall as the tab strip beside it so the two rows line up.  -->
    <Grid
        Background="{ThemeResource ShellCentreBackgroundBrush}"
        BorderBrush="{ThemeResource ShellHairlineBrush}"
        BorderThickness="1,0,0,0"
        RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="12,0,6,0"
            BorderBrush="{ThemeResource ShellHairlineBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="KindIcon"
                VerticalAlignment="Center"
                FontSize="14" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <Ellipse
                x:Name="RunningDot"
                Grid.Column="2"
                Width="7"
                Height="7"
                VerticalAlignment="Center"
                Fill="{StaticResource StatusRunningBrush}" />
            <Button
                x:Name="StopButton"
                Grid.Column="3"
                Click="OnStopClick"
                Style="{StaticResource ShellTextButton}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="10" Foreground="{StaticResource StatusFailedBrush}" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
            <Button
                x:Name="OpenInTabButton"
                Grid.Column="4"
                Click="OnOpenInTabClick"
                Style="{StaticResource ShellTextButton}"
                ToolTipService.ToolTip="Open this output in its own tab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                    <TextBlock Text="Open in tab" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="5"
                Click="OnCloseClick"
                Style="{StaticResource ShellIconButton}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="11" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!--  A shell task's facts above its output: the command (wrapped), what it does, and how risky it is.  -->
        <Grid
            x:Name="DetailsPanel"
            Grid.Row="1"
            Padding="12,8,12,8"
            Background="#0C0C0C"
            ColumnSpacing="10"
            RowSpacing="4"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#767676" Text="Run:" />
            <TextBlock
                x:Name="RunText"
                Grid.Column="1"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="#F2F2F2"
                IsTextSelectionEnabled="True"
                MaxHeight="140"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#767676"
                Text="Description:" />
            <TextBlock
                x:Name="DescriptionText"
                Grid.Row="1"
                Grid.Column="1"
                FontSize="12"
                Foreground="#CCCCCC"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#767676"
                Text="Assessment:" />
            <TextBlock
                x:Name="AssessmentText"
                Grid.Row="2"
                Grid.Column="1"
                FontSize="12"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <Rectangle
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Height="1"
                Margin="0,0,0,-8"
                VerticalAlignment="Bottom"
                Fill="#333333" />
        </Grid>

        <!--  A subagent reads as a transcript; only a shell's log is the black terminal panel.  -->
        <ScrollViewer
            x:Name="TranscriptScroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <views:SubagentTranscript x:Name="Transcript" />
        </ScrollViewer>

        <ScrollViewer
            x:Name="LogScroll"
            Grid.Row="2"
            Background="#0C0C0C"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="LogText"
                Margin="12,8,8,4"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                IsTextSelectionEnabled="True"
                TextWrapping="NoWrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
