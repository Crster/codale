<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.SearchTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <!--  Nothing asked yet: point at the title bar box  -->
        <StackPanel
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
            <FontIcon
                FontSize="32"
                Glyph="&#xE721;"
                Opacity="0.5" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Find code by describing it" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.7"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Type what you are looking for in the search box at the top, like &quot;where are settings saved&quot; or &quot;player jump&quot;. The local model finds the files and shows the code." />
        </StackPanel>

        <Grid Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  One slim status line: progress, file count, time  -->
            <Grid
                Padding="20,10,12,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    Padding="8,2"
                    Command="{x:Bind ViewModel.StopCommand}"
                    Content="Stop"
                    FontSize="12"
                    Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!--  Files and their code, nothing else  -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    Padding="16,12,16,24"
                    ItemsSource="{x:Bind ViewModel.Files}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchFileItem">
                            <Border
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Button
                                        Padding="12,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        Click="OnFileClick"
                                        CornerRadius="6,6,0,0"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Open in the editor">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="12"
                                                Glyph="&#xE8A5;"
                                                Opacity="0.7" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind RelativePath}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="11"
                                                Opacity="0.55"
                                                Text="{x:Bind Detail}" />
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{x:Bind Ranges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SearchRangeItem">
                                                <Border
                                                    Background="Transparent"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Loaded="OnRangeLoaded"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Double-click to open the file here">
                                                    <ScrollViewer
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Auto"
                                                        VerticalScrollBarVisibility="Disabled"
                                                        VerticalScrollMode="Disabled">
                                                        <Grid Padding="0,6,12,6" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                MinWidth="40"
                                                                FontFamily="Cascadia Mono, Consolas"
                                                                FontSize="12"
                                                                Opacity="0.4"
                                                                Text="{x:Bind Gutter}"
                                                                TextAlignment="Right" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontFamily="Cascadia Mono, Consolas"
                                                                FontSize="12"
                                                                IsTextSelectionEnabled="True"
                                                                Text="{x:Bind Code}"
                                                                views:KeywordHighlight.Lines="{x:Bind MatchLines}"
                                                                views:KeywordHighlight.Terms="{x:Bind Terms}" />
                                                        </Grid>
                                                    </ScrollViewer>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
