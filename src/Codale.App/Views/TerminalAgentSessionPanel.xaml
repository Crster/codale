<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.TerminalAgentSessionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:agents="using:Codale.Core.Agents"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />

        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--  Collapsible sidebar section header  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <DataTemplate x:Key="UsageBar" x:DataType="views:UsageMeter">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardCaption}" Text="{x:Bind Label, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Summary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar
                    MinHeight="5"
                    CornerRadius="3"
                    Foreground="{x:Bind Percent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                    Maximum="100"
                    Value="{x:Bind Percent, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Margin="0,8,8,8"
        Background="{ThemeResource ShellSidePanelBackgroundBrush}"
        BorderBrush="{ThemeResource ShellSidePanelStrokeBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Translation="0,0,24">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid CornerRadius="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header: which CLI, its version, a way to update it  -->
            <Grid Padding="14,10,10,10">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="30"
                        Height="30"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="9">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE756;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind CliName, Mode=OneWay}" />
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Terminal agent" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind CliUpdate.VersionText, Mode=OneWay}"
                        Visibility="{x:Bind CliUpdate.IsVersionKnown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnUpdateCliClick"
                        ToolTipService.ToolTip="{x:Bind CliUpdate.UpdateTip, Mode=OneWay}"
                        Visibility="{x:Bind CliUpdate.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE896;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Main body: vitals, live sections, then history  -->
            <Grid Grid.Row="1" Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind HasVitals, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemTemplate="{StaticResource UsageBar}" ItemsSource="{x:Bind Vitals, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <!--  Live sections  -->
                <ScrollViewer
                    x:Name="LiveHost"
                    Grid.Row="1"
                    MaxHeight="420"
                    Margin="-12,10,-12,0"
                    Padding="12,0">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Margin="6,10,6,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalTextAlignment="Center"
                            Text="Todos, file changes and artifacts show up here as the agent works."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind IsLiveEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <!--  Todos  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Todos.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <StackPanel Spacing="2">
                                <ToggleButton x:Name="TodosSection" IsChecked="True" Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Todos" />
                                        <Border
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource KindTodoTintBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource KindTodoBrush}">
                                                <Run Text="{x:Bind Session.TasksDone, Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run Text="{x:Bind Session.TasksTotal, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="14,2,0,4"
                                    Spacing="4"
                                    Visibility="{x:Bind TodosSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ProgressBar
                                        Margin="8,0,8,4"
                                        Maximum="{x:Bind Session.TasksTotal, Mode=OneWay}"
                                        Value="{x:Bind Session.TasksDone, Mode=OneWay}"
                                        Visibility="{x:Bind Session.TasksTotal, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                                    <ListView
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Todos, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="agents:TodoItem">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoBrush}}"
                                                        Glyph="{x:Bind Status, Converter={StaticResource TodoGlyph}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{x:Bind Status, Converter={StaticResource TodoTextBrush}}"
                                                        Text="{x:Bind Content}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Running tasks  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.SortedTasks.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <StackPanel Spacing="2">
                                <ToggleButton x:Name="RunningTasksSection" IsChecked="True" Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Running tasks" />
                                        <Border
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource KindReadTintBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource StatusRunningBrush}"
                                                Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <ListView
                                    x:Name="RunningTasksList"
                                    Margin="14,2,0,4"
                                    MaxHeight="260"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnRunningTaskClick"
                                    ItemContainerStyle="{StaticResource PanelItem}"
                                    ItemsSource="{x:Bind Session.SortedTasks, Mode=OneWay}"
                                    SelectionMode="None"
                                    Visibility="{x:Bind RunningTasksSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RunningTaskItem">
                                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind TitleTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="{x:Bind KindGlyph}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{StaticResource StatusRunningBrush}"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                                        views:Pulse.IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Elapsed, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="3"
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnStopTaskClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Stop this task"
                                                    Visibility="{x:Bind CanStop, Mode=OneWay}">
                                                    <FontIcon FontSize="10" Glyph="&#xE71A;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!--  Session changes  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Status.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <StackPanel Spacing="2">
                                <ToggleButton x:Name="SessionChangesSection" IsChecked="True" Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Session changes" />
                                        <Border
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource KindEditTintBrush}"
                                            CornerRadius="8"
                                            views:Pulse.IsActive="{x:Bind Session.Status.HasFreshChanges, Mode=OneWay}">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource KindEditBrush}"
                                                Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel
                                    Margin="14,2,0,4"
                                    Spacing="4"
                                    Visibility="{x:Bind SessionChangesSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <TextBlock
                                        Margin="8,0,8,2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Session.Status.ChangeSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <ListView
                                        MaxHeight="220"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnChangeClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Status.Changes, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionFileChange">
                                                <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                        views:Pulse.IsActive="{x:Bind IsFresh, Mode=OneWay}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Directory}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10.5"
                                                            Foreground="{x:Bind Kind, Mode=OneWay, Converter={StaticResource FileChangeBrush}}"
                                                            Text="{x:Bind KindText, Mode=OneWay}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="11">
                                                            <Run Foreground="{StaticResource DiffAddedForegroundBrush}" Text="{x:Bind AddedText, Mode=OneWay}" />
                                                            <Run Foreground="{StaticResource DiffRemovedForegroundBrush}" Text="{x:Bind RemovedText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Artifacts  -->
                        <Border Padding="4,4,4,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="{x:Bind Session.Artifacts.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <StackPanel Spacing="2">
                                <ToggleButton x:Name="PlansSection" IsChecked="True" Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Artifacts" />
                                        <Border
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource KindPlanTintBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource KindPlanBrush}"
                                                Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel Margin="14,2,0,4" Visibility="{x:Bind PlansSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                    <ListView
                                        IsItemClickEnabled="True"
                                        ItemClick="OnArtifactClick"
                                        ItemContainerStyle="{StaticResource PanelItem}"
                                        ItemsSource="{x:Bind Session.Artifacts, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionArtifact">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="24"
                                                        Height="24"
                                                        Background="{StaticResource KindPlanTintBrush}"
                                                        CornerRadius="6">
                                                        <FontIcon FontSize="11" Foreground="{StaticResource KindPlanBrush}" Glyph="{x:Bind Glyph}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Title, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <Run Text="{x:Bind Subtitle}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{x:Bind UpdatedAt, Mode=OneWay, Converter={StaticResource RelativeTime}}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ArtifactStatusBrush}}"
                                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  History: the CLI's past conversations, resumed natively in a new tab  -->
                <Grid
                    x:Name="HistoryHost"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ToggleButton
                        x:Name="HistorySection"
                        HorizontalAlignment="Stretch"
                        IsChecked="True"
                        Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="History" />
                            <Border
                                x:Name="HistoryCountBadge"
                                Padding="7,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="HistoryCountText"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>

                    <TextBlock
                        x:Name="HistoryHint"
                        Grid.Row="1"
                        Margin="22,2,8,4"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HistorySection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}" />

                    <ListView
                        x:Name="HistoryList"
                        Grid.Row="2"
                        Margin="14,0,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnHistoryClick"
                        ItemContainerStyle="{StaticResource PanelItem}"
                        SelectionMode="None"
                        Visibility="{x:Bind HistorySection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:TerminalHistoryRow">
                                <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Tip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Meta}" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE768;"
                                        Visibility="{x:Bind ResumeVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
