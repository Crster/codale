<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.EditorTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Codale.App.Views"
    xmlns:controls="using:Codale.App.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Padding="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The tab header carries the file name; this line only surfaces problems -
              load failures and save errors. A successful save says nothing.  -->
        <TextBlock
            FontSize="11"
            Opacity="0.6"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <controls:CodeEditor
                x:Name="FileEditor"
                VerticalAlignment="Stretch" />

            <!--  Bands over the lines a search found; drawn here because the control
                  itself can only highlight one selection or one search word.  -->
            <Canvas
                x:Name="HighlightLayer"
                IsHitTestVisible="False" />

            <!--  Where the highlights are and how to move between them  -->
            <Border
                x:Name="HighlightBar"
                Margin="0,6,22,0"
                Padding="10,4,4,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ProgressRing
                        x:Name="HighlightProgress"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        IsActive="False" />
                    <TextBlock
                        x:Name="HighlightStatus"
                        MaxWidth="260"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPreviousHighlightClick"
                        ToolTipService.ToolTip="Previous (Shift+F3)">
                        <FontIcon FontSize="11" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnNextHighlightClick"
                        ToolTipService.ToolTip="Next (F3)">
                        <FontIcon FontSize="11" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClearHighlightClick"
                        ToolTipService.ToolTip="Clear (Esc)">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  Ask Claude: a prompt composer with the agent's progress streaming below it.
                  Format and Check Issues reuse it without the composer.  -->
            <Border
                x:Name="AskPanel"
                MaxWidth="640"
                Margin="24,0,24,16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <StackPanel>
                    <!--  Composer  -->
                    <Grid x:Name="AskComposer" Padding="12,10,10,10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="AskContextIcon"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="AskContextText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnAskCloseClick"
                                ToolTipService.ToolTip="Close (Esc)">
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <Border
                            x:Name="AskSelectionBox"
                            Grid.Row="1"
                            Padding="10,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="AskSelectionText"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Border>
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AskInput"
                                MinHeight="44"
                                MaxHeight="160"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                TextWrapping="Wrap"
                                TextChanged="OnAskInputTextChanged"
                                PreviewKeyDown="OnAskInputKeyDown" />
                            <Button
                                x:Name="AskSendButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                Click="OnAskSendClick"
                                Style="{StaticResource AccentButtonStyle}">
                                <FontIcon x:Name="AskSendIcon" FontSize="13" Glyph="&#xE724;" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!--  Progress stream  -->
                    <Border
                        x:Name="AskLogArea"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8,12,10"
                        Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        x:Name="AskProgress"
                                        Width="12"
                                        Height="12"
                                        IsActive="False" />
                                    <TextBlock
                                        x:Name="AskLogTitle"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.8" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        x:Name="AskElapsed"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.6" />
                                    <Button
                                        x:Name="AskStopButton"
                                        Padding="6,1"
                                        Click="OnAskSendClick"
                                        ToolTipService.ToolTip="Stop and leave the document as it is"
                                        Visibility="Collapsed">
                                        <TextBlock FontSize="11" Text="Stop" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="AskLogScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AskLogRows" Spacing="3" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Rendered Markdown, swapped in for the editor by the Preview menu item  -->
        <ScrollViewer
            x:Name="MarkdownPreviewHost"
            Grid.Row="1"
            Padding="0,0,12,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <views:MarkdownView x:Name="MarkdownPreview" />
        </ScrollViewer>

        <!--  Images: drawn at their size, shrunk to fit when larger than the tab  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Enabled"
            MaxZoomFactor="8"
            Visibility="{x:Bind ViewModel.IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Image
                x:Name="ImagePreview"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform" />
        </ScrollViewer>

        <!--  Other binary files: nothing to draw, but they can be opened elsewhere  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsBinaryPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon
                FontSize="40"
                Glyph="&#xE7C3;"
                Opacity="0.5" />
            <Button
                HorizontalAlignment="Center"
                Click="OnOpenExternallyClick"
                Content="Open with default app" />
        </StackPanel>
    </Grid>
</UserControl>
