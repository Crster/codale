<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Views.EditorTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Codale.App.Views"
    xmlns:controls="using:Codale.App.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Padding="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The tab header carries the file name; this line only surfaces problems -
              load failures and save errors. A successful save says nothing.  -->
        <TextBlock
            FontSize="11"
            Opacity="0.6"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

        <!--  The file could not be opened: a centered notice in the chat's empty-state style.  -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Spacing="6"
            Visibility="{x:Bind ViewModel.LoadErrorTitle, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE783;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.LoadErrorTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.LoadErrorDetail, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            x:Name="EditorSurface"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <controls:CodeEditor
                x:Name="FileEditor"
                VerticalAlignment="Stretch" />

            <!--  Where the highlights are and how to move between them  -->
            <Border
                x:Name="HighlightBar"
                Margin="0,6,22,0"
                Padding="10,4,4,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ProgressRing
                        x:Name="HighlightProgress"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        IsActive="False" />
                    <TextBlock
                        x:Name="HighlightStatus"
                        MaxWidth="260"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPreviousHighlightClick"
                        ToolTipService.ToolTip="Previous (Shift+F3)">
                        <FontIcon FontSize="11" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnNextHighlightClick"
                        ToolTipService.ToolTip="Next (F3)">
                        <FontIcon FontSize="11" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClearHighlightClick"
                        ToolTipService.ToolTip="Clear (Esc)">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

        </Grid>

        <!--  Rendered Markdown, swapped in for the editor by the Preview menu item  -->
        <ScrollViewer
            x:Name="MarkdownPreviewHost"
            Grid.Row="1"
            Padding="24,16,24,32"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <!--  A centred reading column with larger text; wide panes no longer stretch the lines  -->
            <views:MarkdownView
                x:Name="MarkdownPreview"
                MaxWidth="820"
                HorizontalAlignment="Center"
                BaseFontSize="16" />
        </ScrollViewer>

        <!--  Images: drawn at their size, shrunk to fit when larger than the tab  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Enabled"
            MaxZoomFactor="8"
            Visibility="{x:Bind ViewModel.IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Image
                x:Name="ImagePreview"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform" />
        </ScrollViewer>

        <!--  Audio and video: played with the built-in transport controls  -->
        <MediaPlayerElement
            x:Name="MediaPlayer"
            Grid.Row="1"
            AreTransportControlsEnabled="True"
            AutoPlay="False"
            Stretch="Uniform"
            Visibility="{x:Bind ViewModel.IsMedia, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!--  Other binary files: a full hex dump, loaded lazily from disk  -->
        <controls:HexViewer
            x:Name="HexView"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsBinaryPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
