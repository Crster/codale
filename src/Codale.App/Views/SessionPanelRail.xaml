<?xml version="1.0" encoding="utf-8" ?>
<!--  The collapsed session panel: a narrow rail summarising the expanded panel top to
      bottom - the panel's icon (click to expand), what the agent is doing, model and mode,
      the vitals as small rings, then a count per live section (dimmed at zero). Any badge
      expands the panel too.  -->
<UserControl
    x:Class="Codale.App.Views.SessionPanelRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Codale.App.Views">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />

        <Style x:Key="RailBadge" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Padding" Value="0,5,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="RailCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="RailCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="RailDivider" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--  A vital as a small ring with its percentage inside and a short label below  -->
        <DataTemplate x:Key="RailMeter" x:DataType="views:UsageMeter">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="3"
                ToolTipService.ToolTip="{x:Bind views:SessionPanelRail.MeterTip(Label, Summary), Mode=OneWay}">
                <Grid Width="34" Height="34">
                    <ProgressRing
                        Width="34"
                        Height="34"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                        Foreground="{x:Bind Percent, Mode=OneWay, Converter={StaticResource UsageToBrush}}"
                        IsIndeterminate="False"
                        Maximum="100"
                        Value="{x:Bind Percent, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Text="{x:Bind views:SessionPanelRail.PercentText(Percent), Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource RailCaption}" Text="{x:Bind views:SessionPanelRail.ShortLabel(Label), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
        <StackPanel Padding="0,10,0,10" HorizontalAlignment="Center" Spacing="10">
            <!--  Expand  -->
            <Button
                Width="30"
                Height="30"
                Padding="0"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Expand session panel"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderThickness="0"
                Click="OnExpandClick"
                CornerRadius="9"
                ToolTipService.ToolTip="Expand session panel">
                <FontIcon
                    x:Name="RailIcon"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>

            <!--  What the agent is doing: working, waiting on you, connected  -->
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <ProgressRing
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind Session.IsBusyWorking, Mode=OneWay}"
                    ToolTipService.ToolTip="Working"
                    Visibility="{x:Bind Session.IsBusyWorking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Padding="4"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnExpandClick"
                    ToolTipService.ToolTip="Waiting for you"
                    Visibility="{x:Bind Session.IsWaitingForYou, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    views:Pulse.IsActive="{x:Bind Session.IsWaitingForYou, Mode=OneWay}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                </Button>
                <Border x:Name="ConnectionDot" HorizontalAlignment="Center" ToolTipService.ToolTip="Connected">
                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="SeaGreen"
                        Visibility="{x:Bind Session.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        views:Pulse.IsActive="{x:Bind Session.IsConnected, Mode=OneWay}" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="9"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind CliUpdate.VersionText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="44"
                    ToolTipService.ToolTip="{x:Bind CliUpdate.VersionText, Mode=OneWay}"
                    Visibility="{x:Bind CliUpdate.IsVersionKnown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Width="24"
                    Height="24"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Click="OnUpdateClick"
                    ToolTipService.ToolTip="{x:Bind CliUpdate.UpdateTip, Mode=OneWay}"
                    Visibility="{x:Bind CliUpdate.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE896;" />
                </Button>
            </StackPanel>

            <!--  Model and mode (chat sessions)  -->
            <StackPanel x:Name="ModelBlock" HorizontalAlignment="Center" Spacing="6">
                <Border Style="{StaticResource RailDivider}" />
                <Button
                    Click="OnExpandClick"
                    Style="{StaticResource RailBadge}"
                    ToolTipService.ToolTip="{x:Bind views:SessionPanelRail.ModelTip(Session.ModelDisplay, Session.ModeDisplayText), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Session.ModeGlyph, Mode=OneWay}" />
                        <TextBlock
                            MaxWidth="42"
                            FontSize="9.5"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind Session.ModelDisplay, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Vitals  -->
            <Border Style="{StaticResource RailDivider}" />
            <ItemsControl
                HorizontalAlignment="Center"
                ItemTemplate="{StaticResource RailMeter}"
                ItemsSource="{x:Bind Meters, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!--  Live sections, always listed so the rail reads the same; zero is dimmed  -->
            <Border Style="{StaticResource RailDivider}" />
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <Button
                    Click="OnExpandClick"
                    Opacity="{x:Bind views:SessionPanelRail.Dim(Session.Todos.Count), Mode=OneWay}"
                    Style="{StaticResource RailBadge}"
                    ToolTipService.ToolTip="Todos done / total">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="14" Foreground="{StaticResource KindTodoBrush}" Glyph="&#xE9D5;" />
                        <TextBlock Style="{StaticResource RailCount}">
                            <Run Text="{x:Bind Session.TasksDone, Mode=OneWay}" /><Run Text="/" /><Run Text="{x:Bind Session.TasksTotal, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button
                    Click="OnExpandClick"
                    Opacity="{x:Bind views:SessionPanelRail.Dim(Session.SortedTasks.Count), Mode=OneWay}"
                    Style="{StaticResource RailBadge}"
                    ToolTipService.ToolTip="Running tasks">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="14" Glyph="&#xE945;" />
                        <TextBlock Style="{StaticResource RailCount}" Text="{x:Bind Session.SortedTasks.Count, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Click="OnExpandClick"
                    Opacity="{x:Bind views:SessionPanelRail.Dim(Session.Status.ChangeCount), Mode=OneWay}"
                    Style="{StaticResource RailBadge}"
                    ToolTipService.ToolTip="Files changed">
                    <StackPanel Spacing="3">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE70F;"
                            views:Pulse.IsActive="{x:Bind Session.Status.HasFreshChanges, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource RailCount}" Text="{x:Bind Session.Status.ChangeCount, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Click="OnExpandClick"
                    Opacity="{x:Bind views:SessionPanelRail.Dim(Session.Artifacts.Count), Mode=OneWay}"
                    Style="{StaticResource RailBadge}"
                    ToolTipService.ToolTip="Artifacts">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                        <TextBlock Style="{StaticResource RailCount}" Text="{x:Bind Session.Artifacts.Count, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
