<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Codale.App.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    xmlns:controls="using:Codale.App.Controls"
    xmlns:agents="using:Codale.Core.Agents"
    xmlns:git="using:Codale.Git"
    xmlns:claude="using:Codale.Agents.Claude"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:FileChangeGlyphConverter x:Key="ChangeGlyph" />
        <views:FileNodeGlyphConverter x:Key="NodeGlyph" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:DiffBackgroundConverter x:Key="DiffBackground" />
        <views:DiffForegroundConverter x:Key="DiffForeground" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:NotBoolConverter x:Key="NotBool" />
        <views:GitStatusBrushConverter x:Key="GitStatusBrush" />
        <views:CurrentToFontWeightConverter x:Key="CurrentToFontWeight" />
        <views:IgnoredMuteConverter x:Key="IgnoredMute" />
        <views:TabStateToGlyphConverter x:Key="TabStateToGlyph" />
        <views:TabStateToBrushConverter x:Key="TabStateToBrush" />
        <views:PreviewToFontStyleConverter x:Key="PreviewToItalic" />
        <views:TerminalActivityBrushConverter x:Key="TerminalActivityBrush" />
        <views:TerminalExitSuffixConverter x:Key="TerminalExitSuffix" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />

        <Style x:Key="WelcomeActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!--  A small rounded label, for model / permission / status facts in the
              session panel  -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!--  A pill-shaped quiet button, for the model / effort pickers in the session
              card. Reads as a labelled chip until hovered, then as the button it is.  -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  The session card's model / effort / mode controls: labelled tiles
              rather than bare pills, so each says what it sets as well as its value.  -->
        <Style x:Key="SessionControlButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6,8,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SessionControlCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SessionControlValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Collapsible sidebar section header: a quiet full-width toggle whose
              chevron turns with the state. Replaces the stock Expander, whose boxed
              header and container chrome read as a generic control rather than a
              panel section.  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Slim rounded rows for the panel's lists: the stock ListViewItem's tall
              chrome suits a settings page, not a sidebar.  -->
        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <!--  Zero item padding: the row's own content pads itself so its context-menu hit area fills the row.  -->
        <Style
            x:Key="PanelItemFlush"
            BasedOn="{StaticResource PanelItem}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!--  The shared look of every popup the workspace opens: a floating card,
              rounded, hairline stroke, the theme's shadow. The fill is the solid base
              color, not the card fill: card fills are translucent for layering on
              Mica, and a popup that shows the page through itself reads as broken.  -->
        <Style x:Key="HistoryItem" TargetType="ListViewItem" BasedOn="{StaticResource PanelItemFlush}">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="PickerFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <!--  The endpoint form: wider than a picker, padded by its content, and scrolls
              vertically rather than clipping on a short window.  -->
        <Style x:Key="EndpointFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!--  Heading and footnote of a picker popup, and its accent action button.
              Styles rather than inline setters because the popups are built in code,
              and ThemeResource brushes resolve reliably from XAML, not from C#.  -->
        <Style x:Key="PickerTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="8,4,8,4" />
        </Style>

        <Style x:Key="PickerHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <!--  One choice in a picker flyout: a full-width row rather than a stock
              radio circle. Selection reads as a quiet tinted row with a check on the
              right - the pattern command palettes and modern pickers use.  -->
        <Style x:Key="PickerRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="CheckGlyph"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;"
                                    Opacity="0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Right-click menu for one change in the git list; the handlers read the
              item off the flyout's target, since templates bind to the data, not the VM  -->
        <MenuFlyout x:Key="CommitContextMenu" Opening="OnCommitMenuOpening">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem Click="OnCommitMenuViewChanges" Text="View changes">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnCommitMenuCopySha" Text="Copy commit hash">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnCommitMenuCopyMessage" Text="Copy message" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnCommitMenuNewBranch" Text="Create branch here…" />
            <MenuFlyoutItem Click="OnCommitMenuCheckout" Text="Checkout commit (detached)" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnCommitMenuCherryPick" Text="Cherry-pick" />
            <MenuFlyoutItem Click="OnCommitMenuRevert" Text="Revert commit" />
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="Reset current branch to here">
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="soft" Text="Soft (keep changes staged)" />
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="mixed" Text="Mixed (keep changes unstaged)" />
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="hard" Text="Hard (discard changes)" />
            </MenuFlyoutSubItem>
        </MenuFlyout>

        <MenuFlyout x:Key="ChangeContextMenu" Opening="OnChangeMenuOpening">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem Click="OnMenuViewDiff" Text="View diff">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="StageItem" Click="OnMenuStage" Text="Stage" />
            <MenuFlyoutItem x:Name="UnstageItem" Click="OnMenuUnstage" Text="Unstage" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnMenuDiscard" Text="Discard changes…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnMenuIgnore" Text="Add to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7B3;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="IgnoreFolderItem" Click="OnMenuIgnoreFolder" Text="Add folder to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="IgnoreRootFolderItem" Click="OnMenuIgnoreRootFolder" Text="Add root folder to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!--  What the + button offers: one of each centre area, created on demand  -->
        <MenuFlyout x:Name="NewTabMenuFlyout" Opening="OnNewTabMenuOpening" Placement="Bottom">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem x:Name="ClaudeMenuItem" Click="OnNewTabMenuItemClick" Tag="chat" Text="Chat">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="terminal" Text="Terminal">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE756;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="openfile" Text="Open file…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="newfile" Text="New file">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="search" Text="Search">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <!--  The width lives on the column, not the pivot: the splitter
                      writes pixel widths to this column as it is dragged, and a
                      fixed-width child would leave the content at its old size.  -->
                <ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="200" MaxWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!--  Left: files, git and the chat history, on the window backdrop. A small
                  segmented switch heads the panel, with page actions below the tabs.  -->
            <Grid x:Name="LeftPanel" Padding="8,2,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,6">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                        <RadioButton
                            x:Name="FilesTabButton"
                            Checked="OnLeftTabChecked"
                            Content="Files"
                            GroupName="LeftPanelTabs"
                            IsChecked="True"
                            Style="{StaticResource ShellSegment}"
                            Tag="Files" />
                        <RadioButton
                            x:Name="GitTabButton"
                            Checked="OnLeftTabChecked"
                            GroupName="LeftPanelTabs"
                            Style="{StaticResource ShellSegment}"
                            Tag="Git">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Source Control" />
                                <Border
                                    MinWidth="16"
                                    Height="15"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource KindEditTintBrush}"
                                    CornerRadius="7.5"
                                    Visibility="{x:Bind ViewModel.Git.ChangeCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource KindEditBrush}"
                                        Text="{x:Bind ViewModel.Git.ChangeCount, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="HistoryTabButton"
                            Checked="OnLeftTabChecked"
                            Content="History"
                            GroupName="LeftPanelTabs"
                            Style="{StaticResource ShellSegment}"
                            Tag="History" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                <!--  Files  -->
                <Grid x:Name="FilesPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Project header with explorer actions, below the filter.  -->
                    <Grid
                        x:Name="FilesActions"
                        Grid.Row="1"
                        Margin="4,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Files.Root.Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Files.ProjectPath}">
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open folder in Explorer" Click="OnFilesExploreClick" />
                                    <MenuFlyoutItem Text="Add folder to workspace" Click="OnFilesAddFolderClick" />
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="26" Height="26" Click="OnFilesNewFileClick"
                            Style="{StaticResource ShellIconButton}" ToolTipService.ToolTip="New file">
                            <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                        </Button>
                        <Button Width="26" Height="26" Click="OnFilesNewFolderClick"
                            Style="{StaticResource ShellIconButton}" ToolTipService.ToolTip="New folder">
                            <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                        </Button>
                        <Button
                            Width="26"
                            Height="26"
                            Click="OnFilesRefreshClick"
                            Style="{StaticResource ShellIconButton}"
                            ToolTipService.ToolTip="Refresh">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            Width="26"
                            Height="26"
                            Click="OnFilesCollapseClick"
                            Style="{StaticResource ShellIconButton}"
                            ToolTipService.ToolTip="Collapse all folders">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox
                        Grid.Row="0"
                        Margin="0,0,6,6"
                        PlaceholderText="Filter files…"
                        AutomationProperties.Name="Filter files"
                        Text="{x:Bind ViewModel.Files.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnFileSearchKeyDown" />
                    <TreeView
                        x:Name="FileTree"
                        Grid.Row="2"
                        Visibility="{x:Bind ViewModel.Files.IsSearching, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                        Background="Transparent"
                        CanDragItems="False"
                        Expanding="OnTreeExpanding"
                        ItemInvoked="OnTreeItemInvoked"
                        ItemsSource="{x:Bind ViewModel.Files.Nodes}"
                        RightTapped="OnTreeRightTapped"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileNode">
                                <!--  Root folders (the project and any added ones) start expanded  -->
                                <TreeViewItem IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ItemsSource="{x:Bind Children}">
                                    <StackPanel>
                                        <!--  Ignored files fade; changed names take their git colour  -->
                                        <StackPanel
                                            Opacity="{x:Bind IsIgnored, Mode=OneWay, Converter={StaticResource IgnoredMute}}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                Width="16"
                                                Height="16"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind views:FileIcons.Brush(IsDirectory, Name)}"
                                                Glyph="{x:Bind views:FileIcons.NodeGlyph(IsDirectory, Name)}" />
                                            <!--  The converter answers null for clean nodes so the
                                                  theme's own foreground stands; it must never
                                                  answer UnsetValue - the compiled binding casts
                                                  its result straight to Brush and an UnsetValue
                                                  crashes the layout pass.  -->
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{Binding GitStatus, Mode=OneWay, Converter={StaticResource GitStatusBrush}}"
                                                Text="{x:Bind Name}"
                                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!--  Inline name entry for a new file / folder or a rename  -->
                                            <TextBox
                                                x:Name="NameEditBox"
                                                x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                                Height="24"
                                                MinWidth="120"
                                                MinHeight="24"
                                                MaxWidth="260"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                KeyDown="OnNameEditKeyDown"
                                                Loaded="OnNameEditLoaded"
                                                LostFocus="OnNameEditLostFocus"
                                                Text="{x:Bind EditText, Mode=TwoWay}">
                                                <TextBox.Resources>
                                                    <x:Double x:Key="TextControlThemeMinHeight">22</x:Double>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <ListView
                        x:Name="FileFilterResults"
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.Files.SearchResults}"
                        Visibility="{x:Bind ViewModel.Files.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        IsItemClickEnabled="True"
                        ItemClick="OnFileSearchHitClick"
                        RightTapped="OnTreeRightTapped"
                        SelectionMode="Single"
                        Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileSearchHit">
                                <StackPanel Padding="0,2" ToolTipService.ToolTip="{x:Bind FullPath}">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Directory}" FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Margin="12,8" Text="No matching files"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.Files.HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!--  Git  -->
                    <Grid x:Name="GitPage" Visibility="Collapsed">
                    <!--  Not a repository (or git missing): offer to initialise one  -->
                    <StackPanel
                        Margin="16,40,16,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MaxWidth="260"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="26">
                            <FontIcon FontSize="22" Glyph="&#xE81E;" Opacity="0.75" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="No repository" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="This folder isn't tracked by git yet. Initialise a repository to track changes, commit and branch."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.Git.InitRepositoryCommand}"
                            IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Initialize repository" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Git.Error, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Git.Error, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <Grid
                        RowSpacing="0"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="GitHistoryRow" Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Full branch name above a compact explorer-style toolbar.  -->
                        <Grid Margin="4,0,6,6" RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Button
                                x:Name="BranchButton"
                                Padding="0,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="Switch branch">
                                <Button.Flyout>
                                    <Flyout
                                        FlyoutPresenterStyle="{StaticResource PickerFlyout}"
                                        Opening="OnBranchFlyoutOpening"
                                        Placement="Bottom">
                                        <StackPanel Width="280" Spacing="6">
                                            <StackPanel
                                                Margin="8,4,8,0"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="BRANCHES" />
                                                <Border
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>

                                            <!--  Filter the list; Enter on a lone match switches to it  -->
                                            <TextBox
                                                x:Name="BranchFilterBox"
                                                Margin="4,0"
                                                FontSize="12"
                                                KeyDown="OnBranchFilterKeyDown"
                                                PlaceholderText="Filter branches…"
                                                TextChanged="OnBranchFilterChanged"
                                                Visibility="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />

                                            <!--  A fresh repository has no branch refs until the first commit  -->
                                            <StackPanel
                                                Margin="8,6,8,6"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Glyph="&#xE946;" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="No branches yet. Make a first commit."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <ListView
                                                x:Name="BranchList"
                                                MaxHeight="260"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnBranchClick"
                                                ItemContainerStyle="{StaticResource PanelItem}"
                                                ItemsSource="{x:Bind ViewModel.Git.Branches}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="git:GitBranch">
                                                        <Grid
                                                            Background="Transparent"
                                                            ColumnSpacing="8"
                                                            ToolTipService.ToolTip="{x:Bind Name}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  The checked-out branch gets a green check;
                                                                  the rest a faint branch glyph  -->
                                                            <FontIcon
                                                                FontSize="12"
                                                                Glyph="&#xE73E;"
                                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                            <FontIcon
                                                                FontSize="12"
                                                                Glyph="&#xE81E;"
                                                                Opacity="0.45"
                                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="12"
                                                                FontWeight="{x:Bind IsCurrent, Converter={StaticResource CurrentToFontWeight}}"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Opacity="0.55"
                                                                Text="{x:Bind TrackingSummary}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="{x:Bind TrackingSummary, Converter={StaticResource NullToVisibility}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <!--  New branch: one compact field, Enter or the + creates  -->
                                            <Border
                                                Margin="0,2,0,0"
                                                Padding="8,10,8,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="NewBranchBox"
                                                            FontSize="12"
                                                            KeyDown="OnNewBranchBoxKeyDown"
                                                            PlaceholderText="New branch from HEAD…" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Click="OnCreateBranchClick"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="Create and switch (Enter)">
                                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="12" Glyph="&#xE81E;" Opacity="0.7" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Git.BranchName, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="10"
                                        Glyph="&#xE70D;"
                                        Opacity="0.6" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!--  Changes heading and actions above the commit controls.  -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Changes" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.Git.ChangeCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="0">
                            <Button
                                Width="26"
                                Height="26"
                                Style="{StaticResource ShellIconButton}"
                                Command="{x:Bind ViewModel.Git.PushCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Push to origin">
                                <FontIcon FontSize="12" Glyph="&#xE898;" />
                            </Button>
                            <Button
                                Width="26"
                                Height="26"
                                Style="{StaticResource ShellIconButton}"
                                Command="{x:Bind ViewModel.Git.PullCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Pull (fast-forward)">
                                <FontIcon FontSize="12" Glyph="&#xE896;" />
                            </Button>
                            <!--  Stash: shelve the working changes, and pop them back later  -->
                            <Button
                                Width="26"
                                Height="26"
                                Style="{StaticResource ShellIconButton}"
                                ToolTipService.ToolTip="Stashes">
                                <FontIcon FontSize="12" Glyph="&#xE7B8;" />
                                <Button.Flyout>
                                    <Flyout
                                        FlyoutPresenterStyle="{StaticResource PickerFlyout}"
                                        Opening="OnStashFlyoutOpening"
                                        Placement="Bottom">
                                        <StackPanel Width="300" Spacing="6">
                                            <StackPanel Margin="8,4,8,0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="STASHES" />
                                                <Border
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.Git.Stashes.Count, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Margin="8,2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="Nothing stashed."
                                                Visibility="{x:Bind ViewModel.Git.Stashes.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />

                                            <ListView
                                                MaxHeight="240"
                                                ItemContainerStyle="{StaticResource PanelItem}"
                                                ItemsSource="{x:Bind ViewModel.Git.Stashes}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="git:GitStash">
                                                        <Grid ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind Message}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Text="{x:Bind Message}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Opacity="0.55"
                                                                    Text="{x:Bind Age}" />
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="6,3"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Click="OnPopStashClick"
                                                                ToolTipService.ToolTip="Pop: re-apply and remove">
                                                                <FontIcon FontSize="12" Glyph="&#xE898;" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="2"
                                                                Padding="6,3"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Click="OnDropStashClick"
                                                                ToolTipService.ToolTip="Drop without applying">
                                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <Border
                                                Padding="8,10,8,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnStashChangesClick"
                                                    ToolTipService.ToolTip="Shelve all uncommitted changes, untracked files included. The commit message, if any, names the stash.">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                                                        <TextBlock Text="Stash changes" />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                Width="26"
                                Height="26"
                                Style="{StaticResource ShellIconButton}"
                                Command="{x:Bind ViewModel.Git.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Refresh">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                        </Grid>

                        <!--  git's own complaint when a write fails  -->
                        <Border
                            Grid.Row="1"
                            Margin="2,0,2,6"
                            Padding="10,6"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEA39;" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11"
                                    Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="2,0,2,6" Padding="10,6"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Visibility="{x:Bind ViewModel.Git.IsGeneratingCommitMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.Git.IsGeneratingCommitMessage, Mode=OneWay}" />
                                <TextBlock FontSize="12" Text="Generating commit message…" />
                            </StackPanel>
                        </Border>

                        <!--  Commit: a roomy multi-line message (first line is the subject);
                              Enter breaks lines, Ctrl+Enter commits  -->
                        <StackPanel Grid.Row="2" Margin="2,0,2,10" Spacing="6">
                            <Grid>
                                <TextBox
                                    x:Name="CommitMessageBox"
                                    AcceptsReturn="True"
                                    MaxHeight="130"
                                    MinHeight="32"
                                    IsEnabled="{x:Bind ViewModel.Git.IsGeneratingCommitMessage, Mode=OneWay, Converter={StaticResource NotBool}}"
                                    Padding="8,5"
                                    FontSize="12"
                                    PlaceholderText="Message (Ctrl+Enter to commit)"
                                    ToolTipService.ToolTip="Generate from staged changes (Ctrl+Space)"
                                    Text="{x:Bind ViewModel.Git.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap">
                                    <TextBox.KeyboardAccelerators>
                                        <KeyboardAccelerator
                                            Key="Enter"
                                            Invoked="OnCommitAccelerator"
                                            Modifiers="Control" />
                                        <KeyboardAccelerator Key="Space" Invoked="OnGenerateCommitAccelerator" Modifiers="Control" />
                                    </TextBox.KeyboardAccelerators>
                                </TextBox>

                            </Grid>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Git.CommitCommand}"
                                IsEnabled="{x:Bind CanCommit(ViewModel.Git.IsBusy, ViewModel.Git.IsGeneratingCommitMessage), Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Commit (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE73E;" />
                                    <TextBlock Text="Commit" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Staged: only present while something is in the index; collapsible  -->
                        <StackPanel
                            Grid.Row="3"
                            Margin="0,0,0,6"
                            Visibility="{x:Bind ViewModel.Git.StagedChanges.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <ToggleButton
                                x:Name="GitStagedSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Staged" />
                                    <Border
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Git.StagedChanges.Count, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <ListView
                                MaxHeight="170"
                                IsItemClickEnabled="True"
                                ItemClick="OnGitChangeClick"
                                ItemsSource="{x:Bind ViewModel.Git.StagedChanges}"
                                SelectionMode="None"
                                Visibility="{x:Bind GitStagedSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="git:GitFileStatus">
                                        <!--  Tag marks the row as staged so the shared menu offers Unstage  -->
                                        <Grid
                                            Background="Transparent"
                                            ContextFlyout="{StaticResource ChangeContextMenu}"
                                            Tag="staged"
                                            ToolTipService.ToolTip="{x:Bind Path}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Foreground="{Binding Index, Converter={StaticResource GitStatusBrush}}" Text="{x:Bind DisplayName}" /><Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind PathHintTail}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!--  Changes section header: count + stage all  -->
                        <Grid Grid.Row="4" Margin="6,0,2,2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="60"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Unstaged" />
                            <Border
                                Grid.Column="1"
                                Padding="6,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Git.Changes.Count, Mode=OneWay}" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.Git.StageAllCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Stage all changes">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <!--  Working tree: click opens the diff in the centre; right-click stages  -->
                        <ListView
                            Grid.Row="5"
                            MinHeight="60"
                            IsItemClickEnabled="True"
                            ItemClick="OnGitChangeClick"
                            ItemsSource="{x:Bind ViewModel.Git.Changes}"
                            SelectedItem="{x:Bind ViewModel.Git.SelectedChange, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="26" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="git:GitFileStatus">
                                    <!--  The name's colour stands in for git's XY code. Duplicate names get their directory under.  -->
                                    <Grid
                                        Background="Transparent"
                                        ContextFlyout="{StaticResource ChangeContextMenu}"
                                        ToolTipService.ToolTip="{x:Bind Path}">
<TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis">
                                            <!--  Name first: a narrow row trims the dimmed
                                                  directory off the end, not the name.  -->
                                            <Run Foreground="{Binding DisplayKind, Converter={StaticResource GitStatusBrush}}" Text="{x:Bind DisplayName}" /><Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind PathHintTail}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Grid.Row="6"
                            Margin="0,10,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ToolTipService.ToolTip="Click a commit for its diff">
                            <ToggleButton
                                x:Name="GitHistorySection"
                                Click="OnGitHistorySectionClick"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <TextBlock Text="HISTORY" />
                            </ToggleButton>
                        </Border>

                        <!--  History as a branch graph; click opens the commit's diff  -->
                        <ListView
                            Grid.Row="7"
                            MinHeight="120"
                            IsItemClickEnabled="True"
                            ItemClick="OnGitCommitClick"
                            ItemsSource="{x:Bind ViewModel.Git.Log}"
                            SelectionMode="None"
                            Visibility="{x:Bind GitHistorySection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="git:GitCommit">
                                    <StackPanel
                                        ContextFlyout="{StaticResource CommitContextMenu}"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        ToolTipService.ToolTip="{x:Bind Subject}">
                                        <views:GitGraphCell />
                                        <StackPanel Margin="0,0,0,2">
                                            <TextBlock
                                                FontSize="12"
                                                Text="{x:Bind Subject}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#D4A017"
                                                Text="{x:Bind RefDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind RefDisplay, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock FontSize="11" Opacity="0.55">
                                                <Run Text="{x:Bind ShortSha}" />
                                                <Run Text="&#183;" />
                                                <Run Text="{x:Bind Author}" />
                                                <Run Text="&#183;" />
                                                <Run Text="{x:Bind RelativeDate}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </Grid>

                <!--  History  -->
                    <Grid x:Name="HistoryPage" RowSpacing="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="8,16,8,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Work joins the history once you send a message."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Sessions.Sessions.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />

                        <ListView
                            IsItemClickEnabled="True"
                            ItemClick="OnHistorySessionClick"
                            ItemContainerStyle="{StaticResource HistoryItem}"
                            Padding="0,4,0,8"
                            ItemsSource="{x:Bind ViewModel.Sessions.Sessions, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionListItem">
                                    <Grid Padding="8,7" ColumnSpacing="8" Background="Transparent"
                                          ToolTipService.ToolTip="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="OnRetitleSessionClick" Text="Rename history">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteSessionClick"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="Delete history">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1"
                                                Visibility="{x:Bind IsOpen, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12"
                                                       LineHeight="18" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnSpacing="8" MinHeight="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="10.5" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Run Text="{x:Bind TurnsText}" /><Run Text=" · " />
                                                    <Run Text="{x:Bind UpdatedAt, Converter={StaticResource RelativeTime}}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <ProgressRing Width="12" Height="12" MinWidth="0" MinHeight="0"
                                                                  IsActive="{x:Bind IsOpening, Mode=OneWay}" />
                                                    <TextBlock Text="Loading…" FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsWorking, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                                 Fill="{StaticResource StatusRunningBrush}"
                                                                 views:Pulse.IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                                        <TextBlock Text="Working" FontSize="10"
                                                                   Foreground="{StaticResource StatusRunningBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsOpenIdle, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{StaticResource StatusSuccessBrush}" />
                                                        <TextBlock Text="Open" FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>

            <sizers:GridSplitter
                x:Name="LeftSplitter"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Centre: a rounded card on the backdrop, like the Gallery's content
                  panels. The tab strip starts empty; the + button offers chat,
                  terminal, editor and search; nothing runs until the user asks.  -->
            <Border
                x:Name="CentreCard"
                Grid.Column="2"
                Margin="0,0,6,0"
                Background="{ThemeResource ShellCentreBackgroundBrush}"
                BorderBrush="{ThemeResource ShellCentreStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid x:Name="CentreContent">
                    <!--  Column 0 is the tabs; the splitter and peek column stay at zero
                          width until a running task is opened from the session panel.  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CentreTabsColumn" Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="PeekSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="PeekColumn" Width="0" />
                        <!--  Terminal dock: command blocks dragged to the right edge. Zero width until one is docked.  -->
                        <ColumnDefinition x:Name="DockSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="DockColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <sizers:GridSplitter
                        x:Name="PeekSplitter"
                        Grid.Column="1"
                        Width="8"
                        HorizontalAlignment="Center"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        Visibility="Collapsed" />

                    <views:TaskPeekPane
                        x:Name="PeekPane"
                        Grid.Column="2"
                        CloseRequested="OnPeekCloseRequested"
                        OpenInTabRequested="OnPeekOpenInTabRequested"
                        StopRequested="OnPeekStopRequested"
                        Visibility="Collapsed" />

                    <!--  Side preview: a file, README, plan or diff opened from the chat shows
                          here, beside the conversation, instead of taking over the tab strip.
                          "Open in tab" moves the very same view into a tab of its own.  -->
                    <Grid
                        x:Name="SidePreviewPane"
                        Grid.Column="2"
                        Background="{ThemeResource ShellCentreBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellHairlineBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Padding="12,0,6,0"
                            Background="{ThemeResource ShellCentreBackgroundBrush}"
                            BorderBrush="{ThemeResource ShellHairlineBrush}"
                            BorderThickness="0,0,0,1"
                            Canvas.ZIndex="1"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="SidePreviewGlyph"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap">
                                <Run x:Name="SidePreviewTitle" FontSize="12.5" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run
                                    x:Name="SidePreviewDetail"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <Button
                                Grid.Column="2"
                                Click="OnSidePreviewOpenInTabClick"
                                Style="{StaticResource ShellTextButton}"
                                ToolTipService.ToolTip="Open in its own tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                    <TextBlock Text="Open in tab" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Click="OnSidePreviewCloseClick"
                                Style="{StaticResource ShellIconButton}"
                                ToolTipService.ToolTip="Close preview">
                                <FontIcon FontSize="11" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <Border x:Name="SidePreviewHost" Grid.Row="1" Canvas.ZIndex="0" />
                    </Grid>

                    <!--  Find References: every usage of the word, beside the editor.
                          Shares the peek's column; opening one closes the other.  -->
                    <Grid
                        x:Name="ReferencesPane"
                        Grid.Column="2"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Padding="16,6,6,6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ReferencesTitle"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnReferencesCloseClick"
                                ToolTipService.ToolTip="Close references">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <views:SearchTab x:Name="ReferencesList" Grid.Row="1" />
                    </Grid>

                    <!--  TabView's default style pins VerticalAlignment to Top, which
                          collapses the whole centre area to one tab's content height.  -->
                    <!--  The tab groups: one TabView, or two split side by side or stacked.
                          Drag a tab onto an edge of the content to split; drag the last tab
                          out of a group (or close it) to merge back.  -->
                    <Grid x:Name="TabGroups" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="PrimaryGroup">
                            <TabView
                                x:Name="CentreTabs"
                                AddTabButtonClick="OnCentreAddTabClick"
                                AllowDropTabs="True"
                                Background="Transparent"
                                CanDragTabs="True"
                                CanReorderTabs="True"
                                SelectionChanged="OnCentreTabSelectionChanged"
                                TabCloseRequested="OnCentreTabCloseRequested"
                                TabDragCompleted="OnTabDragCompleted"
                                TabDragStarting="OnTabDragStarting"
                                TabStripDragOver="OnTabStripDragOver"
                                TabStripDrop="OnTabStripDrop"
                                VerticalAlignment="Stretch" />
                            <!--  Shown only while a tab is dragged: covers the tab's content
                                  (not the strip, which keeps its own reorder/drop) so the
                                  editor or terminal underneath cannot swallow the drop.  -->
                            <Grid
                                x:Name="PrimaryDropTarget"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="OnGroupDropTargetDragLeave"
                                DragOver="OnGroupDropTargetDragOver"
                                Drop="OnGroupDropTargetDrop"
                                Visibility="Collapsed">
                                <Border
                                    x:Name="PrimaryDropHint"
                                    Margin="4"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.18" Color="{ThemeResource SystemAccentColor}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>

                        <sizers:GridSplitter
                            x:Name="TabGroupSplitter"
                            ResizeBehavior="PreviousAndNext"
                            Visibility="Collapsed" />

                        <Grid x:Name="SecondaryGroup" Visibility="Collapsed">
                            <TabView
                                x:Name="SplitTabs"
                                AddTabButtonClick="OnCentreAddTabClick"
                                AllowDropTabs="True"
                                Background="Transparent"
                                CanDragTabs="True"
                                CanReorderTabs="True"
                                SelectionChanged="OnCentreTabSelectionChanged"
                                TabCloseRequested="OnCentreTabCloseRequested"
                                TabDragCompleted="OnTabDragCompleted"
                                TabDragStarting="OnTabDragStarting"
                                TabStripDragOver="OnTabStripDragOver"
                                TabStripDrop="OnTabStripDrop"
                                VerticalAlignment="Stretch" />
                            <!--  Shown only while a tab is dragged: covers the tab's content
                                  (not the strip, which keeps its own reorder/drop) so the
                                  editor or terminal underneath cannot swallow the drop.  -->
                            <Grid
                                x:Name="SecondaryDropTarget"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="OnGroupDropTargetDragLeave"
                                DragOver="OnGroupDropTargetDragOver"
                                Drop="OnGroupDropTargetDrop"
                                Visibility="Collapsed">
                                <Border
                                    x:Name="SecondaryDropHint"
                                    Margin="4"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.18" Color="{ThemeResource SystemAccentColor}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                <!-- A useful home for an idle workspace; chat stays one click away. -->
                <ScrollViewer x:Name="EmptyState" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center">
                    <StackPanel MaxWidth="560" Margin="32,36" Spacing="24">
                        <StackPanel Spacing="14">

                            <StackPanel Spacing="8">
                                <TextBlock Text="What will you build?" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Bring an idea, work through a problem, or pick up where you left off."
                                           FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Click="OnNewTabMenuItemClick" Tag="chat" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,18"
                                CornerRadius="12" AutomationProperties.Name="Start a chat">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8BD;" FontSize="24" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="ClaudeEmptyLabel" Text="Start a chat" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Build, explore, or fix something with your agent." FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="16" />
                            </Grid>
                        </Button>
                        <StackPanel Spacing="12">
                            <TextBlock Text="YOUR WORKSPACE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="120"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Click="OnNewTabMenuItemClick" Tag="openfile"
                                        Style="{StaticResource WelcomeActionButton}" AutomationProperties.Name="Open a file">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8E5;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Open a file" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Jump into your code" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="1" Click="OnNewTabMenuItemClick" Tag="terminal"
                                        Style="{StaticResource WelcomeActionButton}" AutomationProperties.Name="Open terminal">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE756;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Open terminal" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Run commands here" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="0" Click="OnNewTabMenuItemClick" Tag="newfile"
                                        Style="{StaticResource WelcomeActionButton}" AutomationProperties.Name="New file">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="New file" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Start with a blank canvas" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Click="OnNewTabMenuItemClick" Tag="search"
                                        Style="{StaticResource WelcomeActionButton}" AutomationProperties.Name="Search project">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Search project" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Find code and answers" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="PREVIOUS CONVERSATIONS" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="120" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button HorizontalAlignment="Right" Padding="7" MinWidth="28" MinHeight="28"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{x:Bind ViewModel.Sessions.RefreshCommand}"
                                        IsEnabled="{x:Bind ViewModel.Sessions.CanOpen, Mode=OneWay}"
                                        AutomationProperties.Name="Refresh conversations" ToolTipService.ToolTip="Refresh conversations">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                </Button>
                            </Grid>
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ViewModel.Sessions.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Your conversations will appear here after you send your first message."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.Sessions.Sessions.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.Sessions.OpenError, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind ViewModel.Sessions.OpenError.Length, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                            <ListView MaxHeight="240" IsItemClickEnabled="{x:Bind ViewModel.Sessions.CanOpen, Mode=OneWay}" ItemClick="OnHistorySessionClick"
                                      SelectionMode="None" ItemContainerStyle="{StaticResource PanelItemFlush}"
                                      ItemsSource="{x:Bind ViewModel.Sessions.Sessions, Mode=OneWay}"
                                      AutomationProperties.Name="Previous conversations"
                                      Visibility="{x:Bind ViewModel.Sessions.Sessions.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionListItem">
                                        <Grid Padding="12,10" ColumnSpacing="12" Background="Transparent"
                                              ToolTipService.ToolTip="{x:Bind Summary.FirstPrompt}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8BD;" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Run Text="{x:Bind TurnsText}" /><Run Text=" · " />
                                                    <Run Text="{x:Bind UpdatedAt, Converter={StaticResource RelativeTime}}" />
                                                </TextBlock>
                                                <TextBlock Text="Loading conversation…" FontSize="11"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <ProgressRing Grid.Column="2" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                                          IsActive="{x:Bind IsOpening, Mode=OneWay}"
                                                          Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                    <!--  The terminal dock: a command block dragged to the right edge runs here, beside
                          whatever tab is in front - the whole height, or the top or bottom half.  -->
                    <sizers:GridSplitter
                        x:Name="DockSplitter"
                        Grid.Column="3"
                        Width="8"
                        HorizontalAlignment="Center"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        Visibility="Collapsed" />
                    <Grid
                        x:Name="DockPane"
                        Grid.Column="4"
                        Padding="4,8,4,8"
                        Background="#0C0C0C"
                        RequestedTheme="Dark"
                        BorderBrush="{ThemeResource ShellHairlineBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="DockTopRow" Height="*" />
                            <RowDefinition x:Name="DockSplitterRow" Height="0" />
                            <RowDefinition x:Name="DockBottomRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Border x:Name="DockTopHost" />
                        <sizers:GridSplitter
                            x:Name="DockRowSplitter"
                            Grid.Row="1"
                            Height="8"
                            VerticalAlignment="Center"
                            ResizeBehavior="PreviousAndNext"
                            ResizeDirection="Rows"
                            Visibility="Collapsed" />
                        <Border x:Name="DockBottomHost" Grid.Row="2" />
                    </Grid>

                    <!--  Shown only while a command block is dragged: where it would dock on the right.  -->
                    <Grid
                        x:Name="DockDropTarget"
                        Grid.ColumnSpan="5"
                        AllowDrop="True"
                        Background="Transparent"
                        Canvas.ZIndex="10"
                        DragLeave="OnDockDropTargetDragLeave"
                        DragOver="OnDockDropTargetDragOver"
                        Drop="OnDockDropTargetDrop"
                        Visibility="Collapsed">
                        <Border
                            x:Name="DockDropHint"
                            Margin="4"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.18" Color="{ThemeResource SystemAccentColor}" />
                            </Border.Background>
                            <TextBlock
                                x:Name="DockDropCaption"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Status bar  -->
        <StackPanel Grid.Row="1">
        <Border
            Margin="6,0,6,0"
            Padding="2,0,2,0"
            MinHeight="28"
            Background="{ThemeResource ShellStatusBarBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <!--  Flat status entries: transparent at rest, a soft fill on hover/press  -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

                    <Style x:Key="StatusChip" TargetType="Border">
                        <Setter Property="Padding" Value="7,1" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="CornerRadius" Value="5" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="StatusButton" TargetType="Button">
                        <Setter Property="Padding" Value="7,1" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="CornerRadius" Value="5" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="StatusDivider" TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="Margin" Value="6,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Style>
                </Grid.Resources>

                <!--  Left: the repository and the file language. Each entry is a quiet chip; the
                      interactive ones light up on hover, and thin dividers separate the groups.  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                    <!--  Git: branch, then modified / created / deleted counts  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource StatusChip}" ToolTipService.ToolTip="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon VerticalAlignment="Center" Margin="0,1.3,0,0" FontSize="11" Glyph="&#xE81E;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Git.BranchName, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusChip}" ToolTipService.ToolTip="{x:Bind ViewModel.Git.StatusDetail, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    ToolTipService.ToolTip="Modified">
                                    <Run Text="~" /><Run Text="{x:Bind ViewModel.Git.ModifiedCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    ToolTipService.ToolTip="Created (added or untracked)">
                                    <Run Text="+" /><Run Text="{x:Bind ViewModel.Git.CreatedCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    ToolTipService.ToolTip="Deleted">
                                    <Run Text="−" /><Run Text="{x:Bind ViewModel.Git.DeletedCount, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  No repository: say so, and offer to create one  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Style="{StaticResource StatusChip}" ToolTipService.ToolTip="This folder is not a Git repository">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon VerticalAlignment="Center" Margin="0,1.3,0,0" FontSize="11" Glyph="&#xE81E;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="No repository" />
                            </StackPanel>
                        </Border>
                        <Button
                            Style="{StaticResource StatusButton}"
                            Command="{x:Bind ViewModel.Git.InitRepositoryCommand}"
                            ToolTipService.ToolTip="Run git init in this folder to start a repository">
                            <TextBlock FontSize="11.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Initialize" />
                        </Button>
                    </StackPanel>

                    <!--  Language of the file in front: shows what colours it, and lets the user override that  -->
                    <StackPanel x:Name="LanguageHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Style="{StaticResource StatusDivider}" />
                        <Button
                            x:Name="LanguageButton"
                            Style="{StaticResource StatusButton}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Language mode: change how this file is coloured">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                            </Button.Resources>
                            <Button.Flyout>
                                <Flyout
                                    x:Name="LanguageFlyout"
                                    FlyoutPresenterStyle="{StaticResource EndpointFlyout}"
                                    Opening="OnLanguageFlyoutOpening"
                                    Placement="TopEdgeAlignedLeft">
                                    <controls:LanguagePicker x:Name="LanguagePickerControl" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon VerticalAlignment="Center" Margin="0,0.7,0,0" FontSize="11" Glyph="&#xE943;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="LanguageText"
                                    VerticalAlignment="Center"
                                    Text="No File"
                                    FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Right: the indexer, then tool hosts  -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <!--  Indexer: what the project index holds for this workspace, or that it is scanning  -->
                <Border Style="{StaticResource StatusChip}" ToolTipService.ToolTip="{x:Bind ViewModel.Health.IndexTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon VerticalAlignment="Center" Margin="0,0.7,0,0" FontSize="11" Glyph="&#xE721;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Health.IndexText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                    <!--  Built-in MCP servers: a browser to verify work in, and desktop control  -->
                    <!--  Opened from the title bar's Browser button; this host only owns the flyout  -->
                    <Border x:Name="McpToolsHost" Width="0" Height="0" Margin="-16,0,0,0">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout FlyoutPresenterStyle="{StaticResource EndpointFlyout}" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Padding="16,14,16,14" Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Agent tools" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Changes apply on your next chat message" />
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Glyph="&#xE774;"
                                                Opacity="0.8" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Browser" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.McpTools.BrowserNote}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                Grid.Column="2"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                IsEnabled="{x:Bind ViewModel.McpTools.BrowserAvailable}"
                                                IsOn="{x:Bind ViewModel.McpTools.BrowserEnabled, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                        </Grid>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.McpTools.OpenBrowserCommand}"
                                            Content="Open browser"
                                            IsEnabled="{x:Bind ViewModel.McpTools.BrowserAvailable}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind ViewModel.McpTools.OpenBrowserError, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.McpTools.HasOpenBrowserError, Mode=OneWay}" />

                                        <!--  Localhost static server: the main part serves the project, the arrow picks any folder  -->
                                        <SplitButton
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnServeProjectSplitClick"
                                            ToolTipService.ToolTip="Host a folder on http://localhost until you stop it or close Codale">
                                            <TextBlock Text="Serve project folder" />
                                            <SplitButton.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Click="OnServeProjectFolderClick" Text="Serve project folder">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="OnServeOtherFolderClick" Text="Choose a folder to serve…">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </SplitButton.Flyout>
                                        </SplitButton>
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind ViewModel.McpTools.ServeError, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.McpTools.HasServeError, Mode=OneWay}" />
                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.McpTools.ServedFolders}"
                                            Visibility="{x:Bind ViewModel.McpTools.HasServedFolders, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ServedFolderItem">
                                                    <Grid Padding="0,2,0,2" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            Margin="2,0,6,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Glyph="&#xE968;"
                                                            Opacity="0.8" />
                                                        <HyperlinkButton
                                                            Grid.Column="1"
                                                            Padding="4,2,4,2"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Click="OnOpenServedClick"
                                                            ToolTipService.ToolTip="{x:Bind Folder}">
                                                            <StackPanel Spacing="0">
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Text="{x:Bind Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </HyperlinkButton>
                                                        <Button
                                                            Grid.Column="2"
                                                            Padding="6"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnCopyServedClick"
                                                            ToolTipService.ToolTip="Copy URL">
                                                            <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                                        </Button>
                                                        <Button
                                                            Grid.Column="3"
                                                            Padding="6"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnStopServedClick"
                                                            ToolTipService.ToolTip="Stop serving">
                                                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Glyph="&#xE7F4;"
                                            Opacity="0.8" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Desktop" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.McpTools.ComputerNote}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.McpTools.ComputerAvailable}"
                                            IsOn="{x:Bind ViewModel.McpTools.ComputerEnabled, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!--  Android phone or emulator over adb  -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Glyph="&#xE8EA;"
                                            Opacity="0.8" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Android" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.McpTools.PhoneNote}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.McpTools.PhoneAvailable}"
                                            IsOn="{x:Bind ViewModel.McpTools.PhoneEnabled, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</Page>
