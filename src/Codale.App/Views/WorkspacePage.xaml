<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Codale.App.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Codale.App.ViewModels"
    xmlns:views="using:Codale.App.Views"
    xmlns:controls="using:Codale.App.Controls"
    xmlns:agents="using:Codale.Core.Agents"
    xmlns:git="using:Codale.Git"
    xmlns:claude="using:Codale.Agents.Claude"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:UsageToBrushConverter x:Key="UsageToBrush" />
        <views:FileChangeGlyphConverter x:Key="ChangeGlyph" />
        <views:FileNodeGlyphConverter x:Key="NodeGlyph" />
        <views:TodoGlyphConverter x:Key="TodoGlyph" />
        <views:TodoBrushConverter x:Key="TodoBrush" />
        <views:DiffBackgroundConverter x:Key="DiffBackground" />
        <views:DiffForegroundConverter x:Key="DiffForeground" />
        <views:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:NotBoolConverter x:Key="NotBool" />
        <views:GitStatusBrushConverter x:Key="GitStatusBrush" />
        <views:CurrentToFontWeightConverter x:Key="CurrentToFontWeight" />
        <views:IgnoredMuteConverter x:Key="IgnoredMute" />
        <views:TabStateToGlyphConverter x:Key="TabStateToGlyph" />
        <views:TabStateToBrushConverter x:Key="TabStateToBrush" />
        <views:PreviewToFontStyleConverter x:Key="PreviewToItalic" />
        <views:TerminalActivityBrushConverter x:Key="TerminalActivityBrush" />
        <views:TerminalExitSuffixConverter x:Key="TerminalExitSuffix" />
        <views:RelativeTimeConverter x:Key="RelativeTime" />
        <views:NullableBoolToVisibilityConverter x:Key="NullableBoolToVisibility" />
        <views:FileChangeBrushConverter x:Key="FileChangeBrush" />
        <views:ArtifactStatusBrushConverter x:Key="ArtifactStatusBrush" />
        <views:TodoTextBrushConverter x:Key="TodoTextBrush" />

        <!--  A small rounded label, for model / permission / status facts in the
              session panel  -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!--  A pill-shaped quiet button, for the model / effort pickers in the session
              card. Reads as a labelled chip until hovered, then as the button it is.  -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  The session card's model / effort / mode controls: labelled tiles
              rather than bare pills, so each says what it sets as well as its value.  -->
        <Style x:Key="SessionControlButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6,8,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SessionControlCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SessionControlValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Collapsible sidebar section header: a quiet full-width toggle whose
              chevron turns with the state. Replaces the stock Expander, whose boxed
              header and container chrome read as a generic control rather than a
              panel section.  -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="HeaderContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Chevron.(UIElement.RenderTransform).(RotateTransform.Angle)" Value="-90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    x:Name="Chevron"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Slim rounded rows for the panel's lists: the stock ListViewItem's tall
              chrome suits a settings page, not a sidebar.  -->
        <Style x:Key="PanelItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <!--  Zero item padding: the row's own content pads itself so its context-menu hit area fills the row.  -->
        <Style
            x:Key="PanelItemFlush"
            BasedOn="{StaticResource PanelItem}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!--  The shared look of every popup the workspace opens: a floating card,
              rounded, hairline stroke, the theme's shadow. The fill is the solid base
              color, not the card fill: card fills are translucent for layering on
              Mica, and a popup that shows the page through itself reads as broken.  -->
        <Style x:Key="PickerFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <!--  The endpoint form: wider than a picker, padded by its content, and scrolls
              vertically rather than clipping on a short window.  -->
        <Style x:Key="EndpointFlyout" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!--  Heading and footnote of a picker popup, and its accent action button.
              Styles rather than inline setters because the popups are built in code,
              and ThemeResource brushes resolve reliably from XAML, not from C#.  -->
        <Style x:Key="PickerTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="8,4,8,4" />
        </Style>

        <Style x:Key="PickerHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <!--  One choice in a picker flyout: a full-width row rather than a stock
              radio circle. Selection reads as a quiet tinted row with a check on the
              right - the pattern command palettes and modern pickers use.  -->
        <Style x:Key="PickerRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="CheckGlyph"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;"
                                    Opacity="0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Right-click menu for one change in the git list; the handlers read the
              item off the flyout's target, since templates bind to the data, not the VM  -->
        <MenuFlyout x:Key="CommitContextMenu" Opening="OnCommitMenuOpening">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem Click="OnCommitMenuViewChanges" Text="View changes">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnCommitMenuCopySha" Text="Copy commit hash">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnCommitMenuCopyMessage" Text="Copy message" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnCommitMenuNewBranch" Text="Create branch here…" />
            <MenuFlyoutItem Click="OnCommitMenuCheckout" Text="Checkout commit (detached)" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnCommitMenuCherryPick" Text="Cherry-pick" />
            <MenuFlyoutItem Click="OnCommitMenuRevert" Text="Revert commit" />
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="Reset current branch to here">
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="soft" Text="Soft (keep changes staged)" />
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="mixed" Text="Mixed (keep changes unstaged)" />
                <MenuFlyoutItem Click="OnCommitMenuReset" Tag="hard" Text="Hard (discard changes)" />
            </MenuFlyoutSubItem>
        </MenuFlyout>

        <MenuFlyout x:Key="ChangeContextMenu" Opening="OnChangeMenuOpening">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem Click="OnMenuViewDiff" Text="View diff">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="StageItem" Click="OnMenuStage" Text="Stage" />
            <MenuFlyoutItem x:Name="UnstageItem" Click="OnMenuUnstage" Text="Unstage" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnMenuDiscard" Text="Discard changes…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnMenuIgnore" Text="Add to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7B3;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="IgnoreFolderItem" Click="OnMenuIgnoreFolder" Text="Add folder to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="IgnoreRootFolderItem" Click="OnMenuIgnoreRootFolder" Text="Add root folder to .gitignore">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!--  What the + button offers: one of each centre area, created on demand  -->
        <MenuFlyout x:Name="NewTabMenuFlyout" Opening="OnNewTabMenuOpening" Placement="Bottom">
            <MenuFlyout.MenuFlyoutPresenterStyle>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem x:Name="ClaudeMenuItem" Click="OnNewTabMenuItemClick" Tag="claude" Text="Claude chat">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="CodexMenuItem" Click="OnNewTabMenuItemClick" Tag="codex" Text="Codex chat">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="terminal" Text="Terminal">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE756;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="openfile" Text="Open file…">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="newfile" Text="New file">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnNewTabMenuItemClick" Tag="search" Text="Search">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <!--  The width lives on the column, not the pivot: the splitter
                      writes pixel widths to this column as it is dragged, and a
                      fixed-width child would leave the content at its old size.  -->
                <ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="200" MaxWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!--  Left: files and git. The only area that keeps the Mica backdrop.  -->
            <Pivot
                x:Name="LeftPanel"
                Padding="8,0,4,0">
                <PivotItem Header="Files">
                    <TreeView
                        x:Name="FileTree"
                        CanDragItems="False"
                        Expanding="OnTreeExpanding"
                        ItemInvoked="OnTreeItemInvoked"
                        ItemsSource="{x:Bind ViewModel.Files.Nodes}"
                        RightTapped="OnTreeRightTapped"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileNode">
                                <!--  Root folders (the project and any added ones) start expanded  -->
                                <TreeViewItem IsExpanded="{x:Bind IsRootEntry}" ItemsSource="{x:Bind Children}">
                                    <StackPanel>
                                        <!--  Ignored files fade; changed names take their git colour  -->
                                        <StackPanel
                                            Opacity="{x:Bind IsIgnored, Mode=OneWay, Converter={StaticResource IgnoredMute}}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{x:Bind views:FileIcons.Brush(IsDirectory, Name)}"
                                                Glyph="&#xE8B7;"
                                                Visibility="{x:Bind views:FileIcons.FolderVisibility(IsDirectory)}" />
                                            <!--  Document badge: coloured page with a folded corner, extension inside  -->
                                            <Grid
                                                Width="14"
                                                Height="16"
                                                Visibility="{x:Bind views:FileIcons.FileVisibility(IsDirectory)}">
                                                <Viewbox Stretch="Fill">
                                                    <Grid Width="18" Height="22">
                                                        <Path
                                                            Data="M0,2 Q0,0 2,0 L11,0 L18,7 L18,20 Q18,22 16,22 L2,22 Q0,22 0,20 Z"
                                                            Fill="{x:Bind views:FileIcons.Brush(IsDirectory, Name)}" />
                                                        <Path Data="M11,0 L18,7 L13,7 Q11,7 11,5 Z" Fill="#66FFFFFF" />
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{x:Bind views:FileIcons.LabelSize(IsDirectory, Name)}"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{x:Bind views:FileIcons.Label(IsDirectory, Name)}" />
                                            </Grid>
                                            <!--  The converter answers null for clean nodes so the
                                                  theme's own foreground stands; it must never
                                                  answer UnsetValue - the compiled binding casts
                                                  its result straight to Brush and an UnsetValue
                                                  crashes the layout pass.  -->
                                            <TextBlock
                                                Foreground="{Binding GitStatus, Mode=OneWay, Converter={StaticResource GitStatusBrush}}"
                                                Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </PivotItem>

                <PivotItem Header="Git">
                    <Grid>
                    <!--  Not a repository (or git missing): offer to initialise one  -->
                    <StackPanel
                        Margin="16,40,16,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MaxWidth="260"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="26">
                            <FontIcon FontSize="22" Glyph="&#xE81E;" Opacity="0.75" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="No repository" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="This folder isn't tracked by git yet. Initialise a repository to track changes, commit and branch."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.Git.InitRepositoryCommand}"
                            IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Initialize repository" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Git.Error, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Git.Error, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <Grid
                        RowSpacing="0"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="GitHistoryRow" Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header: branch switcher on the left, sync actions on the right  -->
                        <Grid Margin="2,0,2,6" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button
                                x:Name="BranchButton"
                                Padding="6,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="Switch branch">
                                <Button.Flyout>
                                    <Flyout
                                        FlyoutPresenterStyle="{StaticResource PickerFlyout}"
                                        Opening="OnBranchFlyoutOpening"
                                        Placement="Bottom">
                                        <StackPanel Width="280" Spacing="6">
                                            <StackPanel
                                                Margin="8,4,8,0"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="BRANCHES" />
                                                <Border
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>

                                            <!--  Filter the list; Enter on a lone match switches to it  -->
                                            <TextBox
                                                x:Name="BranchFilterBox"
                                                Margin="4,0"
                                                FontSize="12"
                                                KeyDown="OnBranchFilterKeyDown"
                                                PlaceholderText="Filter branches…"
                                                TextChanged="OnBranchFilterChanged"
                                                Visibility="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />

                                            <!--  A fresh repository has no branch refs until the first commit  -->
                                            <StackPanel
                                                Margin="8,6,8,6"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind ViewModel.Git.Branches.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Glyph="&#xE946;" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="No branches yet. Make a first commit."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <ListView
                                                x:Name="BranchList"
                                                MaxHeight="260"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnBranchClick"
                                                ItemContainerStyle="{StaticResource PanelItem}"
                                                ItemsSource="{x:Bind ViewModel.Git.Branches}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="git:GitBranch">
                                                        <Grid
                                                            Background="Transparent"
                                                            ColumnSpacing="8"
                                                            ToolTipService.ToolTip="{x:Bind Name}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  The checked-out branch gets a green check;
                                                                  the rest a faint branch glyph  -->
                                                            <FontIcon
                                                                FontSize="12"
                                                                Glyph="&#xE73E;"
                                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                            <FontIcon
                                                                FontSize="12"
                                                                Glyph="&#xE81E;"
                                                                Opacity="0.45"
                                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="12"
                                                                FontWeight="{x:Bind IsCurrent, Converter={StaticResource CurrentToFontWeight}}"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Opacity="0.55"
                                                                Text="{x:Bind TrackingSummary}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="{x:Bind TrackingSummary, Converter={StaticResource NullToVisibility}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <!--  New branch: one compact field, Enter or the + creates  -->
                                            <Border
                                                Margin="0,2,0,0"
                                                Padding="8,10,8,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="NewBranchBox"
                                                            FontSize="12"
                                                            KeyDown="OnNewBranchBoxKeyDown"
                                                            PlaceholderText="New branch from HEAD…" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Click="OnCreateBranchClick"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="Create and switch (Enter)">
                                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="12" Glyph="&#xE81E;" Opacity="0.7" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Git.BranchName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="10"
                                        Glyph="&#xE70D;"
                                        Opacity="0.6" />
                                </Grid>
                            </Button>

                            <TextBlock
                                Margin="30,-2,0,0"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <!--  Sync with the remote, re-read  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="0">
                            <Button
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.Git.PushCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Push to origin">
                                <FontIcon FontSize="13" Glyph="&#xE898;" />
                            </Button>
                            <Button
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.Git.PullCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Pull (fast-forward)">
                                <FontIcon FontSize="13" Glyph="&#xE896;" />
                            </Button>
                            <!--  Stash: shelve the working changes, and pop them back later  -->
                            <Button
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="Stashes">
                                <FontIcon FontSize="13" Glyph="&#xE7B8;" />
                                <Button.Flyout>
                                    <Flyout
                                        FlyoutPresenterStyle="{StaticResource PickerFlyout}"
                                        Opening="OnStashFlyoutOpening"
                                        Placement="Bottom">
                                        <StackPanel Width="300" Spacing="6">
                                            <StackPanel Margin="8,4,8,0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="STASHES" />
                                                <Border
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.Git.Stashes.Count, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Margin="8,2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="Nothing stashed."
                                                Visibility="{x:Bind ViewModel.Git.Stashes.Count, Mode=OneWay, Converter={StaticResource CountToInverseVisibility}}" />

                                            <ListView
                                                MaxHeight="240"
                                                ItemContainerStyle="{StaticResource PanelItem}"
                                                ItemsSource="{x:Bind ViewModel.Git.Stashes}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="git:GitStash">
                                                        <Grid ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind Message}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Text="{x:Bind Message}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Opacity="0.55"
                                                                    Text="{x:Bind Age}" />
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="6,3"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Click="OnPopStashClick"
                                                                ToolTipService.ToolTip="Pop: re-apply and remove">
                                                                <FontIcon FontSize="12" Glyph="&#xE898;" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="2"
                                                                Padding="6,3"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Click="OnDropStashClick"
                                                                ToolTipService.ToolTip="Drop without applying">
                                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <Border
                                                Padding="8,10,8,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnStashChangesClick"
                                                    ToolTipService.ToolTip="Shelve all uncommitted changes, untracked files included. The commit message, if any, names the stash.">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                                                        <TextBlock Text="Stash changes" />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.Git.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Refresh">
                                <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                        </Grid>

                        <!--  git's own complaint when a write fails  -->
                        <Border
                            Grid.Row="1"
                            Margin="2,0,2,6"
                            Padding="10,6"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind ViewModel.Git.ActionError, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEA39;" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11"
                                    Text="{x:Bind ViewModel.Git.ActionError, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!--  Commit: a roomy multi-line message (first line is the subject);
                              Enter breaks lines, Ctrl+Enter commits  -->
                        <StackPanel Grid.Row="2" Margin="2,0,2,10" Spacing="6">
                            <Grid>
                                <TextBox
                                    x:Name="CommitMessageBox"
                                    AcceptsReturn="True"
                                    MaxHeight="130"
                                    MinHeight="60"
                                    Padding="10,6,34,6"
                                    PlaceholderText="Commit message"
                                    Text="{x:Bind ViewModel.Git.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap">
                                    <TextBox.KeyboardAccelerators>
                                        <KeyboardAccelerator
                                            Key="Enter"
                                            Invoked="OnCommitAccelerator"
                                            Modifiers="Control" />
                                    </TextBox.KeyboardAccelerators>
                                </TextBox>

                                <!--  The local model writes the subject from the working-tree
                                      diff; icon only, docked in the field's corner like the
                                      generators in editors. A ring stands in while it runs -
                                      the first click may load the model, which takes a while.  -->
                                <Button
                                    Width="26"
                                    Height="26"
                                    Margin="0,4,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.Git.GenerateCommitMessageCommand}"
                                    IsEnabled="{x:Bind ViewModel.Git.IsGeneratingMessage, Mode=OneWay, Converter={StaticResource NotBool}}"
                                    ToolTipService.ToolTip="Generate commit message with the local model">
                                    <Grid>
                                        <FontIcon
                                            FontSize="13"
                                            Glyph="&#xEB78;"
                                            Visibility="{x:Bind ViewModel.Git.IsGeneratingMessage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{x:Bind ViewModel.Git.IsGeneratingMessage, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.Git.IsGeneratingMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Git.CommitCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Commit (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE73E;" />
                                    <TextBlock Text="Commit" />
                                    <TextBlock Opacity="0.75" Text="{x:Bind ViewModel.Git.StagedSummary, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Staged: only present while something is in the index; collapsible  -->
                        <StackPanel
                            Grid.Row="3"
                            Margin="0,0,0,6"
                            Visibility="{x:Bind ViewModel.Git.StagedChanges.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                            <ToggleButton
                                x:Name="GitStagedSection"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="STAGED" />
                                    <Border
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Git.StagedChanges.Count, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <ListView
                                MaxHeight="170"
                                IsItemClickEnabled="True"
                                ItemClick="OnGitChangeClick"
                                ItemsSource="{x:Bind ViewModel.Git.StagedChanges}"
                                SelectionMode="None"
                                Visibility="{x:Bind GitStagedSection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="git:GitFileStatus">
                                        <!--  Tag marks the row as staged so the shared menu offers Unstage  -->
                                        <Grid
                                            Background="Transparent"
                                            ContextFlyout="{StaticResource ChangeContextMenu}"
                                            Tag="staged"
                                            ToolTipService.ToolTip="{x:Bind Path}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Foreground="{Binding Index, Converter={StaticResource GitStatusBrush}}" Text="{x:Bind DisplayName}" /><Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind PathHintTail}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!--  Changes section header: count + stage all  -->
                        <Grid Grid.Row="4" Margin="6,0,2,2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="60"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="CHANGES" />
                            <Border
                                Grid.Column="1"
                                Padding="6,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Git.Changes.Count, Mode=OneWay}" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.Git.StageAllCommand}"
                                IsEnabled="{x:Bind ViewModel.Git.IsBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                                ToolTipService.ToolTip="Stage all changes">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <!--  Working tree: click opens the diff in the centre; right-click stages  -->
                        <ListView
                            Grid.Row="5"
                            MinHeight="60"
                            IsItemClickEnabled="True"
                            ItemClick="OnGitChangeClick"
                            ItemsSource="{x:Bind ViewModel.Git.Changes}"
                            SelectedItem="{x:Bind ViewModel.Git.SelectedChange, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="26" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="git:GitFileStatus">
                                    <!--  The name's colour stands in for git's XY code. Duplicate names get their directory under.  -->
                                    <Grid
                                        Background="Transparent"
                                        ContextFlyout="{StaticResource ChangeContextMenu}"
                                        ToolTipService.ToolTip="{x:Bind Path}">
<TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis">
                                            <!--  Name first: a narrow row trims the dimmed
                                                  directory off the end, not the name.  -->
                                            <Run Foreground="{Binding DisplayKind, Converter={StaticResource GitStatusBrush}}" Text="{x:Bind DisplayName}" /><Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind PathHintTail}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Grid.Row="6"
                            Margin="0,10,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ToolTipService.ToolTip="Click a commit for its diff">
                            <ToggleButton
                                x:Name="GitHistorySection"
                                Click="OnGitHistorySectionClick"
                                IsChecked="True"
                                Style="{StaticResource SectionHeader}">
                                <TextBlock Text="HISTORY" />
                            </ToggleButton>
                        </Border>

                        <!--  History as a branch graph; click opens the commit's diff  -->
                        <ListView
                            Grid.Row="7"
                            MinHeight="120"
                            IsItemClickEnabled="True"
                            ItemClick="OnGitCommitClick"
                            ItemsSource="{x:Bind ViewModel.Git.Log}"
                            SelectionMode="None"
                            Visibility="{x:Bind GitHistorySection.IsChecked, Mode=OneWay, Converter={StaticResource NullableBoolToVisibility}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="git:GitCommit">
                                    <StackPanel
                                        ContextFlyout="{StaticResource CommitContextMenu}"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        ToolTipService.ToolTip="{x:Bind Subject}">
                                        <views:GitGraphCell />
                                        <StackPanel Margin="0,0,0,2">
                                            <TextBlock
                                                FontSize="12"
                                                Text="{x:Bind Subject}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#D4A017"
                                                Text="{x:Bind RefDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind RefDisplay, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock FontSize="11" Opacity="0.55">
                                                <Run Text="{x:Bind ShortSha}" />
                                                <Run Text="&#183;" />
                                                <Run Text="{x:Bind Author}" />
                                                <Run Text="&#183;" />
                                                <Run Text="{x:Bind RelativeDate}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </Grid>
                </PivotItem>
            </Pivot>

            <sizers:GridSplitter
                x:Name="LeftSplitter"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Centre: a rounded card on the backdrop, like the Gallery's content
                  panels. The tab strip starts empty; the + button offers chat,
                  terminal, editor and search; nothing runs until the user asks.  -->
            <Border
                x:Name="CentreCard"
                Grid.Column="2"
                Background="{ThemeResource ShellCentreBackgroundBrush}"
                BorderBrush="{ThemeResource ShellCentreStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid x:Name="CentreContent">
                    <!--  Column 0 is the tabs; the splitter and peek column stay at zero
                          width until a running task is opened from the session panel.  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CentreTabsColumn" Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="PeekSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="PeekColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <sizers:GridSplitter
                        x:Name="PeekSplitter"
                        Grid.Column="1"
                        Width="8"
                        HorizontalAlignment="Center"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        Visibility="Collapsed" />

                    <views:TaskPeekPane
                        x:Name="PeekPane"
                        Grid.Column="2"
                        CloseRequested="OnPeekCloseRequested"
                        StopRequested="OnPeekStopRequested"
                        Visibility="Collapsed" />

                    <!--  TabView's default style pins VerticalAlignment to Top, which
                          collapses the whole centre area to one tab's content height.  -->
                    <TabView
                        x:Name="CentreTabs"
                        Grid.Column="0"
                        AddTabButtonClick="OnCentreAddTabClick"
                        Background="Transparent"
                        SelectionChanged="OnCentreTabSelectionChanged"
                        TabCloseRequested="OnCentreTabCloseRequested"
                        VerticalAlignment="Stretch" />

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="36"
                        Glyph="&#xE8A5;"
                        Opacity="0.4" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Nothing open" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="380"
                        Text="Pick something to start on this project." />
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="OnNewTabMenuItemClick" Tag="claude">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                                <TextBlock x:Name="ClaudeEmptyLabel" Text="Claude chat" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewTabMenuItemClick" Tag="codex">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                                <TextBlock x:Name="CodexEmptyLabel" Text="Codex chat" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="OnNewTabMenuItemClick" Tag="terminal">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE756;" />
                                <TextBlock Text="Terminal" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewTabMenuItemClick" Tag="openfile">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="Open file…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewTabMenuItemClick" Tag="newfile">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="New file" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnNewTabMenuItemClick" Tag="search">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>




            <!--  Slide-up terminal command output flyout drawer  -->
            <Border
                x:Name="TerminalOutputDrawer"
                Grid.ColumnSpan="3"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="8,0,8,4"
                Height="280"
                MaxHeight="500"
                MinHeight="160"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TerminalDrawerSlide" Y="280" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Flyout Header  -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        Padding="12,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Left: Terminal glyph, Command badge, CWD badge, Status  -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <Border
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1,6,1">
                                    <TextBlock
                                        x:Name="TerminalDrawerCommandText"
                                        Text="$ ls"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        MaxWidth="320"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>

                                <Rectangle Width="1" Height="12" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" />

                                <StackPanel x:Name="TerminalDrawerStatusPanel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <ProgressRing
                                        x:Name="TerminalDrawerSpinner"
                                        Width="12"
                                        Height="12"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="TerminalDrawerStatusIcon"
                                        Glyph="&#xE73E;"
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock
                                        x:Name="TerminalDrawerStatusText"
                                        Text="Ready"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Right: Drawer actions  -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button
                                    x:Name="TerminalDrawerCopyButton"
                                    Click="OnTerminalDrawerCopyClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Copy output to clipboard">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                                <Button
                                    x:Name="TerminalDrawerClearButton"
                                    Click="OnTerminalDrawerClearClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Clear output">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                </Button>
                                <Button
                                    x:Name="TerminalDrawerRerunButton"
                                    Click="OnTerminalDrawerRerunClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Rerun command">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                </Button>
                                <Button
                                    x:Name="TerminalDrawerStopButton"
                                    Click="OnTerminalDrawerStopClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Stop running command">
                                    <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                                <Button
                                    x:Name="TerminalDrawerOpenTabButton"
                                    Click="OnTerminalDrawerOpenTabClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Open in full terminal tab">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                </Button>
                                <Rectangle Width="1" Height="14" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" />
                                <Button
                                    x:Name="TerminalDrawerCloseButton"
                                    Click="OnTerminalDrawerCloseClick"
                                    Padding="6,4"
                                    Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Close output (Esc)">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Flyout Output Body  -->
                    <ScrollViewer
                        x:Name="TerminalDrawerScrollViewer"
                        Grid.Row="1"
                        Padding="12,8"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBox
                            x:Name="TerminalDrawerOutputBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsSpellCheckEnabled="False"
                            KeyDown="OnTerminalDrawerOutputBoxKeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  Status bar  -->
        <StackPanel Grid.Row="1">
        <Border
            Margin="6,2,6,6"
            Padding="12,4,8,4"
            MinHeight="38"
            Background="{ThemeResource ShellStatusBarBackgroundBrush}"
            BorderBrush="{ThemeResource ShellStatusBarStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left: the repository and the file language  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">

                    <!--  Icons center on their label: 10px keeps the glyph inside the text band,
                          and each Margin (computed from the icon font's glyph boxes) lines the
                          glyph's visual center up with the label's. Both sides center again in
                          whatever height the row ends up with.  -->
                    <!--  Git: branch, then modified / created / deleted counts  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.Git.IsRepository, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Git.TrackingSummary, Mode=OneWay}">
                            <FontIcon VerticalAlignment="Center" Margin="0,1.3,0,0" FontSize="10" Glyph="&#xE81E;" Opacity="0.6" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.8"
                                Text="{x:Bind ViewModel.Git.BranchName, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Git.StatusDetail, Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                ToolTipService.ToolTip="Modified">
                                <Run Text="~" /><Run Text="{x:Bind ViewModel.Git.ModifiedCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                ToolTipService.ToolTip="Created (added or untracked)">
                                <Run Text="+" /><Run Text="{x:Bind ViewModel.Git.CreatedCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                ToolTipService.ToolTip="Deleted">
                                <Run Text="−" /><Run Text="{x:Bind ViewModel.Git.DeletedCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>


                    <!--  Language of the file in front: shows what colours it, and lets the user override that  -->
                    <StackPanel x:Name="LanguageHost" Orientation="Horizontal" Spacing="16">
                        <Button
                            x:Name="LanguageButton"
                            Padding="8,2"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Language mode: change how this file is coloured">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                            </Button.Resources>
                            <Button.Flyout>
                                <Flyout
                                    x:Name="LanguageFlyout"
                                    FlyoutPresenterStyle="{StaticResource EndpointFlyout}"
                                    Opening="OnLanguageFlyoutOpening"
                                    Placement="TopEdgeAlignedLeft">
                                    <controls:LanguagePicker x:Name="LanguagePickerControl" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon VerticalAlignment="Center" Margin="0,0.7,0,0" FontSize="10" Glyph="&#xE943;" Opacity="0.6" />
                                <TextBlock
                                    x:Name="LanguageText"
                                    VerticalAlignment="Center"
                                    Text="No File"
                                    FontSize="12"
                                    Opacity="0.8" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Center: Terminal command input bar (flat, neutral styling)  -->
                <Border
                    x:Name="StatusBarCommandContainer"
                    Grid.Column="1"
                    Margin="12,0,12,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Current working directory button styled like arrow prompt  -->
                        <Button
                            x:Name="StatusBarCwdButton"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            Padding="8,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0">
                            <Button.Flyout>
                                <MenuFlyout x:Name="CwdMenuFlyout" Placement="Top" Opening="OnCwdMenuFlyoutOpening" />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED25;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StatusBarCwdText"
                                    FontSize="12"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontWeight="Normal"
                                    VerticalAlignment="Center"
                                    MaxWidth="220"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text=">"
                                    FontSize="12"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="1"
                            Height="14"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--  Flat command textbox  -->
                        <AutoSuggestBox
                            x:Name="StatusBarCommandBox"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="8,0,8,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="12"
                            PlaceholderText="Run shell command (e.g. ls)…"
                            UpdateTextOnSelect="False"
                            TextChanged="OnStatusBarCommandBoxTextChanged"
                            QuerySubmitted="OnStatusBarCommandBoxQuerySubmitted"
                            KeyDown="OnStatusBarCommandBoxKeyDown">
                            <AutoSuggestBox.Resources>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.7" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.7" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.7" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.7" />
                                <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </AutoSuggestBox.Resources>
                        </AutoSuggestBox>

                        <!--  Right quick actions: Enter / Run button and Output Drawer Toggle button  -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Button
                                x:Name="StatusBarRunButton"
                                Click="OnStatusBarRunButtonClick"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Run command (Enter)">
                                <FontIcon Glyph="&#xE751;" FontSize="11" Opacity="0.75" />
                            </Button>
                            <Button
                                x:Name="StatusBarToggleOutputButton"
                                Click="OnStatusBarToggleOutputClick"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                ToolTipService.ToolTip="Toggle command output flyout">
                                <Grid Width="24" Height="24">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" Opacity="0.75" />
                                    <ProgressBar
                                        x:Name="StatusBarRunProgress"
                                        IsIndeterminate="True"
                                        Height="2"
                                        Margin="3,0,3,2"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Right: the background-task provider and its usage  -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                    <!--  Background-task provider: its name and what it has served since the window opened (background tasks and chats on the same provider alike)  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10"
                        ToolTipService.ToolTip="Provider used for background tasks: commit messages, titles, routing, search">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon VerticalAlignment="Center" Margin="0,0.7,0,0" FontSize="10" Glyph="&#xE968;" Opacity="0.6" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Opacity="0.85"
                                Text="{x:Bind ViewModel.Status.CustomProviderName, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Status.CustomCallsText, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Status.CustomTokensText, Mode=OneWay}" />
                    </StackPanel>

                    <Rectangle
                        VerticalAlignment="Center"
                        Width="1"
                        Height="14"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Run time: when this window started, and how long it has been running  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        ToolTipService.ToolTip="Run started at · time elapsed since">
                        <FontIcon VerticalAlignment="Center" Margin="0,1.3,0,0" FontSize="10" Glyph="&#xE916;" Opacity="0.6" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind ViewModel.StartedAtText}" />
                        <TextBlock
                            MinWidth="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.8"
                            Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Built-in MCP servers: a browser to verify work in, and desktop control  -->
                    <!--  Opened from the title bar's Browser button; this host only owns the flyout  -->
                    <Border x:Name="McpToolsHost" Width="0" Height="0" Margin="-16,0,0,0">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout FlyoutPresenterStyle="{StaticResource EndpointFlyout}" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Padding="16,14,16,14" Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Agent tools" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Applies to new sessions" />
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Glyph="&#xE774;"
                                                Opacity="0.8" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Browser" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.McpTools.BrowserNote}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                Grid.Column="2"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                IsEnabled="{x:Bind ViewModel.McpTools.BrowserAvailable}"
                                                IsOn="{x:Bind ViewModel.McpTools.BrowserEnabled, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                        </Grid>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.McpTools.OpenBrowserCommand}"
                                            Content="Open browser window"
                                            IsEnabled="{x:Bind ViewModel.McpTools.BrowserAvailable}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind ViewModel.McpTools.OpenBrowserError, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.McpTools.HasOpenBrowserError, Mode=OneWay}" />

                                        <!--  Localhost static server: the main part serves the project, the arrow picks any folder  -->
                                        <SplitButton
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnServeProjectSplitClick"
                                            ToolTipService.ToolTip="Host a folder on http://localhost until you stop it or close Codale">
                                            <TextBlock Text="Serve project folder" />
                                            <SplitButton.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Click="OnServeProjectFolderClick" Text="Serve project folder">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Click="OnServeOtherFolderClick" Text="Choose a folder to serve…">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </SplitButton.Flyout>
                                        </SplitButton>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind ViewModel.McpTools.ServeError, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.McpTools.HasServeError, Mode=OneWay}" />
                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.McpTools.ServedFolders}"
                                            Visibility="{x:Bind ViewModel.McpTools.HasServedFolders, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ServedFolderItem">
                                                    <Grid Padding="0,2,0,2" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            Margin="2,0,6,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Glyph="&#xE968;"
                                                            Opacity="0.8" />
                                                        <HyperlinkButton
                                                            Grid.Column="1"
                                                            Padding="4,2,4,2"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Click="OnOpenServedClick"
                                                            ToolTipService.ToolTip="{x:Bind Folder}">
                                                            <StackPanel Spacing="0">
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Text="{x:Bind Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </HyperlinkButton>
                                                        <Button
                                                            Grid.Column="2"
                                                            Padding="6"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnCopyServedClick"
                                                            ToolTipService.ToolTip="Copy URL">
                                                            <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                                        </Button>
                                                        <Button
                                                            Grid.Column="3"
                                                            Padding="6"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnStopServedClick"
                                                            ToolTipService.ToolTip="Stop serving">
                                                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Glyph="&#xE7F4;"
                                            Opacity="0.8" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Desktop control" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.McpTools.ComputerNote}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.McpTools.ComputerAvailable}"
                                            IsOn="{x:Bind ViewModel.McpTools.ComputerEnabled, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</Page>
