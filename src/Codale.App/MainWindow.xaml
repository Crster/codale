<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Codale.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Codale.App.Controls"
    xmlns:local="using:Codale.App"
    xmlns:views="using:Codale.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Codale"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--  The theme comes from Settings (AppSettings.Theme); dark is the default look.  -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ShellBackdropTintBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Codale">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="18"
                        Height="18"
                        Margin="12,0,6,0"
                        VerticalAlignment="Center"
                        Source="Assets/AppIcon.ico" />
                    <Button
                        x:Name="LeftPanelButton"
                        Width="32"
                        Height="30"
                        Click="OnTitleBarLeftPanelClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Show or hide the side panel"
                        Visibility="Collapsed">
                        <FontIcon FontSize="14" Glyph="&#xE8A0;" />
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <!--  The global search: looks like a field, opens the floating palette.  -->
                <Grid x:Name="TitleBarCenter" Visibility="Collapsed">
                    <Button
                        x:Name="SearchLauncher"
                        Width="460"
                        Height="30"
                        Padding="10,0,6,0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ShellInputBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellInputStrokeBrush}"
                        BorderThickness="1"
                        Click="OnSearchLauncherClick"
                        CornerRadius="7"
                        ToolTipService.ToolTip="Search the project">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE721;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Search files, chats and commands"
                                TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Style="{StaticResource ShellKeycap}">
                                <TextBlock x:Name="SearchShortcutText" Style="{StaticResource ShellKeycapText}" Text="Ctrl+F" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel
                    x:Name="TitleBarExtras"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2"
                    Visibility="Collapsed">
                    <Button
                        x:Name="CommandsButton"
                        Width="32"
                        Height="30"
                        Click="OnTitleBarCommandsClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Run a project command">
                        <Grid>
                            <FontIcon FontSize="13" Glyph="&#xE768;" />
                            <!--  The running-command count; hidden when nothing runs.  -->
                            <Border
                                x:Name="CommandsBadge"
                                MinWidth="14"
                                Margin="0,-7,-10,0"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource StatusSuccessBrush}"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="CommandsBadgeText"
                                    FontSize="9.5"
                                    FontWeight="SemiBold"
                                    Foreground="#0B0C0E"
                                    HorizontalTextAlignment="Center"
                                    Text="0" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="BrowserButton"
                        Width="32"
                        Height="30"
                        Click="OnTitleBarBrowserClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Browser, desktop and phone tools for the agent">
                        <FontIcon FontSize="13" Glyph="&#xE774;" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource ShellHairlineBrush}" />
                    <Button
                        Width="32"
                        Height="30"
                        Click="OnChangeFolderClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Open another folder">
                        <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    </Button>
                    <Button
                        Width="32"
                        Height="30"
                        Click="OnSettingsClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!--  The global search palette floats over the page, under the title bar.  -->
        <views:QuickSearch x:Name="QuickSearchHost" Grid.Row="1" />

        <!--  Settings drawer backdrop: dims the editor behind and dismisses on tap  -->
        <Grid
            x:Name="SettingsBackdrop"
            Grid.Row="1"
            Background="#66000000"
            Opacity="0"
            Tapped="OnSettingsBackdropTapped"
            Visibility="Collapsed" />

        <!--  Settings slides in over the right edge; Collapsed (and off-screen) until opened.  -->
        <controls:SettingsPanel
            x:Name="SettingsHost"
            Grid.Row="1"
            Width="880"
            MaxWidth="9999"
            HorizontalAlignment="Right"
            Visibility="Collapsed">
            <controls:SettingsPanel.RenderTransform>
                <TranslateTransform x:Name="SettingsSlide" X="880" />
            </controls:SettingsPanel.RenderTransform>
        </controls:SettingsPanel>
    </Grid>
</Window>
