<?xml version="1.0" encoding="utf-8" ?>
<!--
    The transcript's colour system. The window is pinned to the dark theme
    (MainWindow.xaml), so these are plain resources rather than theme dictionaries:
    converters resolve them from Application.Resources, which only sees the
    app-level theme and would pick the wrong half of a theme dictionary.

    Colour carries meaning, never decoration:
      * a tool's KIND picks its hue (read blue, edit amber, shell violet...), shown
        on a small tinted disc and the step's verb - enough to scan a turn by colour;
      * a call's OUTCOME only speaks up when it went wrong (red / amber);
      * surfaces stay neutral, so the colours above are the only loud things.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Tool kinds: foreground, and a ~15% tint for the icon disc and pills.  -->
    <SolidColorBrush x:Key="KindReadBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="KindReadTintBrush" Color="#2638BDF8" />
    <SolidColorBrush x:Key="KindSearchBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="KindSearchTintBrush" Color="#262DD4BF" />
    <SolidColorBrush x:Key="KindEditBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="KindEditTintBrush" Color="#26FBBF24" />
    <SolidColorBrush x:Key="KindWriteBrush" Color="#34D399" />
    <SolidColorBrush x:Key="KindWriteTintBrush" Color="#2634D399" />
    <SolidColorBrush x:Key="KindShellBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="KindShellTintBrush" Color="#26A78BFA" />
    <SolidColorBrush x:Key="KindWebBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="KindWebTintBrush" Color="#26F472B6" />
    <SolidColorBrush x:Key="KindAgentBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="KindAgentTintBrush" Color="#26FB923C" />
    <SolidColorBrush x:Key="KindAskBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="KindAskTintBrush" Color="#26818CF8" />
    <SolidColorBrush x:Key="KindPlanBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="KindPlanTintBrush" Color="#26A78BFA" />
    <SolidColorBrush x:Key="KindTodoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="KindTodoTintBrush" Color="#2638BDF8" />
    <SolidColorBrush x:Key="KindOtherBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="KindOtherTintBrush" Color="#1E94A3B8" />

    <!--  Outcomes.  -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="StatusRunningTintBrush" Color="#2438BDF8" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="StatusSuccessTintBrush" Color="#2434D399" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="StatusFailedTintBrush" Color="#24FB7185" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="StatusWarnTintBrush" Color="#24FBBF24" />
    <SolidColorBrush x:Key="StatusMutedBrush" Color="#94A3B8" />

    <!--  Diffs: faint row tints that stay readable, stronger text for the +/- marks.  -->
    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#2410B981" />
    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#28F43F5E" />
    <SolidColorBrush x:Key="DiffAddedForegroundBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="DiffRemovedForegroundBrush" Color="#FDA4AF" />
    <SolidColorBrush x:Key="DiffContextForegroundBrush" Color="#C8FFFFFF" />
    <SolidColorBrush x:Key="DiffGutterBrush" Color="#60FFFFFF" />
    <SolidColorBrush x:Key="DiffHunkHeaderBrush" Color="#99818CF8" />

    <!--  Surfaces.  -->
    <SolidColorBrush x:Key="TimelineRailBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="StepHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DetailSurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="DetailStrokeBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CodeSurfaceBrush" Color="#3D000000" />
    <SolidColorBrush x:Key="CodeHeaderSurfaceBrush" Color="#55000000" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#2B6366F1" />
    <SolidColorBrush x:Key="UserBubbleStrokeBrush" Color="#4D6366F1" />
    <SolidColorBrush x:Key="AssistantCardBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="AssistantCardStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="StarterCardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="StarterCardStrokeBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TodoTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TodoDoneTextBrush" Color="#64748B" />

    <!--  Markdown in messages: body slightly softer than bold, so emphasis and headings stand out.  -->
    <SolidColorBrush x:Key="MdBodyBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MdStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MdHeading1Brush" Color="#A5B4FC" />
    <SolidColorBrush x:Key="MdHeading2Brush" Color="#93C5FD" />
    <SolidColorBrush x:Key="MdHeading3Brush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="MdCodeBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="MdBulletBrush" Color="#A5B4FC" />
    <SolidColorBrush x:Key="MdChangeAddedBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="MdChangeEditedBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="MdChangeDroppedBrush" Color="#FDA4AF" />

    <!--  Asking the reader something: indigo for questions, amber for permission.  -->
    <SolidColorBrush x:Key="AskSurfaceBrush" Color="#18818CF8" />
    <SolidColorBrush x:Key="AskStrokeBrush" Color="#66818CF8" />
    <SolidColorBrush x:Key="OptionSelectedBrush" Color="#33818CF8" />
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ApprovalSurfaceBrush" Color="#18FBBF24" />
    <SolidColorBrush x:Key="ApprovalStrokeBrush" Color="#66FBBF24" />
</ResourceDictionary>
