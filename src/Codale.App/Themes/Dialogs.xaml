<?xml version="1.0" encoding="utf-8" ?>
<!--
    Every ContentDialog in the app. Two layers:

      * The ContentDialog* keys below override the Fluent defaults app-wide, so even a
        bare `new ContentDialog` gets the tighter padding, the two-tone body/footer and
        the darker smoke.
      * The Dialog* styles are used by Controls/AppDialog.cs to build the header (a
        tinted disc with a glyph, like the transcript's tool discs), the body text,
        file lists, code blocks and the red button for destructive actions.

    The styles hold ThemeResource setters rather than code reading brushes from
    Application.Resources: a dialog lives in the popup layer with its own
    RequestedTheme, and only a style resolves against that element's theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!--  Body sits a step above the footer; both darker than the stock Fluent grey.  -->
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#23262E" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#1A1C22" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#A6070910" />

            <SolidColorBrush x:Key="DialogTitleBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="DialogBodyTextBrush" Color="#CBD2DC" />
            <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#8B94A3" />
            <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="DialogSurfaceStrokeBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="DialogCodeSurfaceBrush" Color="#47000000" />
            <SolidColorBrush x:Key="DialogCodeTextBrush" Color="#E2E8F0" />

            <SolidColorBrush x:Key="DialogToneInfoBrush" Color="#818CF8" />
            <SolidColorBrush x:Key="DialogToneInfoTintBrush" Color="#26818CF8" />
            <SolidColorBrush x:Key="DialogToneWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="DialogToneWarningTintBrush" Color="#24FBBF24" />
            <SolidColorBrush x:Key="DialogToneDangerBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="DialogToneDangerTintBrush" Color="#26FB7185" />
            <SolidColorBrush x:Key="DialogToneSuccessBrush" Color="#34D399" />
            <SolidColorBrush x:Key="DialogToneSuccessTintBrush" Color="#2434D399" />

            <SolidColorBrush x:Key="DialogDangerButtonBackground" Color="#E11D48" />
            <SolidColorBrush x:Key="DialogDangerButtonBackgroundPointerOver" Color="#F43F5E" />
            <SolidColorBrush x:Key="DialogDangerButtonBackgroundPressed" Color="#BE123C" />
            <SolidColorBrush x:Key="DialogDangerButtonBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DialogDangerButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DialogDangerButtonForegroundPressed" Color="#E6FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F1F3F6" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#CDD2DA" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#E3E6EB" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66101828" />

            <SolidColorBrush x:Key="DialogTitleBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="DialogBodyTextBrush" Color="#334155" />
            <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#64748B" />
            <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="DialogSurfaceStrokeBrush" Color="#E3E6EB" />
            <SolidColorBrush x:Key="DialogCodeSurfaceBrush" Color="#EEF0F4" />
            <SolidColorBrush x:Key="DialogCodeTextBrush" Color="#1E293B" />

            <SolidColorBrush x:Key="DialogToneInfoBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="DialogToneInfoTintBrush" Color="#1A4F46E5" />
            <SolidColorBrush x:Key="DialogToneWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="DialogToneWarningTintBrush" Color="#1FD97706" />
            <SolidColorBrush x:Key="DialogToneDangerBrush" Color="#E11D48" />
            <SolidColorBrush x:Key="DialogToneDangerTintBrush" Color="#1AE11D48" />
            <SolidColorBrush x:Key="DialogToneSuccessBrush" Color="#059669" />
            <SolidColorBrush x:Key="DialogToneSuccessTintBrush" Color="#1A059669" />

            <SolidColorBrush x:Key="DialogDangerButtonBackground" Color="#E11D48" />
            <SolidColorBrush x:Key="DialogDangerButtonBackgroundPointerOver" Color="#BE123C" />
            <SolidColorBrush x:Key="DialogDangerButtonBackgroundPressed" Color="#9F1239" />
            <SolidColorBrush x:Key="DialogDangerButtonBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="DialogDangerButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DialogDangerButtonForegroundPressed" Color="#E6FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="ContentDialogSeparatorBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="SystemColorWindowColorBrush" />

            <StaticResource x:Key="DialogTitleBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DialogBodyTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DialogMutedTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="DialogSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DialogSurfaceStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DialogCodeSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DialogCodeTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />

            <StaticResource x:Key="DialogToneInfoBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogToneInfoTintBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DialogToneWarningBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogToneWarningTintBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DialogToneDangerBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogToneDangerTintBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DialogToneSuccessBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogToneSuccessTintBrush" ResourceKey="SystemColorWindowColorBrush" />

            <StaticResource x:Key="DialogDangerButtonBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogDangerButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="DialogDangerButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DialogDangerButtonBorderBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="DialogDangerButtonForeground" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="DialogDangerButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Geometry: tighter than Fluent's 24px everywhere, with a little more air under the header.  -->
    <Thickness x:Key="ContentDialogPadding">20,18,20,18</Thickness>
    <Thickness x:Key="ContentDialogTitleMargin">0,0,0,14</Thickness>
    <x:Double x:Key="ContentDialogMinWidth">380</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <x:Double x:Key="ContentDialogMinHeight">150</x:Double>

    <!--  Header: tone disc + title.  -->
    <Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource DialogTitleBrush}" />
    </Style>

    <Style x:Key="DialogBadgeBaseStyle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="DialogBadgeInfoStyle" TargetType="Border" BasedOn="{StaticResource DialogBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource DialogToneInfoTintBrush}" />
    </Style>
    <Style x:Key="DialogBadgeWarningStyle" TargetType="Border" BasedOn="{StaticResource DialogBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource DialogToneWarningTintBrush}" />
    </Style>
    <Style x:Key="DialogBadgeDangerStyle" TargetType="Border" BasedOn="{StaticResource DialogBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource DialogToneDangerTintBrush}" />
    </Style>
    <Style x:Key="DialogBadgeSuccessStyle" TargetType="Border" BasedOn="{StaticResource DialogBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource DialogToneSuccessTintBrush}" />
    </Style>

    <Style x:Key="DialogGlyphBaseStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DialogGlyphInfoStyle" TargetType="FontIcon" BasedOn="{StaticResource DialogGlyphBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DialogToneInfoBrush}" />
    </Style>
    <Style x:Key="DialogGlyphWarningStyle" TargetType="FontIcon" BasedOn="{StaticResource DialogGlyphBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DialogToneWarningBrush}" />
    </Style>
    <Style x:Key="DialogGlyphDangerStyle" TargetType="FontIcon" BasedOn="{StaticResource DialogGlyphBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DialogToneDangerBrush}" />
    </Style>
    <Style x:Key="DialogGlyphSuccessStyle" TargetType="FontIcon" BasedOn="{StaticResource DialogGlyphBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DialogToneSuccessBrush}" />
    </Style>

    <!--  Body.  -->
    <Style x:Key="DialogBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource DialogBodyTextBrush}" />
    </Style>
    <Style x:Key="DialogMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource DialogMutedTextBrush}" />
    </Style>
    <Style x:Key="DialogListItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource DialogTitleBrush}" />
    </Style>
    <Style x:Key="DialogListGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource DialogMutedTextBrush}" />
    </Style>
    <Style x:Key="DialogSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DialogSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DialogSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="DialogCodeSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DialogCodeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DialogSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style x:Key="DialogCodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource DialogCodeTextBrush}" />
    </Style>

    <!--  The primary button of a destructive confirmation: solid red, so "Delete" never looks like "OK".  -->
    <Style x:Key="DialogDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource DialogDangerButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource DialogDangerButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DialogDangerButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083" />
                        </ContentPresenter.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource DialogDangerButtonBackgroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource DialogDangerButtonBackgroundPressed}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource DialogDangerButtonForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
