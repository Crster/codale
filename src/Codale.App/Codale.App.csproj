<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Codale.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      CsWinRT1032 flags `[..]` collection expressions that target IReadOnlyList/IEnumerable as
      unsafe for trimming/AOT. Neither is used here (PublishTrimmed stays off), so it is noise.
    -->
    <NoWarn>$(NoWarn);CsWinRT1032</NoWarn>
    <!--
      Custom Program.Main: which instance owns this project has to be decided, and
      activation possibly redirected, before the XAML application starts.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Restore server dependencies without referencing their executable assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\Codale.Mcp.Browser\Codale.Mcp.Browser.csproj;..\Codale.Mcp.Computer\Codale.Mcp.Computer.csproj;..\Codale.Mcp.Phone\Codale.Mcp.Phone.csproj;..\Codale.Mcp.Tasks\Codale.Mcp.Tasks.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <BundledMcpProject Include="..\Codale.Mcp.Browser\Codale.Mcp.Browser.csproj;..\Codale.Mcp.Computer\Codale.Mcp.Computer.csproj;..\Codale.Mcp.Phone\Codale.Mcp.Phone.csproj;..\Codale.Mcp.Tasks\Codale.Mcp.Tasks.csproj" />
  </ItemGroup>

  <!-- Build before evaluating payload globs, including on a fresh checkout. -->
  <Target Name="IncludeBundledServers" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Condition="'$(NoBuild)' != 'true'" Projects="@(BundledMcpProject)" Targets="Build" BuildInParallel="true" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;Platform;TargetFramework;SelfContained;PublishReadyToRun;GenerateAppxPackageOnBuild" />
    <ItemGroup>
      <_McpBrowserPayload
        Include="..\Codale.Mcp.Browser\bin\$(Configuration)\net10.0\**\*.*"
        Exclude="..\Codale.Mcp.Browser\bin\$(Configuration)\net10.0\.playwright\package\lib\vite\**;..\Codale.Mcp.Browser\bin\$(Configuration)\net10.0\.playwright\node\darwin*\**;..\Codale.Mcp.Browser\bin\$(Configuration)\net10.0\.playwright\node\linux*\**"
        Condition="Exists('..\Codale.Mcp.Browser\bin\$(Configuration)\net10.0\Codale.Mcp.Browser.exe')" />
      <_McpBrowserPayload Update="@(_McpBrowserPayload)">
        <Link>Codale.Mcp.Browser\%(_McpBrowserPayload.RecursiveDir)%(_McpBrowserPayload.Filename)%(_McpBrowserPayload.Extension)</Link>
        <TargetPath>Codale.Mcp.Browser\%(_McpBrowserPayload.RecursiveDir)%(_McpBrowserPayload.Filename)%(_McpBrowserPayload.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_McpBrowserPayload>
      <Content Include="@(_McpBrowserPayload)" />
      <_McpComputerPayload
        Include="..\Codale.Mcp.Computer\bin\$(Configuration)\net10.0-windows10.0.26100.0\**\*.*"
        Condition="Exists('..\Codale.Mcp.Computer\bin\$(Configuration)\net10.0-windows10.0.26100.0\Codale.Mcp.Computer.exe')" />
      <_McpComputerPayload Update="@(_McpComputerPayload)">
        <Link>Codale.Mcp.Computer\%(_McpComputerPayload.RecursiveDir)%(_McpComputerPayload.Filename)%(_McpComputerPayload.Extension)</Link>
        <TargetPath>Codale.Mcp.Computer\%(_McpComputerPayload.RecursiveDir)%(_McpComputerPayload.Filename)%(_McpComputerPayload.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_McpComputerPayload>
      <Content Include="@(_McpComputerPayload)" />
      <_McpPhonePayload
        Include="..\Codale.Mcp.Phone\bin\$(Configuration)\net10.0\**\*.*"
        Condition="Exists('..\Codale.Mcp.Phone\bin\$(Configuration)\net10.0\Codale.Mcp.Phone.exe')" />
      <_McpPhonePayload Update="@(_McpPhonePayload)">
        <Link>Codale.Mcp.Phone\%(_McpPhonePayload.RecursiveDir)%(_McpPhonePayload.Filename)%(_McpPhonePayload.Extension)</Link>
        <TargetPath>Codale.Mcp.Phone\%(_McpPhonePayload.RecursiveDir)%(_McpPhonePayload.Filename)%(_McpPhonePayload.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_McpPhonePayload>
      <Content Include="@(_McpPhonePayload)" />
      <_McpTasksPayload
        Include="..\Codale.Mcp.Tasks\bin\$(Configuration)\net10.0\**\*.*"
        Condition="Exists('..\Codale.Mcp.Tasks\bin\$(Configuration)\net10.0\Codale.Mcp.Tasks.exe')" />
      <_McpTasksPayload Update="@(_McpTasksPayload)">
        <Link>Codale.Mcp.Tasks\%(_McpTasksPayload.RecursiveDir)%(_McpTasksPayload.Filename)%(_McpTasksPayload.Extension)</Link>
        <TargetPath>Codale.Mcp.Tasks\%(_McpTasksPayload.RecursiveDir)%(_McpTasksPayload.Filename)%(_McpTasksPayload.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_McpTasksPayload>
      <Content Include="@(_McpTasksPayload)" />
    </ItemGroup>
  </Target>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <!--
    Bound the managed heap to 4 GB. ConserveMemory favors a smaller working set
    at the cost of more frequent garbage collection.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="4294967296" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codale.Core\Codale.Core.csproj" />
    <ProjectReference Include="..\Codale.Commands\Codale.Commands.csproj" />
    <ProjectReference Include="..\Codale.Agents\Codale.Agents.csproj" />
    <ProjectReference Include="..\Codale.Terminal\Codale.Terminal.csproj" />
    <ProjectReference Include="..\Codale.Git\Codale.Git.csproj" />
    <ProjectReference Include="..\Codale.Search\Codale.Search.csproj" />
    <ProjectReference Include="..\Codale.Smart\Codale.Smart.csproj" />
    <ProjectReference Include="..\Codale.Db\Codale.Db.csproj" />
    <Content Include="..\Codale.Smart\licenses\*.txt">
      <Link>SmartNative\licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildSmartNative" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="..\Codale.Smart\native\smart.cpp;..\Codale.Smart\native\build.ps1"
          Outputs="..\Codale.Smart\native\bin\$(RuntimeIdentifier)\codale-smart.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Codale.Smart\native\build.ps1&quot; -Platform $([System.String]::Copy('$(RuntimeIdentifier)').Replace('win-', ''))" />
  </Target>
  <Target Name="IncludeSmartNative" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildSmartNative">
    <ItemGroup>
      <SmartNativeFile Include="..\Codale.Smart\native\bin\$(RuntimeIdentifier)\ggml*.dll;..\Codale.Smart\native\bin\$(RuntimeIdentifier)\llama.dll;..\Codale.Smart\native\bin\$(RuntimeIdentifier)\libomp.dll;..\Codale.Smart\native\bin\$(RuntimeIdentifier)\codale-smart.dll" />
      <Content Include="@(SmartNativeFile)">
        <Link>SmartNative\%(SmartNativeFile.Filename)%(SmartNativeFile.Extension)</Link>
        <TargetPath>SmartNative\%(SmartNativeFile.Filename)%(SmartNativeFile.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The text Codale's MCP servers send as their instructions. -->
    <Compile Include="..\Codale.Mcp.Common\McpInstructions.cs" Link="Services\McpInstructions.cs" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' And '$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!--
      Keep reflection metadata used by WinUI bindings and activation.
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
  <Import Project="Build\ShellExtension.targets" />
</Project>
