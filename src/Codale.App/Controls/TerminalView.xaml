<?xml version="1.0" encoding="utf-8" ?>
<!--
  Codale's own native terminal control. The cell grid is drawn in Win2D on the
  CanvasControl; the ScrollViewer above it exists only for its scrollbar - its
  background is null, so pointer input falls through to the canvas everywhere
  except on the bar itself. Parsing lives in Codale.Terminal's TerminalEmulator;
  this control turns its buffer into pixels and its keys into VT sequences.
-->
<UserControl
    x:Class="Codale.App.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid>
        <canvas:CanvasControl
            x:Name="Canvas"
            CreateResources="OnCreateResources"
            Draw="OnCanvasDraw"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerExited="OnPointerExited"
            PointerReleased="OnPointerReleased"
            PointerWheelChanged="OnPointerWheelChanged"
            SizeChanged="OnCanvasSizeChanged" />

        <!--
            The cursor lives on its own layer so the 530ms blink toggles a one-cell draw
            instead of re-running the full grid paint twice a second while idle.
        -->
        <canvas:CanvasControl
            x:Name="CaretCanvas"
            IsHitTestVisible="False"
            CreateResources="OnCaretCreateResources"
            Draw="OnCaretCanvasDraw" />

        <ScrollViewer
            x:Name="Scroller"
            Background="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ViewChanged="OnViewChanged">
            <Canvas x:Name="Extent" IsHitTestVisible="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
