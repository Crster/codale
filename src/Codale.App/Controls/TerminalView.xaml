<?xml version="1.0" encoding="utf-8" ?>
<!--
  Codale's own native terminal control. The cell grid is drawn in Win2D on the
  CanvasControl; the scrollbar is an OverlayScrollBar over it, so pointer input
  reaches the canvas everywhere except on the bar itself. Parsing lives in Codale.Terminal's TerminalEmulator;
  this control turns its buffer into pixels and its keys into VT sequences.
-->
<UserControl
    x:Class="Codale.App.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid x:Name="RootGrid">
        <canvas:CanvasControl
            x:Name="Canvas"
            CreateResources="OnCreateResources"
            Draw="OnCanvasDraw"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerExited="OnPointerExited"
            PointerReleased="OnPointerReleased"
            PointerWheelChanged="OnPointerWheelChanged"
            SizeChanged="OnCanvasSizeChanged" />

        <!--
            The cursor lives on its own layer so the 530ms blink toggles a one-cell draw
            instead of re-running the full grid paint twice a second while idle.
        -->
        <canvas:CanvasControl
            x:Name="CaretCanvas"
            IsHitTestVisible="False"
            CreateResources="OnCaretCreateResources"
            Draw="OnCaretCanvasDraw" />

        <!-- The scrollbar (OverlayScrollBar) is added to this grid in code, above the canvases. -->
    </Grid>
</UserControl>
