<?xml version="1.0" encoding="utf-8" ?>
<!--
  Codale's own code editor control. The drawing happens in Win2D on the CanvasControl;
  the ScrollViewer above it exists only for its scrollbars - its background is null, so
  pointer input falls through to the canvas everywhere except on the bars themselves,
  and the invisible extent canvas inside it just gives the bars something to size to.
-->
<UserControl
    x:Class="Codale.App.Controls.CodeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid x:Name="RootGrid">
        <canvas:CanvasControl
            x:Name="Canvas"
            CreateResources="OnCreateResources"
            Draw="OnCanvasDraw"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerWheelChanged="OnPointerWheelChanged"
            SizeChanged="OnCanvasSizeChanged" />

        <!--
            The caret lives on its own layer so the 530ms blink toggles a ~2px draw
            instead of re-running the full viewport paint twice a second while idle.
        -->
        <canvas:CanvasControl
            x:Name="CaretCanvas"
            IsHitTestVisible="False"
            CreateResources="OnCaretCreateResources"
            Draw="OnCaretCanvasDraw" />

        <ScrollViewer
            x:Name="Scroller"
            Background="{x:Null}"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ViewChanged="OnViewChanged">
            <Canvas x:Name="Extent" IsHitTestVisible="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
