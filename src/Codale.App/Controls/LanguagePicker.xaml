<UserControl
    x:Class="Codale.App.Controls.LanguagePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codale.App.Controls">

    <StackPanel Width="300" Padding="12,10,12,10" Spacing="8">
        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Language mode" />
        <TextBlock
            x:Name="Caption"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="SearchBox"
            PlaceholderText="Search languages"
            TextChanged="OnSearchChanged" />
        <ListView
            x:Name="List"
            MaxHeight="280"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LanguageRow">
                    <Grid MinHeight="30" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="11"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind CheckVisibility}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{x:Bind Text}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Detail}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="Actions" Spacing="4" />
    </StackPanel>
</UserControl>
