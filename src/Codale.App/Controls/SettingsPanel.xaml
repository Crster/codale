<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Slides in over the right edge of the main window; the theme is inherited from it.  -->
    <Border
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
            <Grid.Resources>
                <Style x:Key="GroupTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="4,18,0,8" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="SettingRow" TargetType="Grid">
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="ColumnSpacing" Value="24" />
                </Style>
                <Style x:Key="Divider" TargetType="Rectangle">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Style>
                <Style x:Key="Hint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </Grid.Resources>

            <Grid Margin="24,14,12,4" ColumnDefinitions="*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="OnCloseClick"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="20,0,20,24">

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Codale accounts" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="16,12,16,0"
                                Style="{StaticResource Hint}"
                                Text="Codale signs in to Claude and Codex on its own, separate from the claude and codex you run in a terminal. Use one for work and the other for personal. Chats already open keep their login until they restart." />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Claude" />
                                    <TextBlock x:Name="ClaudeAccountStatus" Style="{StaticResource Hint}" Text="Checking..." />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ClaudeSignInButton" Click="OnSignInClick" Tag="claude" Content="Sign in" />
                                <Button Grid.Column="2" x:Name="ClaudeSignOutButton" Click="OnSignOutClick" Tag="claude" Content="Sign out" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Codex" />
                                    <TextBlock x:Name="CodexAccountStatus" Style="{StaticResource Hint}" Text="Checking..." />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="CodexSignInButton" Click="OnSignInClick" Tag="codex" Content="Sign in" />
                                <Button Grid.Column="2" x:Name="CodexSignOutButton" Click="OnSignOutClick" Tag="codex" Content="Sign out" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Custom providers" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="Your own OpenAI-compatible endpoints, used by Claude through a local bridge. The base URL is the one an OpenAI SDK takes, usually ending in /v1. Pick one in the status bar; Default uses Codale's own Claude login, separate from the claude you run in a terminal. Also editable in settings.json." />
                            <StackPanel x:Name="ProvidersPanel" Spacing="6" />
                            <Button Click="OnAddProviderClick" Content="Add provider" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Appearance" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Theme" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Applies immediately, including transcript colours. The terminal stays dark." />
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" VerticalAlignment="Center" Width="160" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Follow system" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Editor" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Font size" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Points, 8–40. Applies to tabs opened after the change; Ctrl+wheel zooms one tab." />
                                </StackPanel>
                                <NumberBox x:Name="EditorFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="120" Maximum="40" Minimum="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnEditorFontSizeChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Tab width" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Spaces the Tab key inserts." />
                                </StackPanel>
                                <ComboBox x:Name="EditorTabWidthBox" Grid.Column="1" VerticalAlignment="Center" Width="130" SelectionChanged="OnEditorTabWidthChanged">
                                    <ComboBoxItem Content="2 spaces" />
                                    <ComboBoxItem Content="4 spaces" />
                                    <ComboBoxItem Content="8 spaces" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Word wrap" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Fold long lines at the viewport edge instead of scrolling sideways." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WordWrapToggle" Grid.Column="1" MinWidth="0" Toggled="OnWordWrapToggled" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Line numbers" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Draw the numbered gutter left of the text." />
                                </StackPanel>
                                <ToggleSwitch x:Name="EditorLineNumbersToggle" Grid.Column="1" MinWidth="0" Toggled="OnEditorLineNumbersToggled" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Syntax highlighting" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Colour keywords, strings and comments. Off can help on very large files." />
                                </StackPanel>
                                <ToggleSwitch x:Name="EditorHighlightingToggle" Grid.Column="1" MinWidth="0" Toggled="OnEditorHighlightingToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Syntax" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Get more languages" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Download grammars from the built-in catalog, have the AI write one for a file type, or import a .tmLanguage.json." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Download…" Click="OnSyntaxDownloadClick" />
                                    <Button Content="Generate…" Click="OnSyntaxGenerateClick" />
                                    <Button Content="Import…" Click="OnSyntaxImportClick" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource SettingRow}" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SyntaxSummary" Text="Installed languages" />
                                <StackPanel x:Name="SyntaxList" Grid.Row="1" Spacing="2" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Per-file language overrides" />
                                    <TextBlock x:Name="SyntaxOverridesHint" Style="{StaticResource Hint}" Text="Files you set by hand from the status bar." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SyntaxClearOverridesButton" Content="Clear all" Click="OnSyntaxClearOverridesClick" />
                                    <Button Content="Open folder" Click="OnSyntaxOpenFolderClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Terminal" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Default shell" />
                                    <TextBlock Style="{StaticResource Hint}" Text="What a new terminal tab runs. Open tabs keep their shell." />
                                </StackPanel>
                                <ComboBox x:Name="TerminalShellBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnTerminalShellChanged">
                                    <ComboBoxItem Content="Auto-detect" />
                                    <ComboBoxItem Content="PowerShell 7 (pwsh)" />
                                    <ComboBoxItem Content="Windows PowerShell" />
                                    <ComboBoxItem Content="Command Prompt" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Font family" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Must be monospace. Falls back to Cascadia Mono if not installed." />
                                </StackPanel>
                                <ComboBox x:Name="TerminalFontFamilyBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnTerminalFontFamilyChanged">
                                    <ComboBoxItem Content="Cascadia Mono" />
                                    <ComboBoxItem Content="Cascadia Code" />
                                    <ComboBoxItem Content="Consolas" />
                                    <ComboBoxItem Content="Courier New" />
                                    <ComboBoxItem Content="JetBrains Mono" />
                                    <ComboBoxItem Content="Fira Code" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Font size" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Points, 8–40. Open terminals refit immediately." />
                                </StackPanel>
                                <NumberBox x:Name="TerminalFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="120" Maximum="40" Minimum="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTerminalFontSizeChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Scrollback" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Scrolled-off lines kept. Applies to terminals opened after the change." />
                                </StackPanel>
                                <ComboBox x:Name="TerminalScrollbackBox" Grid.Column="1" VerticalAlignment="Center" Width="140" SelectionChanged="OnTerminalScrollbackChanged">
                                    <ComboBoxItem Content="1,000 lines" />
                                    <ComboBoxItem Content="10,000 lines" />
                                    <ComboBoxItem Content="50,000 lines" />
                                    <ComboBoxItem Content="100,000 lines" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Chat" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Font size" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Base text size of the transcript; headings and code scale with it." />
                                </StackPanel>
                                <NumberBox x:Name="ChatFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="120" LargeChange="1" Maximum="24" Minimum="9" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="OnChatFontSizeChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Font" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Transcript typeface. Code stays monospaced." />
                                </StackPanel>
                                <ComboBox x:Name="ChatFontFamilyBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnChatFontFamilyChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Suggest next prompt" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Claude predicts what you will type next; press Tab in an empty composer to use it. Costs a small extra request per turn. Applies to new sessions." />
                                </StackPanel>
                                <ToggleSwitch x:Name="SuggestNextPromptToggle" Grid.Column="1" MinWidth="0" Toggled="OnSuggestNextPromptToggled" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="History by feature" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Sorts each message into a feature of the project (Login, Downloads...) and keeps one history per feature; a new session starts from that feature's summary instead of replaying old messages. Questions that are not about the project are not saved. Costs one small request per message." />
                                </StackPanel>
                                <ToggleSwitch x:Name="SmartHistoryToggle" Grid.Column="1" MinWidth="0" Toggled="OnSmartHistoryToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Claude chat defaults" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Chat mode" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Auto picks a depth per message; Interactive asks before changes; Plan researches first; Full works without asking." />
                                </StackPanel>
                                <ComboBox x:Name="ClaudeModeBox" Grid.Column="1" VerticalAlignment="Center" Width="220">
                                    <ComboBoxItem Content="Auto" Tag="automatic" />
                                    <ComboBoxItem Content="Interactive" Tag="manual" />
                                    <ComboBoxItem Content="Plan" Tag="plan" />
                                    <ComboBoxItem Content="Full (no permission prompts)" Tag="auto" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Flash model" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs the Lite and Flash tiers. The list is read live from the Claude CLI." />
                                </StackPanel>
                                <ComboBox x:Name="ClaudeFlashBox" Grid.Column="1" VerticalAlignment="Center" Width="220" DropDownOpened="OnModelDropDownOpened"></ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Pro model" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs the Pro and Plus tiers. The list is read live from the Claude CLI." />
                                </StackPanel>
                                <ComboBox x:Name="ClaudeProBox" Grid.Column="1" VerticalAlignment="Center" Width="220" DropDownOpened="OnModelDropDownOpened"></ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Codex chat defaults" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Chat mode" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Auto picks a depth per message; Interactive asks before changes; Plan researches first; Full works without asking." />
                                </StackPanel>
                                <ComboBox x:Name="CodexModeBox" Grid.Column="1" VerticalAlignment="Center" Width="220">
                                    <ComboBoxItem Content="Auto" Tag="automatic" />
                                    <ComboBoxItem Content="Interactive" Tag="manual" />
                                    <ComboBoxItem Content="Plan" Tag="plan" />
                                    <ComboBoxItem Content="Full (no permission prompts)" Tag="auto" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Flash model" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs the Lite and Flash tiers. The list is read live from the Codex CLI." />
                                </StackPanel>
                                <ComboBox x:Name="CodexFlashBox" Grid.Column="1" VerticalAlignment="Center" Width="220" DropDownOpened="OnModelDropDownOpened"></ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Pro model" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs the Pro and Plus tiers. The list is read live from the Codex CLI." />
                                </StackPanel>
                                <ComboBox x:Name="CodexProBox" Grid.Column="1" VerticalAlignment="Center" Width="220" DropDownOpened="OnModelDropDownOpened"></ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Provider override" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Claude CLI provider" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Where new Claude chats connect: your Claude login or one of your providers. Open chats keep theirs." TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ClaudeProviderBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnCliProviderChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Codex CLI provider" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Where new Codex chats connect: your Codex login or a provider with an OpenAI-compatible base URL. Open chats keep theirs." TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="CodexProviderBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnCliProviderChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Background task provider" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Writes commit messages, names sessions, reads Auto-mode messages and powers search. Uses Claude, Codex, or calls one of your custom providers directly (no process to start, the fastest)." TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="HelperProviderBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnHelperProviderChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Git" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Refresh interval" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Seconds between working-tree checks, 1–600. Lower is snappier but spawns git more often." />
                                </StackPanel>
                                <NumberBox x:Name="GitPollBox" Grid.Column="1" VerticalAlignment="Center" Width="120" Maximum="600" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnGitPollChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="Keyboard shortcuts" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!--  Rows are built in code; the divider style is looked up from here.  -->
                            <StackPanel x:Name="ShortcutsPanel">
                                <StackPanel.Resources>
                                    <Style x:Key="ShortcutDivider" TargetType="Rectangle" BasedOn="{StaticResource Divider}" />
                                    <Style x:Key="ShortcutText" TargetType="TextBlock" BasedOn="{StaticResource Hint}" />
                                </StackPanel.Resources>
                            </StackPanel>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                <TextBlock x:Name="ShortcutHint" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                                <Button Grid.Column="1" Click="OnResetShortcutsClick" Content="Reset all" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
