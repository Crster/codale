<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Codale.App.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Slides in over the right edge of the main window: a sheet with its own
          navigation on the left and one category at a time on the right.  -->
    <Border
        Background="{ThemeResource ShellCentreBackgroundBrush}"
        BorderBrush="{ThemeResource ShellHairlineBrush}"
        BorderThickness="1,0,0,0">
        <Grid x:Name="SettingsRootGrid" ColumnDefinitions="216,*">
            <Grid.Resources>
                <Style x:Key="CategoryRadioButton" TargetType="RadioButton">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid>
                                    <Border
                                        x:Name="Pill"
                                        Background="Transparent"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <Border
                                        x:Name="Underline"
                                        Width="3"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1.5"
                                        Opacity="0" />
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Padding="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center" />
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Pill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Pill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="CheckStates">
                                            <VisualState x:Name="Unchecked" />
                                            <VisualState x:Name="Checked">
                                                <VisualState.Setters>
                                                    <Setter Target="Underline.Opacity" Value="1" />
                                                    <Setter Target="Pill.Background" Value="{ThemeResource ShellSelectedBrush}" />
                                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Indeterminate" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="SectionTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="40" />
                    <Setter Property="Margin" Value="4,14,0,-6" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                </Style>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource ShellInputBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource ShellHairlineBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="SettingRow" TargetType="Grid">
                    <Setter Property="Padding" Value="16,11" />
                    <Setter Property="ColumnSpacing" Value="24" />
                    <Setter Property="MinHeight" Value="56" />
                </Style>
                <Style x:Key="RowTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style x:Key="RowDesc" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="Divider" TargetType="Rectangle">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="16,0" />
                    <Setter Property="Fill" Value="{ThemeResource ShellHairlineBrush}" />
                </Style>
                <Style x:Key="Hint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </Grid.Resources>

            <!--  Navigation  -->
            <Grid
                Padding="12,18,12,12"
                Background="{ThemeResource ShellSidePanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellHairlineBrush}"
                BorderThickness="0,0,1,0"
                RowDefinitions="Auto,*,Auto">
                <StackPanel Margin="10,0,0,18" Orientation="Horizontal" Spacing="10">
                    <FontIcon VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE713;" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Settings" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="TabNavGeneral" Checked="OnCategoryTabChanged" IsChecked="True" Style="{StaticResource CategoryRadioButton}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE80F;" />
                            <TextBlock Text="General" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabNavAi" Checked="OnCategoryTabChanged" Style="{StaticResource CategoryRadioButton}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE99A;" />
                            <TextBlock Text="AI Providers" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabNavEditor" Checked="OnCategoryTabChanged" Style="{StaticResource CategoryRadioButton}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE943;" />
                            <TextBlock Text="Editor" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabNavTerminal" Checked="OnCategoryTabChanged" Style="{StaticResource CategoryRadioButton}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE756;" />
                            <TextBlock Text="Terminal" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabNavGitShortcuts" Checked="OnCategoryTabChanged" Style="{StaticResource CategoryRadioButton}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE765;" />
                            <TextBlock Text="Keyboard Shortcuts" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock
                    Grid.Row="2"
                    Margin="10,0,0,0"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Changes save as you make them." />
            </Grid>

            <!--  The open category: its title, then its settings  -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Grid Padding="32,22,14,6" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" Text="General" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" Text="Appearance, folders and the chat." />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="OnCloseClick"
                        Style="{StaticResource ShellIconButton}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

            <!--  Main Content Area  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="760" Padding="32,4,32,32" HorizontalAlignment="Left">

                    <!-- ========================================== -->
                    <!-- 1. GENERAL (Appearance & Chat UI)         -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="SectionGeneral" Spacing="16" Visibility="Visible">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Theme" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Select your color scheme. The terminal remains dark." />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="1" VerticalAlignment="Center" Width="170" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Follow system" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Folders" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Installation folder" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Where the Codale app files are installed." />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Content="Open" Click="OnOpenInstallFolderClick" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="User data folder" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Logs, settings, database and artifacts." />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Content="Open" Click="OnOpenDataFolderClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Chat experience" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Font family" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Transcript typeface. Code blocks preserve monospace font." />
                                    </StackPanel>
                                    <ComboBox x:Name="ChatFontFamilyBox" Grid.Column="1" VerticalAlignment="Center" Width="190" SelectionChanged="OnChatFontFamilyChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Font size" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Base transcript size in points (9–24). Headings scale proportionally." />
                                    </StackPanel>
                                    <NumberBox x:Name="ChatFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="130" LargeChange="1" Maximum="24" Minimum="9" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="OnChatFontSizeChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Suggest next prompt" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Predicts the next prompt to accept via Tab in an empty composer." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SuggestNextPromptToggle" Grid.Column="1" MinWidth="0" Toggled="OnSuggestNextPromptToggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Git repository" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Refresh interval" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Seconds between git status checks (1–600 seconds)." />
                                    </StackPanel>
                                    <NumberBox x:Name="GitPollBox" Grid.Column="1" VerticalAlignment="Center" Width="130" Maximum="600" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnGitPollChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 2. AI & PROVIDERS                         -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="SectionAi" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Claude CLI" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Padding="16,14" Spacing="10">
                                <TextBlock Style="{StaticResource RowDesc}" Text="Accounts are detected automatically. Add another account or an Anthropic compatible endpoint." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ClaudeAccountStatus" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="ProvidersPanel" Spacing="6" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnAddProviderClick" Tag="claude" Content="Add endpoint" />
                                    <Button Click="OnAddAccountClick" Tag="claude" Content="Add account" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Codex CLI" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Padding="16,14" Spacing="10">
                                <TextBlock Style="{StaticResource RowDesc}" Text="Accounts are detected automatically. Add another account or an OpenAI compatible endpoint." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="CodexAccountStatus" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="CodexProfilesPanel" Spacing="6" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnAddProviderClick" Tag="codex" Content="Add endpoint" />
                                    <Button Click="OnAddAccountClick" Tag="codex" Content="Add account" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="AI Features" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="SmartFeatureRows" Padding="16" Spacing="16" />
                                <Border x:Name="SmartExperienceStatusPanel" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12" Visibility="Collapsed">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock x:Name="SmartExperienceStatus" Style="{StaticResource RowDesc}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <Button Grid.Column="1" Content="Retry" Click="OnSmartExperienceRetry" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 3. EDITOR & SYNTAX                        -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="SectionEditor" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Editor typography &amp; layout" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Font size" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Font size in points (8–40). Ctrl+Wheel zooms the current tab." />
                                    </StackPanel>
                                    <NumberBox x:Name="EditorFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="130" Maximum="40" Minimum="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnEditorFontSizeChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Tab width" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Number of spaces inserted by the Tab key." />
                                    </StackPanel>
                                    <ComboBox x:Name="EditorTabWidthBox" Grid.Column="1" VerticalAlignment="Center" Width="140" SelectionChanged="OnEditorTabWidthChanged">
                                        <ComboBoxItem Content="2 spaces" />
                                        <ComboBoxItem Content="4 spaces" />
                                        <ComboBoxItem Content="8 spaces" />
                                    </ComboBox>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Word wrap" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Wrap long lines at the viewport boundary instead of horizontal scrolling." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WordWrapToggle" Grid.Column="1" MinWidth="0" Toggled="OnWordWrapToggled" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Line numbers" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Display line numbers in the gutter." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EditorLineNumbersToggle" Grid.Column="1" MinWidth="0" Toggled="OnEditorLineNumbersToggled" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Syntax highlighting" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Color tokens, keywords, and strings. Disabling may help on very large files." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EditorHighlightingToggle" Grid.Column="1" MinWidth="0" Toggled="OnEditorHighlightingToggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Language grammars" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Grammar management" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Download catalog grammars or import TextMate JSON." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Download…" Click="OnSyntaxDownloadClick" />
                                        <Button Content="Import…" Click="OnSyntaxImportClick" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource SettingRow}" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SyntaxSummary" Style="{StaticResource RowTitle}" Text="Installed languages" />
                                    <StackPanel x:Name="SyntaxList" Grid.Row="1" Spacing="2" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Per-file overrides" />
                                        <TextBlock x:Name="SyntaxOverridesHint" Style="{StaticResource RowDesc}" Text="Files customized from the status bar." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="SyntaxClearOverridesButton" Content="Clear all" Click="OnSyntaxClearOverridesClick" />
                                        <Button Content="Open folder" Click="OnSyntaxOpenFolderClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 4. TERMINAL                               -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="SectionTerminal" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Terminal environment" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Default shell" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Command interpreter launched for new terminal tabs." />
                                    </StackPanel>
                                    <ComboBox x:Name="TerminalShellBox" Grid.Column="1" VerticalAlignment="Center" Width="200" SelectionChanged="OnTerminalShellChanged">
                                        <ComboBoxItem Content="Auto-detect" />
                                        <ComboBoxItem Content="PowerShell 7 (pwsh)" />
                                        <ComboBoxItem Content="Windows PowerShell" />
                                        <ComboBoxItem Content="Command Prompt" />
                                    </ComboBox>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Font family" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Monospace font family used in terminal tabs." />
                                    </StackPanel>
                                    <ComboBox x:Name="TerminalFontFamilyBox" Grid.Column="1" VerticalAlignment="Center" Width="200" SelectionChanged="OnTerminalFontFamilyChanged">
                                        <ComboBoxItem Content="Cascadia Mono" />
                                        <ComboBoxItem Content="Cascadia Code" />
                                        <ComboBoxItem Content="Consolas" />
                                        <ComboBoxItem Content="Courier New" />
                                        <ComboBoxItem Content="JetBrains Mono" />
                                        <ComboBoxItem Content="Fira Code" />
                                    </ComboBox>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Font size" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Font size in points (8–40). Active terminals resize instantly." />
                                    </StackPanel>
                                    <NumberBox x:Name="TerminalFontSizeBox" Grid.Column="1" VerticalAlignment="Center" Width="130" Maximum="40" Minimum="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTerminalFontSizeChanged" />
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Scrollback buffer" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="Maximum lines retained in terminal history." />
                                    </StackPanel>
                                    <ComboBox x:Name="TerminalScrollbackBox" Grid.Column="1" VerticalAlignment="Center" Width="160" SelectionChanged="OnTerminalScrollbackChanged">
                                        <ComboBoxItem Content="1,000 lines" />
                                        <ComboBoxItem Content="10,000 lines" />
                                        <ComboBoxItem Content="50,000 lines" />
                                        <ComboBoxItem Content="100,000 lines" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 5. GIT & KEYBOARD SHORTCUTS               -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="SectionGitShortcuts" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Keyboard shortcuts" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="ShortcutsPanel">
                                    <StackPanel.Resources>
                                        <Style x:Key="ShortcutDivider" TargetType="Rectangle" BasedOn="{StaticResource Divider}" />
                                        <Style x:Key="ShortcutText" TargetType="TextBlock" BasedOn="{StaticResource RowDesc}" />
                                    </StackPanel.Resources>
                                </StackPanel>
                                <Rectangle Style="{StaticResource Divider}" />
                                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingRow}">
                                    <TextBlock x:Name="ShortcutHint" VerticalAlignment="Center" Style="{StaticResource RowDesc}" />
                                    <Button Grid.Column="1" Click="OnResetShortcutsClick" Content="Reset all" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
