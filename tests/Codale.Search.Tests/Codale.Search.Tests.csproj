<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The bundled ripgrep, as the app ships it, so the search tests do not depend on PATH. -->
  <ItemGroup>
    <None Include="..\..\tools\rg\rg.exe" Link="rg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The bundled embedding model, at the same relative path the app ships it. -->
  <ItemGroup>
    <None Include="..\..\tools\models\potion-base-8M\vocab.txt;..\..\tools\models\potion-base-8M\model.safetensors"
          Link="models\potion-base-8M\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireEmbeddingModel" BeforeTargets="BeforeBuild"
          Condition="!Exists('..\..\tools\models\potion-base-8M\vocab.txt') Or !Exists('..\..\tools\models\potion-base-8M\model.safetensors')">
    <Error Text="tools\models\potion-base-8M is missing. Run run.ps1 once (it downloads the pinned embedding model and checks its SHA-256)." />
  </Target>

  <Target Name="RequireRipgrep" BeforeTargets="BeforeBuild" Condition="!Exists('..\..\tools\rg\rg.exe')">
    <Error Text="tools\rg\rg.exe is missing. Run run.ps1 once (it caches ripgrep from PATH or downloads the pinned release), or copy rg.exe there." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Codale.Search\Codale.Search.csproj" />
    <ProjectReference Include="..\..\src\Codale.Storage\Codale.Storage.csproj" />
    <ProjectReference Include="..\..\src\Codale.Core\Codale.Core.csproj" />
  </ItemGroup>

</Project>
